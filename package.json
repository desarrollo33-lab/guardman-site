{
  "name": "guardman-site",
  "type": "module",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "validate": "node scripts/fetch-cms-data.mjs",
    "validate:data": "node scripts/fetch-cms-data.mjs",
    
    "seo:status": "node scripts/run-pipeline.mjs status",
    "seo:setup": "node scripts/run-pipeline.mjs setup",
    "seo:research": "node scripts/run-pipeline.mjs research",
    "seo:generate": "node scripts/run-pipeline.mjs generate",
    "seo:full": "node scripts/run-pipeline.mjs full",
    
    "worker:dev": "wrangler dev --config wrangler.toml",
    "worker:deploy": "wrangler deploy --config wrangler.toml",
    
    "d1:local": "wrangler d1 execute guardman-seo --local --file=worker/sql/schema.sql",
    "d1:remote": "wrangler d1 execute guardman-seo --remote --file=worker/sql/schema.sql",
    
    "export:all": "node scripts/export-all.mjs",
    "export:sectors": "node scripts/export-sectors.mjs",
    "sync:r2": "node scripts/sync-from-r2.mjs",
    "sync:all": "node scripts/sync-from-admin.mjs",
    "deploy": "node scripts/deploy.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^4.3.0",
    "@astrojs/sitemap": "^3.3.0",
    "@tailwindcss/vite": "^4.1.4",
    "@types/leaflet": "^1.9.21",
    "astro": "^5.0.0",
    "leaflet": "^1.9.4",
    "marked": "^17.0.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.4"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
