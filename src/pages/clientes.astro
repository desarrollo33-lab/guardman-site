---
import BaseLayout from '../layouts/BaseLayout.astro';
import { BrandDNA } from '../data/site';
---

<BaseLayout title="Clientes | GuardMan Chile" description="Empresas que confian en GuardMan Chile para su seguridad privada.">
  <!-- Hero -->
  <section class="bg-primary-600 text-white py-16 lg:py-20">
    <div class="container mx-auto px-4 text-center">
      <h1 class="text-4xl lg:text-5xl font-bold mb-4">Empresas que confian en nosotros</h1>
      <p class="text-xl text-white/90 max-w-2xl mx-auto">
        Mas de 200 clientes en la Region Metropolitana confian en GuardMan para proteger sus activos
      </p>
    </div>
  </section>

  <!-- Stats -->
  <section class="py-12 bg-neutral-50 border-b">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-8 text-center">
        <div>
          <div class="text-3xl font-bold text-primary-600">{BrandDNA.stats.guards}</div>
          <div class="text-neutral-600 text-sm">Guardias en terreno</div>
        </div>
        <div>
          <div class="text-3xl font-bold text-primary-600">{BrandDNA.stats.clients}</div>
          <div class="text-neutral-600 text-sm">Clientes activos</div>
        </div>
        <div>
          <div class="text-3xl font-bold text-primary-600">{BrandDNA.stats.locations}</div>
          <div class="text-neutral-600 text-sm">Comunas cobertura</div>
        </div>
        <div>
          <div class="text-3xl font-bold text-primary-600">{BrandDNA.stats.years}</div>
          <div class="text-neutral-600 text-sm">Años de experiencia</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Clients Grid -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-neutral-900 mb-4">Nuestros Clientes</h2>
        <p class="text-lg text-neutral-600 max-w-2xl mx-auto">
          Trabajamos con empresas de diversos sectores en toda la Region Metropolitana
        </p>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        {BrandDNA.clients.map((client, index) => (
          <div class="bg-neutral-50 rounded-xl p-6 hover:shadow-lg transition-all">
            <div class="w-12 h-12 bg-primary-100 rounded-lg flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-neutral-900 mb-1">{client.name}</h3>
            <p class="text-sm text-neutral-500 mb-3">{client.industry}</p>
            <div class="flex flex-wrap gap-2">
              {client.services.map(service => (
                <span class="text-xs bg-primary-50 text-primary-700 px-2 py-1 rounded-full">{service}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Industries -->
  <section class="py-16 lg:py-24 bg-neutral-50">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-neutral-900 mb-4">Sectores que atendemos</h2>
        <p class="text-lg text-neutral-600 max-w-2xl mx-auto">
          Brindamos servicios de seguridad adaptados a las necesidades de cada industria
        </p>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
        <div class="bg-white rounded-xl p-4 text-center hover:shadow-md transition-all">
          <div class="text-3xl mb-2">🏨</div>
          <div class="font-medium text-neutral-900">Hotelería</div>
        </div>
        <div class="bg-white rounded-xl p-4 text-center hover:shadow-md transition-all">
          <div class="text-3xl mb-2">🏢</div>
          <div class="font-medium text-neutral-900">Corporativo</div>
        </div>
        <div class="bg-white rounded-xl p-4 text-center hover:shadow-md transition-all">
          <div class="text-3xl mb-2">🏠</div>
          <div class="font-medium text-neutral-900">Residencial</div>
        </div>
        <div class="bg-white rounded-xl p-4 text-center hover:shadow-md transition-all">
          <div class="text-3xl mb-2">🏭</div>
          <div class="font-medium text-neutral-900">Industrial</div>
        </div>
        <div class="bg-white rounded-xl p-4 text-center hover:shadow-md transition-all">
          <div class="text-3xl mb-2">🚗</div>
          <div class="font-medium text-neutral-900">Automotriz</div>
        </div>
        <div class="bg-white rounded-xl p-4 text-center hover:shadow-md transition-all">
          <div class="text-3xl mb-2">🏛️</div>
          <div class="font-medium text-neutral-900">Diplomático</div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 bg-primary-600 text-white">
    <div class="container mx-auto px-4 text-center">
      <h2 class="text-3xl font-bold mb-4">Unete a nuestros clientes satisfechos</h2>
      <p class="text-lg text-white/90 mb-8 max-w-2xl mx-auto">
        Protege tu empresa o residencia con los mejores servicios de seguridad en Santiago
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/cotizacion" class="bg-white text-primary-600 px-8 py-4 rounded-lg font-semibold hover:bg-neutral-100 transition-colors">
          Solicitar cotizacion
        </a>
        <a href="/contacto" class="border-2 border-white text-white px-8 py-4 rounded-lg font-semibold hover:bg-white/10 transition-colors">
          Contactar
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
