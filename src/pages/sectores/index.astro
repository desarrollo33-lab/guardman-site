---
/**
 * Sectores Index - Lista todos los sectores desde CMS
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import { readFileSync, existsSync, readdirSync } from 'fs';

const CMS_DIR = 'src/data/cms';

// Load all sectors from local JSON files
const sectorFiles = readdirSync(CMS_DIR)
  .filter(f => f.startsWith('sector-') && f.endsWith('.json'))
  .map(f => f.replace('sector-', '').replace('.json', ''));

const sectors = sectorFiles.map(slug => {
  const filePath = `${CMS_DIR}/sector-${slug}.json`;
  if (existsSync(filePath)) {
    const data = JSON.parse(readFileSync(filePath, 'utf-8'));
    return {
      slug,
      name: data.sections?.hero?.heading || slug.charAt(0).toUpperCase() + slug.slice(1),
      description: data.sections?.hero?.subheading || '',
      sections: data.sections || {}
    };
  }
  return { slug, name: slug, description: '', sections: {} };
});
---

<BaseLayout 
  title="Sectores | GuardMan Chile" 
  description="Soluciones de seguridad adaptadas a cada sector: comercial, industrial, residencial, salud, educación y más."
>
  <!-- Hero -->
  <section class="bg-primary-600 text-white py-16 lg:py-20">
    <div class="container mx-auto px-4 text-center">
      <h1 class="text-4xl lg:text-5xl font-bold mb-4">Seguridad por Sector</h1>
      <p class="text-xl text-white/90 max-w-2xl mx-auto">
        Soluciones de seguridad adaptadas a las necesidades específicas de cada industria y sector en Santiago
      </p>
    </div>
  </section>

  <!-- Sectores Grid -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="container mx-auto px-4">
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {sectors.map(sector => {
          const hero = sector.sections?.hero || {};
          
          return (
            <a 
              href={`/sectores/${sector.slug}`} 
              class="group bg-neutral-50 rounded-xl overflow-hidden hover:shadow-xl transition-all hover:-translate-y-1"
            >
              <div class="aspect-video bg-gradient-to-br from-primary-100 to-primary-200 relative overflow-hidden">
                <div class="absolute inset-0 flex items-center justify-center">
                  <div class="text-center p-6">
                    <h2 class="text-xl font-bold text-primary-700 mb-2">{hero.heading || sector.name}</h2>
                  </div>
                </div>
                <div class="absolute inset-0 bg-gradient-to-t from-primary-800/70 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
              </div>
              <div class="p-6">
                <h2 class="text-lg font-bold text-neutral-900 mb-2 group-hover:text-primary-600 transition-colors">
                  {hero.heading || sector.name}
                </h2>
                <p class="text-neutral-600 text-sm line-clamp-3">
                  {hero.subheading || sector.description || ''}
                </p>
                <div class="mt-4 flex items-center text-primary-600 font-medium text-sm">
                  Conocer más
                  <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                  </svg>
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-12 bg-neutral-100">
    <div class="container mx-auto px-4 text-center">
      <h2 class="text-2xl font-bold text-neutral-900 mb-4">¿No encuentras tu sector?</h2>
      <p class="text-neutral-600 mb-6">
        Contáctanos y diseñamos una solución a medida para tu industria.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/cotizacion" class="inline-block bg-primary-600 text-white px-8 py-3 rounded-lg font-semibold hover:bg-primary-700 transition-colors">
          Solicitar Cotización
        </a>
        <a href="/contacto" class="inline-block border-2 border-primary-600 text-primary-600 px-8 py-3 rounded-lg font-semibold hover:bg-primary-600 hover:text-white transition-colors">
          Llamar ahora
        </a>
      </div>
    </div>
  </section>
</BaseLayout>