---
/**
 * Sectors Hub - Reads from hub-sectors.json + sectors.json
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getServicesList, getLocationsList, getSectorsList } from '../../data/cms';
import { getSectorTag } from '../../data/cms-config';
import { readFileSync, existsSync } from 'fs';

const sectorFiles = (() => {
  const dir = 'src/data/cms';
  return readdirSync(dir).filter(f => f.startsWith('sector-') && f.endsWith('.json')).map(f => f.replace('sector-', '').replace('.json', ''));
})();

const sectors = (() => {
  const list = getSectorsList();
  return list.map(s => {
    const filePath = `src/data/cms/sector-${s.slug}.json`;
    if (existsSync(filePath)) {
      const data = JSON.parse(readFileSync(filePath, 'utf-8'));
      return { ...s, sections: data.sections || {}, image: s.hero_image || '/images/s4-thumbnail.webp' };
    }
    return { ...s, sections: {}, image: s.hero_image || '/images/s4-thumbnail.webp' };
  });
})();

import { readdirSync } from 'fs';

const allServices = getServicesList();
const allLocations = getLocationsList();

// Hub content from CMS
const hubPath = 'src/data/cms/hub-sectors.json';
let hubData: any = { hero: {}, stats: [], top_sectors: [], cta: {} };
if (existsSync(hubPath)) {
  hubData = JSON.parse(readFileSync(hubPath, 'utf-8'));
}

const serviceSectorsPath = 'src/data/cms/service-sectors.json';
let serviceSectorsMap: Record<string, string[]> = {};
if (existsSync(serviceSectorsPath)) {
  serviceSectorsMap = JSON.parse(readFileSync(serviceSectorsPath, 'utf-8'));
}
const sectorServiceCounts: Record<string, number> = {};
for (const [_, sectorSlugs] of Object.entries(serviceSectorsMap)) {
  for (const s of sectorSlugs) { sectorServiceCounts[s] = (sectorServiceCounts[s] || 0) + 1; }
}

// Top sectors: from CMS or calculated
const topSectorSlugs = hubData.top_sectors?.length > 0 ? hubData.top_sectors : [...sectors].sort((a, b) => (sectorServiceCounts[b.slug] || 0) - (sectorServiceCounts[a.slug] || 0)).slice(0, 3).map(s => s.slug);
const topSectors = topSectorSlugs.map((slug: string) => sectors.find(s => s.slug === slug)).filter(Boolean);
---

<BaseLayout title={hubData.seo?.title || "Sectores | GuardMan Chile"} description={hubData.seo?.description || "Soluciones de seguridad adaptadas a cada sector: comercial, industrial, residencial, salud, educación y más."}>
  <!-- Hero -->
  <section class="relative bg-primary-600 text-white overflow-hidden">
    <div class="absolute inset-0">
      <img src={hubData.hero?.image || '/images/hero-home.webp'} alt="GuardMan Chile - Seguridad por Sector" class="w-full h-full object-cover opacity-30" width="1920" height="1080" loading="eager" />
      <div class="absolute inset-0 bg-gradient-to-r from-primary-800/95 to-primary-600/80"></div>
    </div>
    <div class="container mx-auto px-4 py-16 lg:py-20 relative z-10">
      <div class="max-w-3xl">
        <h1 class="text-4xl lg:text-5xl font-bold mb-4">{hubData.hero?.heading || 'Seguridad por Sector'}</h1>
        <p class="text-xl text-white/90 mb-6">{hubData.hero?.subheading || 'Soluciones de seguridad adaptadas a las necesidades específicas de cada industria y sector en Santiago.'}</p>
        {hubData.stats?.length > 0 && (
          <div class="flex flex-wrap gap-6 text-white/90">
            {hubData.stats.map((stat: any) => (
              <div><div class="text-2xl font-bold">{stat.value}</div><div class="text-sm text-white/70">{stat.label}</div></div>
            ))}
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- Grid -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="container mx-auto px-4">
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {sectors.map(sector => {
          const hero = sector.sections?.hero || {};
          return (
            <a href={`/sectores/${sector.slug}`} class="group bg-neutral-50 rounded-xl overflow-hidden hover:shadow-xl transition-all hover:-translate-y-1">
              <div class="aspect-video bg-gradient-to-br from-primary-100 to-primary-200 relative overflow-hidden">
                <img src={sector.image} alt={hero.heading || sector.name} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" width="800" height="450" loading="lazy" />
                <div class="absolute inset-0 bg-gradient-to-t from-primary-800/70 to-transparent"></div>
                <div class="absolute bottom-0 left-0 right-0 p-4">
                  <h2 class="text-lg font-bold text-white">{hero.heading || sector.name}</h2>
                </div>
              </div>
              <div class="p-6">
                <p class="text-neutral-600 text-sm line-clamp-3 mb-4">{hero.subheading || sector.description || `Protección especializada para ${sector.name.toLowerCase()}`}</p>
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-3 text-xs text-neutral-500">
                    <span class="flex items-center gap-1">
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                      {sectorServiceCounts[sector.slug] || allServices.length} servicios
                    </span>
                    <span class="flex items-center gap-1">
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/></svg>
                      {allLocations.length} comunas
                    </span>
                  </div>
                </div>
                <div class="flex items-center text-primary-600 font-medium text-sm mt-2">
                  Conocer más <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Top Sectors -->
  <section class="py-16 lg:py-24 bg-neutral-900 text-white">
    <div class="container mx-auto px-4">
      <h2 class="text-2xl lg:text-3xl font-bold text-center mb-12">Los sectores más demandados</h2>
      <div class="grid md:grid-cols-3 gap-8">
        {topSectors.map(sector => sector && (
          <a href={`/sectores/${sector.slug}`} class="text-center group">
            <div class="w-16 h-16 bg-primary-600 rounded-full flex items-center justify-center mx-auto mb-4 group-hover:bg-primary-700 transition-colors">
              <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
            </div>
            <h3 class="font-bold text-xl mb-2 group-hover:text-primary-300 transition-colors">{sector.name}</h3>
            <p class="text-white/70 text-sm">{sectorServiceCounts[sector.slug] || 0} servicios disponibles</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-12 bg-primary-600 text-white">
    <div class="container mx-auto px-4 text-center">
      <h2 class="text-2xl lg:text-3xl font-bold mb-4">{hubData.cta?.text || '¿No encuentras tu sector?'}</h2>
      <p class="text-lg text-white/90 mb-6 max-w-2xl mx-auto">{hubData.cta?.description || 'Contáctanos y diseñamos una solución a medida para tu industria.'}</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href={hubData.cta?.button_link || '/cotizacion'} class="inline-block bg-white text-primary-600 px-8 py-3 rounded-lg font-semibold hover:bg-neutral-100 transition-colors">{hubData.cta?.button_text || 'Solicitar Cotización'}</a>
        <a href="/contacto" class="inline-block border-2 border-white text-white px-8 py-3 rounded-lg font-semibold hover:bg-white/10 transition-colors">Llamar ahora</a>
      </div>
    </div>
  </section>
</BaseLayout>
