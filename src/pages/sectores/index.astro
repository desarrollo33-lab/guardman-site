---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteConfig } from '../../data/site';
---

<BaseLayout title="Sectores que Atendemos | GuardMan Chile" description="GuardMan Chile ofrece servicios de seguridad para empresas de todos los sectores: hoteleria, corporativo, residencial, industrial y mas.">
  <!-- Hero -->
  <section class="bg-primary-600 text-white py-16 lg:py-20">
    <div class="container mx-auto px-4 text-center">
      <h1 class="text-4xl lg:text-5xl font-bold mb-4">Sectores que Atendemos</h1>
      <p class="text-xl text-white/90 max-w-2xl mx-auto">
        Protegemos empresas de todos los sectores en la Region Metropolitana
      </p>
    </div>
  </section>

  <!-- Sectors Grid -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="container mx-auto px-4">
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Hoteleria -->
        <a href="/sectores/hoteleria" class="group bg-neutral-50 rounded-2xl overflow-hidden hover:shadow-xl transition-all hover:-translate-y-1">
          <div class="aspect-video bg-gradient-to-br from-primary-100 to-primary-200 flex items-center justify-center">
            <span class="text-6xl">🏨</span>
          </div>
          <div class="p-6">
            <h2 class="text-xl font-bold text-neutral-900 mb-2 group-hover:text-primary-600 transition-colors">Hotelería</h2>
            <p class="text-neutral-600 text-sm mb-4">Hoteles, resorts y alojamiento turistico</p>
            <div class="text-primary-600 font-medium text-sm flex items-center gap-1 group-hover:gap-2 transition-all">
              Ver soluciones
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </div>
          </div>
        </a>

        <!-- Corporativo -->
        <a href="/sectores/corporativo" class="group bg-neutral-50 rounded-2xl overflow-hidden hover:shadow-xl transition-all hover:-translate-y-1">
          <div class="aspect-video bg-gradient-to-br from-blue-100 to-blue-200 flex items-center justify-center">
            <span class="text-6xl">🏢</span>
          </div>
          <div class="p-6">
            <h2 class="text-xl font-bold text-neutral-900 mb-2 group-hover:text-primary-600 transition-colors">Corporativo</h2>
            <p class="text-neutral-600 text-sm mb-4">Oficinas, centros comerciales y empresas</p>
            <div class="text-primary-600 font-medium text-sm flex items-center gap-1 group-hover:gap-2 transition-all">
              Ver soluciones
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </div>
          </div>
        </a>

        <!-- Residencial -->
        <a href="/sectores/residencial" class="group bg-neutral-50 rounded-2xl overflow-hidden hover:shadow-xl transition-all hover:-translate-y-1">
          <div class="aspect-video bg-gradient-to-br from-green-100 to-green-200 flex items-center justify-center">
            <span class="text-6xl">🏠</span>
          </div>
          <div class="p-6">
            <h2 class="text-xl font-bold text-neutral-900 mb-2 group-hover:text-primary-600 transition-colors">Residencial</h2>
            <p class="text-neutral-600 text-sm mb-4">Condominios, casas y comunidades</p>
            <div class="text-primary-600 font-medium text-sm flex items-center gap-1 group-hover:gap-2 transition-all">
              Ver soluciones
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </div>
          </div>
        </a>

        <!-- Industrial -->
        <a href="/sectores/industrial" class="group bg-neutral-50 rounded-2xl overflow-hidden hover:shadow-xl transition-all hover:-translate-y-1">
          <div class="aspect-video bg-gradient-to-br from-orange-100 to-orange-200 flex items-center justify-center">
            <span class="text-6xl">🏭</span>
          </div>
          <div class="p-6">
            <h2 class="text-xl font-bold text-neutral-900 mb-2 group-hover:text-primary-600 transition-colors">Industrial</h2>
            <p class="text-neutral-600 text-sm mb-4">Fabricas, bodegas y centros logisticos</p>
            <div class="text-primary-600 font-medium text-sm flex items-center gap-1 group-hover:gap-2 transition-all">
              Ver soluciones
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </div>
          </div>
        </a>

        <!-- Automotriz -->
        <a href="/sectores/automotriz" class="group bg-neutral-50 rounded-2xl overflow-hidden hover:shadow-xl transition-all hover:-translate-y-1">
          <div class="aspect-video bg-gradient-to-br from-red-100 to-red-200 flex items-center justify-center">
            <span class="text-6xl">🚗</span>
          </div>
          <div class="p-6">
            <h2 class="text-xl font-bold text-neutral-900 mb-2 group-hover:text-primary-600 transition-colors">Automotriz</h2>
            <p class="text-neutral-600 text-sm mb-4">Concesionarias, talleres y garages</p>
            <div class="text-primary-600 font-medium text-sm flex items-center gap-1 group-hover:gap-2 transition-all">
              Ver soluciones
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </div>
          </div>
        </a>

        <!-- Diplomatico -->
        <a href="/sectores/diplomatico" class="group bg-neutral-50 rounded-2xl overflow-hidden hover:shadow-xl transition-all hover:-translate-y-1">
          <div class="aspect-video bg-gradient-to-br from-purple-100 to-purple-200 flex items-center justify-center">
            <span class="text-6xl">🏛️</span>
          </div>
          <div class="p-6">
            <h2 class="text-xl font-bold text-neutral-900 mb-2 group-hover:text-primary-600 transition-colors">Diplomático</h2>
            <p class="text-neutral-600 text-sm mb-4">Embajadas, consulados y representaciones</p>
            <div class="text-primary-600 font-medium text-sm flex items-center gap-1 group-hover:gap-2 transition-all">
              Ver soluciones
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </div>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 bg-primary-600 text-white">
    <div class="container mx-auto px-4 text-center">
      <h2 class="text-3xl font-bold mb-4">Protege tu sector con GuardMan</h2>
      <p class="text-lg text-white/90 mb-8 max-w-2xl mx-auto">
        Contactanos para una cotizacion personalizada para tu industria
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/cotizacion" class="bg-white text-primary-600 px-8 py-4 rounded-lg font-semibold hover:bg-neutral-100 transition-colors">
          Solicitar cotizacion
        </a>
        <a href="/contacto" class="border-2 border-white text-white px-8 py-4 rounded-lg font-semibold hover:bg-white/10 transition-colors">
          Hablar con un experto
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
