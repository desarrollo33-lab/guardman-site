---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { services } from '../../data/services';

const sectorServices = services.filter(s => 
  ['seguridad-industrial', 'guard-pod', 'cctv-videovigilancia', 'control-de-accesos', 'monitoreo-24-7'].includes(s.slug)
);
---

<BaseLayout title="Seguridad Industrial | GuardMan Chile" description="Seguridad para fabricas, bodegas y centros logisticos en Santiago. Vigilancia industrial y control perimetral.">
  <div class="bg-neutral-100 py-3">
    <div class="container mx-auto px-4">
      <nav class="flex text-sm text-neutral-600">
        <a href="/" class="hover:text-primary-600">Inicio</a>
        <span class="mx-2">/</span>
        <a href="/sectores" class="hover:text-primary-600">Sectores</a>
        <span class="mx-2">/</span>
        <span class="text-neutral-900">Industrial</span>
      </nav>
    </div>
  </div>

  <section class="bg-gradient-to-br from-orange-700 to-orange-800 text-white py-16 lg:py-20">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl">
        <span class="inline-block bg-white/20 text-white px-4 py-1 rounded-full text-sm mb-4">🏭 Industrial</span>
        <h1 class="text-4xl lg:text-5xl font-bold mb-4">Seguridad Industrial y Logística</h1>
        <p class="text-xl text-white/90 mb-8">
          Proteccion para fabricas, bodegas, centros de distribucion y obras en construccion.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="/cotizacion" class="bg-accent text-white px-6 py-3 rounded-lg font-semibold hover:bg-accent-hover transition-colors text-center">
            Cotizar servicio
          </a>
          <a href="tel:+56930000010" class="border-2 border-white text-white px-6 py-3 rounded-lg font-semibold hover:bg-white/10 transition-colors text-center">
            Llamar ahora
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-20 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto text-center mb-12">
        <h2 class="text-3xl font-bold text-neutral-900 mb-4">Protegemos tus activos industriales</h2>
        <p class="text-lg text-neutral-600">
          El sector industrial enfrenta riesgos como robos de mercaderia, sabotajes y accesos no autorizados a zonas peligrosas.
        </p>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="bg-neutral-50 rounded-xl p-6">
          <h3 class="font-semibold text-neutral-900 mb-2">Vigilancia Perimetral</h3>
          <p class="text-neutral-600 text-sm">Control de todo el perimetro de instalaciones industriales.</p>
        </div>
        <div class="bg-neutral-50 rounded-xl p-6">
          <h3 class="font-semibold text-neutral-900 mb-2">Guard Pod</h3>
          <p class="text-neutral-600 text-sm">Unidades moviles autonomas ideales para obras sin infraestructura.</p>
        </div>
        <div class="bg-neutral-50 rounded-xl p-6">
          <h3 class="font-semibold text-neutral-900 mb-2">Control de Vehiculos</h3>
          <p class="text-neutral-600 text-sm">Registro de entrada y salida de camiones y vehiculos de carga.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-20 bg-neutral-50">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-neutral-900 mb-4">Servicios para la industria</h2>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {sectorServices.map(service => (
          <a href={`/servicios/${service.slug}`} class="bg-white rounded-xl p-6 hover:shadow-lg transition-all group">
            <h3 class="font-semibold text-neutral-900 mb-2">{service.name}</h3>
            <p class="text-neutral-600 text-sm">{service.short_description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 bg-primary-600 text-white">
    <div class="container mx-auto px-4 text-center">
      <h2 class="text-3xl font-bold mb-4">Protege tu instalacion con GuardMan</h2>
      <p class="text-lg text-white/90 mb-8">Soluciones para cualquier tipo de industria.</p>
      <a href="/cotizacion" class="bg-white text-primary-600 px-8 py-4 rounded-lg font-semibold hover:bg-neutral-100 transition-colors">
        Solicitar cotizacion
      </a>
    </div>
  </section>
</BaseLayout>
