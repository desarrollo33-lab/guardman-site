---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { services } from '../../data/services';

const sectorServices = services.filter(s => 
  ['guardias-de-seguridad', 'cctv-videovigilancia', 'control-de-accesos', 'monitoreo-24-7'].includes(s.slug)
);
---

<BaseLayout title="Seguridad Automotriz | GuardMan Chile" description="Seguridad para concesionarias, talleres y centros automotrices en Santiago. Vigilancia y control de accesos.">
  <div class="bg-neutral-100 py-3">
    <div class="container mx-auto px-4">
      <nav class="flex text-sm text-neutral-600">
        <a href="/" class="hover:text-primary-600">Inicio</a>
        <span class="mx-2">/</span>
        <a href="/sectores" class="hover:text-primary-600">Sectores</a>
        <span class="mx-2">/</span>
        <span class="text-neutral-900">Automotriz</span>
      </nav>
    </div>
  </div>

  <section class="bg-gradient-to-br from-red-700 to-red-800 text-white py-16 lg:py-20">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl">
        <span class="inline-block bg-white/20 text-white px-4 py-1 rounded-full text-sm mb-4">🚗 Automotriz</span>
        <h1 class="text-4xl lg:text-5xl font-bold mb-4">Seguridad para el Sector Automotriz</h1>
        <p class="text-xl text-white/90 mb-8">
          Proteccion para concessionarias, talleres, centros de servicio y garages. Vehiculos de alto valor bajo vigilancia constante.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="/cotizacion" class="bg-accent text-white px-6 py-3 rounded-lg font-semibold hover:bg-accent-hover transition-colors text-center">
            Cotizar servicio
          </a>
          <a href="tel:+56930000010" class="border-2 border-white text-white px-6 py-3 rounded-lg font-semibold hover:bg-white/10 transition-colors text-center">
            Llamar ahora
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-20 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto text-center mb-12">
        <h2 class="text-3xl font-bold text-neutral-900 mb-4">Desafíos del sector automotriz</h2>
        <p class="text-lg text-neutral-600">
          Las concessionarias y talleres manejan vehiculos de alto valor y deben garantizar la seguridad de inventario y clientes.
        </p>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="bg-neutral-50 rounded-xl p-6">
          <h3 class="font-semibold text-neutral-900 mb-2">ProtecciÃ³n de Inventario</h3>
          <p class="text-neutral-600 text-sm">Vigilancia de vehiculos nuevos y usados en showroom y patio.</p>
        </div>
        <div class="bg-neutral-50 rounded-xl p-6">
          <h3 class="font-semibold text-neutral-900 mb-2">Control de Taller</h3>
          <p class="text-neutral-600 text-sm">Restriccion de acceso a areas de servicio y administracion.</p>
        </div>
        <div class="bg-neutral-50 rounded-xl p-6">
          <h3 class="font-semibold text-neutral-900 mb-2">CCTV</h3>
          <p class="text-neutral-600 text-sm">Camaras en todas las areas criticas con grabacion en la nube.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-20 bg-neutral-50">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-neutral-900 mb-4">Servicios para el sector automotriz</h2>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        {sectorServices.map(service => (
          <a href={`/servicios/${service.slug}`} class="bg-white rounded-xl p-6 hover:shadow-lg transition-all group">
            <h3 class="font-semibold text-neutral-900 mb-2">{service.name}</h3>
            <p class="text-neutral-600 text-sm">{service.short_description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 bg-primary-600 text-white">
    <div class="container mx-auto px-4 text-center">
      <h2 class="text-3xl font-bold mb-4">Protege tu concessionaria con GuardMan</h2>
      <p class="text-lg text-white/90 mb-8">Concessionarias como Kavak confian en nosotros.</p>
      <a href="/cotizacion" class="bg-white text-primary-600 px-8 py-4 rounded-lg font-semibold hover:bg-neutral-100 transition-colors">
        Solicitar cotizacion
      </a>
    </div>
  </section>
</BaseLayout>
