---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { services } from '../../data/services';

const sectorServices = services.filter(s => 
  ['escoltas-privados', 'guardias-de-seguridad', 'cctv-videovigilancia', 'control-de-accesos', 'monitoreo-24-7'].includes(s.slug)
);
---

<BaseLayout title="Seguridad Diplomática | GuardMan Chile" description="Seguridad para embajadas, consulados y representaciones diplomaticas en Santiago. Escoltas y vigilancia especializada.">
  <div class="bg-neutral-100 py-3">
    <div class="container mx-auto px-4">
      <nav class="flex text-sm text-neutral-600">
        <a href="/" class="hover:text-primary-600">Inicio</a>
        <span class="mx-2">/</span>
        <a href="/sectores" class="hover:text-primary-600">Sectores</a>
        <span class="mx-2">/</span>
        <span class="text-neutral-900">Diplomático</span>
      </nav>
    </div>
  </div>

  <section class="bg-gradient-to-br from-purple-700 to-purple-800 text-white py-16 lg:py-20">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl">
        <span class="inline-block bg-white/20 text-white px-4 py-1 rounded-full text-sm mb-4">🏛️ Diplomático</span>
        <h1 class="text-4xl lg:text-5xl font-bold mb-4">Seguridad para Embajadas y Consulados</h1>
        <p class="text-xl text-white/90 mb-8">
          Proteccion especializada para representaciones diplomaticas, embajadores y personal consular.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="/cotizacion" class="bg-accent text-white px-6 py-3 rounded-lg font-semibold hover:bg-accent-hover transition-colors text-center">
            Cotizar servicio
          </a>
          <a href="tel:+56930000010" class="border-2 border-white text-white px-6 py-3 rounded-lg font-semibold hover:bg-white/10 transition-colors text-center">
            Llamar ahora
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-20 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto text-center mb-12">
        <h2 class="text-3xl font-bold text-neutral-900 mb-4">Estándares internacionales de seguridad</h2>
        <p class="text-lg text-neutral-600">
          Las representaciones diplomaticas requieren protocolos de seguridad estrictos y personal altamente capacitado.
        </p>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="bg-neutral-50 rounded-xl p-6">
          <h3 class="font-semibold text-neutral-900 mb-2">Escoltas Certificados</h3>
          <p class="text-neutral-600 text-sm">Personal con experiencia en proteccion de personalidades y diplomáticos.</p>
        </div>
        <div class="bg-neutral-50 rounded-xl p-6">
          <h3 class="font-semibold text-neutral-900 mb-2">Control de Acceso Especial</h3>
          <p class="text-neutral-600 text-sm">Sistemas de verificacion para personal y visitantes autorizados.</p>
        </div>
        <div class="bg-neutral-50 rounded-xl p-6">
          <h3 class="font-semibold text-neutral-900 mb-2">Monitoreo 24/7</h3>
          <p class="text-neutral-600 text-sm">Supervision continua desde nuestro centro de control.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-20 bg-neutral-50">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-neutral-900 mb-4">Servicios para el sector diplomático</h2>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {sectorServices.map(service => (
          <a href={`/servicios/${service.slug}`} class="bg-white rounded-xl p-6 hover:shadow-lg transition-all group">
            <h3 class="font-semibold text-neutral-900 mb-2">{service.name}</h3>
            <p class="text-neutral-600 text-sm">{service.short_description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 bg-primary-600 text-white">
    <div class="container mx-auto px-4 text-center">
      <h2 class="text-3xl font-bold mb-4">Proteccion diplomática con GuardMan</h2>
      <p class="text-lg text-white/90 mb-8">Varias embajadas en Santiago confian en nuestros servicios.</p>
      <a href="/cotizacion" class="bg-white text-primary-600 px-8 py-4 rounded-lg font-semibold hover:bg-neutral-100 transition-colors">
        Solicitar cotizacion
      </a>
    </div>
  </section>
</BaseLayout>
