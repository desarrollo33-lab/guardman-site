---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { services } from '../../data/services';
import { siteConfig } from '../../data/site';

const sectorServices = services.filter(s => 
  ['guardias-de-seguridad', 'monitoreo-24-7', 'cctv-videovigilancia', 'control-de-accesos', 'seguridad-eventos'].includes(s.slug)
);
---

<BaseLayout title="Seguridad para Hoteles | GuardMan Chile" description="Servicios de seguridad especializados para hoteles y empresas de hotelería en Santiago. Guardias, CCTV y monitoreo 24/7.">
  <!-- Breadcrumb -->
  <div class="bg-neutral-100 py-3">
    <div class="container mx-auto px-4">
      <nav class="flex text-sm text-neutral-600">
        <a href="/" class="hover:text-primary-600">Inicio</a>
        <span class="mx-2">/</span>
        <a href="/sectores" class="hover:text-primary-600">Sectores</a>
        <span class="mx-2">/</span>
        <span class="text-neutral-900">Hotelería</span>
      </nav>
    </div>
  </div>

  <!-- Hero -->
  <section class="bg-gradient-to-br from-primary-700 to-primary-800 text-white py-16 lg:py-20">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl">
        <span class="inline-block bg-white/20 text-white px-4 py-1 rounded-full text-sm mb-4">🏨 Hotelería</span>
        <h1 class="text-4xl lg:text-5xl font-bold mb-4">Seguridad para Hoteles y Resorts</h1>
        <p class="text-xl text-white/90 mb-8">
          Proteccion integral para hoteles, resorts y establecimientos de alojamiento. Garantizamos la seguridad de tus huespedes y colaboradores.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="/cotizacion" class="bg-accent text-white px-6 py-3 rounded-lg font-semibold hover:bg-accent-hover transition-colors text-center">
            Cotizar servicio
          </a>
          <a href="tel:+56930000010" class="border-2 border-white text-white px-6 py-3 rounded-lg font-semibold hover:bg-white/10 transition-colors text-center">
            Llamar ahora
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Challenges -->
  <section class="py-16 lg:py-20 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto text-center mb-12">
        <h2 class="text-3xl font-bold text-neutral-900 mb-4">Desafíos de seguridad en hotelería</h2>
        <p class="text-lg text-neutral-600">
          Los hoteles enfrentan retos unicos: proteger a cientos de huespedes, controlar accesos, vigilar areas comunes y mantener la tranquilidad 24/7.
        </p>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="bg-neutral-50 rounded-xl p-6">
          <div class="w-12 h-12 bg-warning-light rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-warning" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
            </svg>
          </div>
          <h3 class="font-semibold text-neutral-900 mb-2">Control de Accesos</h3>
          <p class="text-neutral-600 text-sm">Gestion de entrada de huespedes, visitantes y personal en Areas como lobby, pisos y zonas restringidas.</p>
        </div>
        <div class="bg-neutral-50 rounded-xl p-6">
          <div class="w-12 h-12 bg-warning-light rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-warning" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
            </svg>
          </div>
          <h3 class="font-semibold text-neutral-900 mb-2">Vigilancia 24/7</h3>
          <p class="text-neutral-600 text-sm">Monitoreo continuo de areas comunes, estacionamiento, cocina y zonas de servicio.</p>
        </div>
        <div class="bg-neutral-50 rounded-xl p-6">
          <div class="w-12 h-12 bg-warning-light rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-warning" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
            </svg>
          </div>
          <h3 class="font-semibold text-neutral-900 mb-2">Guardias para Eventos</h3>
          <p class="text-neutral-600 text-sm">Personal adicional para eventos privados, bodas, conferencias y reuniones corporativas.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="py-16 lg:py-20 bg-neutral-50">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-neutral-900 mb-4">Servicios para hoteles</h2>
        <p class="text-lg text-neutral-600 max-w-2xl mx-auto">
          Soluciones adaptadas a las necesidades del sector hotelero
        </p>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {sectorServices.map(service => (
          <a href={`/servicios/${service.slug}`} class="bg-white rounded-xl p-6 hover:shadow-lg transition-all group">
            <div class="w-12 h-12 bg-primary-100 rounded-lg flex items-center justify-center mb-4 group-hover:bg-primary-600 transition-colors">
              <svg class="w-6 h-6 text-primary-600 group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
              </svg>
            </div>
            <h3 class="font-semibold text-neutral-900 mb-2">{service.name}</h3>
            <p class="text-neutral-600 text-sm">{service.short_description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 bg-primary-600 text-white">
    <div class="container mx-auto px-4 text-center">
      <h2 class="text-3xl font-bold mb-4">Protege tu hotel con GuardMan</h2>
      <p class="text-lg text-white/90 mb-8 max-w-2xl mx-auto">
        Mas de 10 hoteles en Santiago confian en nuestros servicios
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/cotizacion" class="bg-white text-primary-600 px-8 py-4 rounded-lg font-semibold hover:bg-neutral-100 transition-colors">
          Solicitar cotizacion
        </a>
        <a href="/contacto" class="border-2 border-white text-white px-8 py-4 rounded-lg font-semibold hover:bg-white/10 transition-colors">
          Hablar con un experto
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
