---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSectors, getServices, optimizeImageUrl } from '../../data/directus';
import { mdToHtml } from '../../lib/markdown';
import PageCTA from '../../components/design/PageCTA.astro';
import SidebarCTA from '../../components/design/SidebarCTA.astro';

export function getStaticPaths() {
  const sectors = getSectors();
  return sectors.map(sector => ({
    params: { slug: sector.slug },
    props: { sector },
  }));
}

const { sector } = Astro.props;
const allServices = getServices();
const siteUrl = 'https://guardman.cl';

// Breadcrumb
const breadcrumbItems = [
  { name: 'Inicio', url: `${siteUrl}/` },
  { name: 'Sectores', url: `${siteUrl}/sectores` },
  { name: sector.name, url: `${siteUrl}/sectores/${sector.slug}` }
];

// Map services to sectors
const sectorServiceMap: Record<string, string[]> = {
  hoteleria: ['guardias-de-seguridad', 'monitoreo-24-7', 'cctv-videovigilancia', 'control-de-accesos', 'seguridad-eventos'],
  corporativo: ['guardias-de-seguridad', 'cctv-videovigilancia', 'control-de-accesos', 'monitoreo-24-7', 'auditoria-seguridad'],
  residencial: ['guardias-de-seguridad', 'cctv-videovigilancia', 'control-de-accesos', 'monitoreo-24-7'],
  industrial: ['seguridad-industrial', 'guard-pod', 'cctv-videovigilancia', 'control-de-accesos', 'monitoreo-24-7'],
  automotriz: ['guardias-de-seguridad', 'cctv-videovigilancia', 'control-de-accesos', 'monitoreo-24-7'],
  diplomatico: ['escoltas-privados', 'guardias-de-seguridad', 'cctv-videovigilancia', 'control-de-accesos', 'monitoreo-24-7'],
};

const relatedServices = allServices.filter(s => 
  sectorServiceMap[sector.slug]?.includes(s.slug) || false
);
---

<BaseLayout 
  title={sector.meta_title} 
  description={sector.meta_description} 
  image={optimizeImageUrl(`/images/${sector.image}`)}
>
  <!-- Schema markup -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ItemPage",
    "name": sector.hero_title,
    "description": sector.description,
    "url": `${siteUrl}/sectores/${sector.slug}`,
    "publisher": { "@id": `${siteUrl}/#organization` },
    "mainEntity": {
      "@type": "Service",
      "name": `Seguridad para ${sector.name}`,
      "description": sector.description,
      "provider": { "@id": `${siteUrl}/#organization` }
    }
  })} />
  
  <!-- Breadcrumb Visual -->
  <div class="bg-neutral-100 py-3">
    <div class="container mx-auto px-4">
      <nav class="flex text-sm text-neutral-600" aria-label="Breadcrumb">
        <a href="/" class="hover:text-primary-600">Inicio</a>
        <span class="mx-2" aria-hidden="true">/</span>
        <a href="/sectores" class="hover:text-primary-600">Sectores</a>
        <span class="mx-2" aria-hidden="true">/</span>
        <span class="text-neutral-900 font-medium">{sector.name}</span>
      </nav>
    </div>
  </div>

  <!-- Hero -->
  <section class="relative bg-primary-600 text-white py-16 lg:py-20 overflow-hidden">
    <!-- Decorative elements -->
    <div class="absolute top-0 right-0 w-64 h-64 bg-primary-500/20 rounded-full blur-3xl translate-x-1/2 -translate-y-1/2" aria-hidden="true"></div>
    <div class="absolute bottom-0 left-0 w-96 h-96 bg-white/5 rounded-full blur-3xl -translate-x-1/2 translate-y-1/2" aria-hidden="true"></div>
    
    {sector.image && (
      <div class="absolute inset-0">
        <img 
          src={optimizeImageUrl(`/images/${sector.image}`)}
          alt={sector.name}
          class="w-full h-full object-cover opacity-30"
          width="1920"
          height="1080"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    )}
    
    <div class="absolute inset-0 bg-gradient-to-r from-primary-800/90 to-primary-600/70" aria-hidden="true"></div>
    
    <div class="container mx-auto px-4 relative z-10">
      <h1 class="text-3xl lg:text-5xl font-bold mb-4">{sector.hero_title}</h1>
      <p class="text-xl text-white/90 max-w-3xl">{sector.hero_subtitle}</p>
    </div>
  </section>

  <!-- Main Content -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="container mx-auto px-4">
      <div class="grid lg:grid-cols-3 gap-12">
        <!-- Column 1-2: Content -->
        <div class="lg:col-span-2">
          <!-- Description -->
          <div class="mb-12">
            <h2 class="text-2xl font-bold text-neutral-900 mb-6">Sobre seguridad en {sector.name.toLowerCase()}</h2>
            <div class="prose prose-neutral max-w-none text-lg text-neutral-600">
              <Fragment set:html={mdToHtml(sector.description)} />
            </div>
          </div>

          <!-- Related Services -->
          {relatedServices.length > 0 && (
            <div class="mb-8">
              <h2 class="text-2xl font-bold text-neutral-900 mb-6">Servicios para {sector.name.toLowerCase()}</h2>
              <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
                {relatedServices.map(service => (
                  <a 
                    href={`/servicios/${service.slug}`} 
                    class="group bg-neutral-50 rounded-xl overflow-hidden hover:shadow-xl hover:-translate-y-1 transition-all"
                  >
                    <div class="aspect-video bg-gradient-to-br from-primary-100 to-primary-200 relative overflow-hidden">
                      {service.image ? (
                        <img 
                          src={optimizeImageUrl(`/images/${service.image}`)}
                          alt={service.name}
                          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                          width="800"
                          height="450"
                          loading="lazy"
                        />
                      ) : (
                        <div class="w-full h-full flex items-center justify-center">
                          <svg class="w-12 h-12 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                          </svg>
                        </div>
                      )}
                      <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-primary-800/60 to-transparent p-4">
                        <h3 class="font-semibold text-white">{service.name}</h3>
                      </div>
                    </div>
                    <div class="p-4">
                      <p class="text-neutral-600 text-sm line-clamp-2">{service.short_description}</p>
                      <div class="mt-3 flex items-center text-primary-600 font-medium text-sm group-hover:gap-2 transition-all">
                        <span>Ver detalles</span>
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                        </svg>
                      </div>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          )}
        </div>

        <!-- Column 3: Sidebar -->
        <div class="lg:col-span-1">
          <SidebarCTA title={`Cotizar para ${sector.name}`} />
          
          <!-- Other sectors -->
          <div class="mt-8 pt-8 border-t border-neutral-200">
            <h3 class="font-semibold text-neutral-900 mb-4 flex items-center gap-2">
              <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
              </svg>
              Otros sectores
            </h3>
            <div class="space-y-3">
              {allServices.filter(s => {
                const sectorSlugs = Object.keys(sectorServiceMap);
                return !sectorSlugs.includes(s.slug) || s.slug !== sector.slug;
              }).slice(0, 5).map(() => null)}
              <a href="/sectores" class="flex items-center justify-between bg-neutral-50 hover:bg-primary-50 rounded-lg p-3 transition-colors group">
                <span class="text-neutral-700 group-hover:text-primary-600 font-medium">
                  Ver todos los sectores
                </span>
                <svg class="w-4 h-4 text-neutral-400 group-hover:text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <PageCTA 
    title={`Protege tu ${sector.name.toLowerCase()} con GuardMan`}
    description="Contactanos para una evaluación personalizada de seguridad."
    primaryText="Solicitar Cotización"
    primaryHref="/cotizacion"
    secondaryText="Hablar con un experto"
    secondaryHref="/contacto"
    variant="primary"
    showPhone={true}
  />
</BaseLayout>