---
/**
 * Sector Page - MODIFICADO: Usa contenido del CMS (JSON con related_content)
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSectorSections, getServicesList } from '../../data/cms';
import SchemaBreadcrumb from '../../components/seo/SchemaBreadcrumb.astro';
import { optimizeImageUrl } from '../../data/directus';
import { readFileSync, existsSync } from 'fs';

const CMS_DIR = 'src/data/cms';
const NEW_CMS_DIR = 'src/data/cms-new';

const SECTOR_IMAGES: Record<string, string> = {
  'comercial': 's4-thumbnail.webp',
  'industrial': 'sector-industrial.webp',
  'residencial': 'sector-residencial.webp',
  'salud': 'nosotros_seccion.webp',
  'educacion': 'hero-home.webp',
  'eventos': 's4-thumbnail.webp',
  'construccion': 'sector-industrial.webp',
  'automotriz': 's4-thumbnail.webp',
  'hoteleria': 'hero-home.webp'
};

export async function getStaticPaths() {
  const { getSectorsList } = await import('../../data/cms');
  const sectors = getSectorsList();

  return sectors.map((s: any) => ({
    params: { slug: s.slug },
    props: { sectorSlug: s.slug }
  }));
}

const { slug } = Astro.params;

// Load new CMS JSON format (with related_content)
const newSectorPath = `${NEW_CMS_DIR}/sectors/${slug}.json`;
const legacySectorPath = `${CMS_DIR}/sector-${slug}.json`;
let cmsSectorData: any = null;
let sectionData = { sections: {}, services: [], related_content: {} };

if (existsSync(newSectorPath)) {
  cmsSectorData = JSON.parse(readFileSync(newSectorPath, 'utf-8'));
  sectionData = { sections: cmsSectorData.content || cmsSectorData.sections || {}, services: [], related_content: cmsSectorData.related_content || {} };
} else if (existsSync(legacySectorPath)) {
  sectionData = JSON.parse(readFileSync(legacySectorPath, 'utf-8'));
  sectionData.related_content = {};
}

const sections = sectionData.sections || {};
const relatedContentFromCMS = sectionData.related_content || {};
const relatedServices = relatedContentFromCMS.related_services || sectionData.services || [];
const sectorServices = getServicesList();

const hero = sections?.hero || {
  heading: slug.charAt(0).toUpperCase() + slug.slice(1),
  subheading: 'Contenido del sector'
};

const breadcrumbItems = [
  { name: 'Inicio', url: 'https://guardman.cl' },
  { name: 'Sectores', url: 'https://guardman.cl/sectores' },
  { name: hero.heading, url: `https://guardman.cl/sectores/${slug}` }
];
---

<BaseLayout 
  title={`${hero.heading} | GuardMan Chile`}
  description={hero.subheading}
>
  <SchemaBreadcrumb items={breadcrumbItems} />

  <!-- Breadcrumb Visual -->
  <div class="bg-neutral-100 py-3">
    <div class="container mx-auto px-4">
      <nav class="flex text-sm text-neutral-600">
        <a href="/" class="hover:text-primary-600">Inicio</a>
        <span class="mx-2">/</span>
        <a href="/sectores" class="hover:text-primary-600">Sectores</a>
        <span class="mx-2">/</span>
        <span class="text-neutral-900 font-medium">{hero.heading}</span>
      </nav>
    </div>
  </div>

  <!-- Hero with Background Image -->
  <section class="relative bg-primary-600 text-white py-16 lg:py-20 overflow-hidden">
    {SECTOR_IMAGES[slug] && (
      <div class="absolute inset-0 z-0">
        <img 
          src={optimizeImageUrl(`/images/${SECTOR_IMAGES[slug]}`)}
          alt={hero.heading}
          class="w-full h-full object-cover opacity-30"
          width="1920"
          height="1080"
          loading="eager"
        />
        <div class="absolute inset-0 bg-gradient-to-r from-primary-800/95 to-primary-600/80"></div>
      </div>
    )}
    
    <div class="absolute top-0 right-0 w-64 h-64 bg-primary-500/20 rounded-full blur-3xl translate-x-1/2 -translate-y-1/2" aria-hidden="true"></div>
    <div class="absolute bottom-0 left-0 w-96 h-96 bg-white/5 rounded-full blur-3xl -translate-x-1/2 translate-y-1/2" aria-hidden="true"></div>
    
    <div class="container mx-auto px-4 relative z-10">
      <h1 class="text-3xl lg:text-5xl font-bold mb-4">{hero.heading}</h1>
      {hero.subheading && (
        <p class="text-xl text-white/90 max-w-3xl">{hero.subheading}</p>
      )}
    </div>
  </section>

  <!-- Main Content -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="container mx-auto px-4">
      <div class="grid lg:grid-cols-3 gap-12">
        <!-- Column 1-2: Content -->
        <div class="lg:col-span-2">
          
          <!-- Intro -->
          {sections?.intro?.paragraphs && (
            <div class="mb-12 prose prose-neutral max-w-none">
              {sections.intro.paragraphs.map((p: string) => (
                <p>{p}</p>
              ))}
            </div>
          )}

          <!-- Features -->
          {sections?.features && (
            <div class="mb-12">
              <h2 class="text-2xl font-bold text-neutral-900 mb-6">
                {sections.features.heading || 'Qué incluye el servicio'}
              </h2>
              <div class="grid sm:grid-cols-2 gap-4">
                {(() => {
                  // Handle both {0: 'item', 1: 'item'} and {items: ['item', 'item']}
                  const items = sections.features.items 
                    ? sections.features.items 
                    : Object.entries(sections.features)
                        .filter(([key]) => !isNaN(Number(key)))
                        .map(([_, value]) => value);
                  return items.map((feature, idx) => (
                    <div class="flex items-start gap-3 bg-neutral-50 rounded-lg p-4">
                      <svg class="w-5 h-5 text-success mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                      </svg>
                      <span class="text-neutral-700">{feature}</span>
                    </div>
                  ));
                })()}
              </div>
            </div>
          )}

          <!-- Issues -->
          {sections?.issues && (
            <div class="mb-12">
              <h2 class="text-2xl font-bold text-neutral-900 mb-6">
                {sections.issues.heading || 'Problemas que solucionamos'}
              </h2>
              <div class="grid sm:grid-cols-2 gap-4">
                {Object.entries(sections.issues)
                  .filter(([key]) => !isNaN(Number(key)) || key === 'items')
                  .map(([key, value]) => {
                    // Handle both {0: 'item', 1: 'item'} and {items: ['item', 'item']}
                    if (key === 'items') return value;
                    return value;
                  })
                  .flat()
                  .filter(item => item && typeof item === 'string')
                  .map((issue, idx) => (
                    <div class="flex items-start gap-3 bg-amber-50 border border-amber-200 rounded-lg p-4">
                      <svg class="w-5 h-5 text-amber-500 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                      </svg>
                      <span class="text-neutral-700">{issue}</span>
                    </div>
                  ))
                }
              </div>
            </div>
          )}

          <!-- Stats -->
          {sections?.stats && (
            <div class="mb-12 bg-primary-700 text-white rounded-xl p-8">
              <h2 class="text-2xl font-bold text-center mb-8">
                {sections.stats.heading || 'Números que nos respaldan'}
              </h2>
              <div class="grid grid-cols-3 gap-8 text-center">
                {Object.entries(sections.stats)
                  .filter(([key]) => !isNaN(Number(key)) || key === 'items')
                  .map(([key, value]) => {
                    if (key === 'items') return value;
                    return null;
                  })
                  .flat()
                  .filter(item => item && typeof item === 'object')
                  .map((stat, idx) => (
                    <div>
                      <div class="text-4xl lg:text-5xl font-bold mb-2">{stat.value}</div>
                      <div class="text-white/80">{stat.label}</div>
                    </div>
                  ))
                }
              </div>
            </div>
          )}

          <!-- FAQs -->
          {sections?.faqs && (
            <div class="mb-8">
              <h2 class="text-2xl font-bold text-neutral-900 mb-6">
                {sections.faqs.heading || 'Preguntas Frecuentes'}
              </h2>
              <div class="space-y-4">
                {Object.entries(sections.faqs)
                  .filter(([key]) => !isNaN(Number(key)) || key === 'items')
                  .map(([key, value]) => {
                    if (key === 'items') return value;
                    return null;
                  })
                  .flat()
                  .filter(item => item && typeof item === 'object')
                  .map((faq, idx) => (
                    <details class="group bg-neutral-50 rounded-lg">
                      <summary class="flex items-center justify-between cursor-pointer p-4 font-medium text-neutral-900">
                        {faq.question}
                        <svg class="w-5 h-5 text-neutral-500 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                        </svg>
                      </summary>
                      <div class="px-4 pb-4 text-neutral-600">
                        {faq.answer}
                      </div>
                    </details>
                  ))
                }
              </div>
            </div>
          )}

          <!-- Related Services (from service-sector relations) -->
          {sectorServices.length > 0 && (
            <div class="mb-8">
              <h2 class="text-2xl font-bold text-neutral-900 mb-6">
                Servicios para este sector
              </h2>
              <div class="grid sm:grid-cols-2 gap-4">
                {sectorServices.map((service: any) => (
                  <a 
                    href={`/servicios/${service.slug}`}
                    class="bg-neutral-50 hover:bg-primary-50 border border-neutral-200 hover:border-primary-300 rounded-lg p-4 transition-all group"
                  >
                    <h3 class="font-semibold text-neutral-900 group-hover:text-primary-600 mb-2">
                      {service.name}
                    </h3>
                    <p class="text-sm text-neutral-600 line-clamp-2">
                      {service.short_description || ''}
                    </p>
                  </a>
                ))}
              </div>
            </div>
          )}
        </div>

        <!-- Column 3: Sidebar -->
        <div class="lg:col-span-1">
          <div class="bg-neutral-50 rounded-xl p-6 sticky top-8">
            <h3 class="text-xl font-bold text-neutral-900 mb-4">
              {sections?.cta?.heading || hero.heading}
            </h3>
            
            {sections?.cta?.description && (
              <p class="text-neutral-600 mb-6">
                {sections.cta.description}
              </p>
            )}
            
            <a 
              href="/cotizacion" 
              class="block w-full bg-primary-600 text-white text-center px-6 py-3 rounded-lg font-semibold hover:bg-primary-700 transition-colors"
            >
              {sections?.cta?.button || 'Solicitar Cotización'}
            </a>
            
            <a 
              href="/contacto" 
              class="block w-full border border-primary-600 text-primary-600 text-center px-6 py-3 rounded-lg font-semibold hover:bg-primary-50 transition-colors mt-3"
            >
              Llamar ahora
            </a>

            <div class="mt-6 pt-6 border-t border-neutral-200">
              <h4 class="text-sm font-semibold text-neutral-700 mb-3">Otros sectores</h4>
              {['comercial', 'industrial', 'residencial', 'salud', 'educacion', 'eventos', 'construccion']
                .filter(s => s !== slug)
                .map(s => (
                  <a 
                    href={`/sectores/${s}`}
                    class="block py-2 text-sm text-neutral-600 hover:text-primary-600 border-b border-neutral-100 last:border-0 capitalize"
                  >
                    {s}
                  </a>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Final -->
  {sections?.cta && (
    <section class="py-12 bg-primary-600 text-white">
      <div class="container mx-auto px-4 text-center">
        <h2 class="text-2xl lg:text-3xl font-bold mb-4">{sections.cta.heading}</h2>
        <p class="text-lg text-white/90 mb-6 max-w-2xl mx-auto">
          {sections.cta.description}
        </p>
        <a 
          href="/cotizacion" 
          class="inline-block bg-white text-primary-600 px-8 py-3 rounded-lg font-semibold hover:bg-neutral-100 transition-colors"
        >
          {sections.cta.button || 'Solicitar Cotización'}
        </a>
      </div>
    </section>
  )}
</BaseLayout>