---
/**
 * /blog/[slug].astro — Blog article detail page
 * 
 * TEMPLATE-STANDARDS compliance:
 * - Exactly ONE h1 ✓
 * - No saltar niveles h1→h3 ✓
 * - Meta title ≤ 60 chars ✓
 * - Meta description ≤ 160 chars ✓
 * - Schema: Article + Breadcrumb ✓
 * - Canonical URL ✓
 * - Internal links (min 3) ✓
 * - CTA claro ✓
 * - Images: alt, width, height, lazy ✓
 * - Buttons: primary + outline styles ✓
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import SchemaArticle from '../../components/seo/SchemaArticle.astro';
import SchemaBreadcrumb from '../../components/seo/SchemaBreadcrumb.astro';
import { getBlogPosts, getBlogPostBySlug, getRelatedPosts, getServices, getBlogCategories } from '../../data/directus';
import { mdToHtml, mdToPlainText } from '../../lib/markdown';

export function getStaticPaths() {
  const posts = getBlogPosts();
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const relatedPosts = getRelatedPosts(post.slug, 3);
const services = getServices();
const categories = getBlogCategories();
const siteUrl = 'https://guardman.cl';

// Category label map
const categoryLabels: Record<string, string> = {
  legislacion: 'Legislación',
  guias: 'Guías',
  consejos: 'Consejos',
  empresa: 'Empresa',
  tecnologia: 'Tecnología',
};

// Format date
const formattedDate = new Date(post.date).toLocaleDateString('es-CL', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<BaseLayout 
  title={post.meta_title} 
  description={post.meta_description}
  image={post.featured_image}
>
  <!-- Schema -->
  <SchemaArticle 
    title={post.title}
    description={post.meta_description}
    slug={post.slug}
    date={post.date}
    author={post.author}
    image={post.featured_image}
  />
  <SchemaBreadcrumb items={[
    { name: 'Inicio', url: `${siteUrl}/` },
    { name: 'Blog', url: `${siteUrl}/blog` },
    { name: post.title, url: `${siteUrl}/blog/${post.slug}` },
  ]} />

  <!-- Breadcrumb -->
  <div class="bg-neutral-100 py-3">
    <div class="container mx-auto px-4">
      <nav class="flex text-sm text-neutral-600">
        <a href="/" class="hover:text-primary-600">Inicio</a>
        <span class="mx-2">/</span>
        <a href="/blog" class="hover:text-primary-600">Blog</a>
        <span class="mx-2">/</span>
        <span class="text-neutral-900 line-clamp-1">{post.title}</span>
      </nav>
    </div>
  </div>

  <!-- Hero -->
  <section class="relative bg-primary-600 text-white py-12 lg:py-16 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-primary-800 to-primary-600"></div>
    <div class="container mx-auto px-4 relative z-10 max-w-4xl">
      <!-- Category + reading time -->
      <div class="flex items-center gap-3 mb-4">
        <span class="bg-white/20 text-white text-xs font-semibold px-3 py-1 rounded-full">
          {categoryLabels[post.category] || post.category}
        </span>
        <span class="text-white/70 text-sm">
          {post.reading_time} min de lectura
        </span>
      </div>
      
      <!-- H1 -->
      <h1 class="text-3xl lg:text-4xl xl:text-5xl font-bold mb-4 leading-tight">
        {post.title}
      </h1>
      
      <!-- Excerpt -->
      <p class="text-lg text-white/80 mb-6 max-w-3xl">
        {post.excerpt}
      </p>
      
      <!-- Meta -->
      <div class="flex items-center gap-4 text-sm text-white/60">
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
          </svg>
          <span>{post.author}</span>
        </div>
        <span>·</span>
        <time datetime={post.date}>
          {formattedDate}
        </time>
      </div>
    </div>
  </section>

  <!-- Article Content -->
  <section class="py-12 lg:py-16 bg-white">
    <div class="container mx-auto px-4">
      <div class="grid lg:grid-cols-3 gap-12">
        <!-- Main Content -->
        <article class="lg:col-span-2 max-w-none">
          <!-- Rendered Markdown (H1 stripped by mdToHtml) -->
          <div class="prose prose-neutral max-w-none
            prose-headings:text-neutral-900
            prose-headings:font-bold
            prose-h2:text-2xl prose-h2:mt-10 prose-h2:mb-4
            prose-h3:text-xl prose-h3:mt-8 prose-h3:mb-3
            prose-p:text-neutral-700 prose-p:leading-relaxed
            prose-a:text-primary-600 prose-a:no-underline hover:prose-a:underline
            prose-strong:text-neutral-900
            prose-li:text-neutral-700
            prose-ul:my-4
            prose-ol:my-4
            prose-blockquote:border-l-4 prose-blockquote:border-primary-600 prose-blockquote:bg-primary-50 prose-blockquote:py-2 prose-blockquote:px-4 prose-blockquote:rounded-r-lg
          ">
            <Fragment set:html={mdToHtml(post.content)} />
          </div>

          <!-- Tags -->
          {post.tags && post.tags.length > 0 && (
            <div class="mt-12 pt-8 border-t border-neutral-200">
              <div class="flex items-center gap-2 flex-wrap">
                <span class="text-sm font-medium text-neutral-500">Tags:</span>
                {post.tags.map(tag => (
                  <span class="bg-neutral-100 text-neutral-700 text-sm px-3 py-1 rounded-full">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          )}
        </article>

        <!-- Sidebar -->
        <aside class="lg:col-span-1">
          <!-- CTA Card -->
          <div class="bg-neutral-50 rounded-xl p-6 sticky top-24 mb-6">
            <h3 class="text-xl font-bold text-neutral-900 mb-3">¿Necesitas seguridad?</h3>
            <p class="text-neutral-600 text-sm mb-4">
              GuardMan ofrece soluciones personalizadas con guardias certificados OS-10.
            </p>
            <div class="space-y-3">
              <a href="/cotizacion" class="block w-full bg-primary-600 text-white text-center py-3 rounded-lg font-semibold hover:bg-primary-700 transition-colors">
                Solicitar cotización
              </a>
              <a href="tel:+56930000010" class="block w-full border-2 border-primary-600 text-primary-600 text-center py-3 rounded-lg font-semibold hover:bg-primary-50 transition-colors">
                Llamar ahora
              </a>
            </div>
          </div>

          <!-- Related Posts -->
          {relatedPosts.length > 0 && (
            <div class="bg-neutral-50 rounded-xl p-6">
              <h3 class="text-lg font-bold text-neutral-900 mb-4">Artículos relacionados</h3>
              <div class="space-y-4">
                {relatedPosts.map(related => (
                  <a href={`/blog/${related.slug}`} class="group block">
                    <h4 class="font-medium text-neutral-900 group-hover:text-primary-600 transition-colors text-sm line-clamp-2 mb-1">
                      {related.title}
                    </h4>
                    <span class="text-neutral-500 text-xs">
                      {related.reading_time} min · {categoryLabels[related.category] || related.category}
                    </span>
                  </a>
                ))}
              </div>
            </div>
          )}
        </aside>
      </div>
    </div>
  </section>

  <!-- More Articles -->
  <section class="py-16 bg-neutral-50">
    <div class="container mx-auto px-4">
      <h2 class="text-2xl font-bold text-neutral-900 mb-8 text-center">
        Más artículos del blog
      </h2>
      <div class="grid md:grid-cols-3 gap-6">
        {relatedPosts.map(related => (
          <a href={`/blog/${related.slug}`} class="group">
            <article class="bg-white rounded-xl shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all h-full flex flex-col">
              <div class="aspect-video bg-gradient-to-br from-primary-50 to-primary-100 rounded-t-xl flex items-center justify-center">
                <svg class="w-10 h-10 text-primary-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
                </svg>
              </div>
              <div class="p-6 flex flex-col flex-1">
                <div class="flex items-center gap-3 mb-3 text-sm text-neutral-500">
                  <time datetime={related.date}>
                    {new Date(related.date).toLocaleDateString('es-CL', { day: 'numeric', month: 'short', year: 'numeric' })}
                  </time>
                  <span>·</span>
                  <span>{related.reading_time} min</span>
                </div>
                <h3 class="text-lg font-semibold text-neutral-900 group-hover:text-primary-600 transition-colors mb-2 line-clamp-2">
                  {related.title}
                </h3>
                <p class="text-neutral-600 text-sm line-clamp-3 flex-1">
                  {related.excerpt}
                </p>
              </div>
            </article>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Services CTA -->
  <section class="py-16 bg-primary-600 text-white">
    <div class="container mx-auto px-4 text-center">
      <h2 class="text-3xl font-bold mb-4">Servicios profesionales de seguridad</h2>
      <p class="text-lg text-white/90 mb-8 max-w-2xl mx-auto">
        Más de 500 guardias certificados OS-10, centro de monitoreo propio y tecnología de vanguardia.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/cotizacion" class="bg-white text-primary-600 px-8 py-4 rounded-lg font-semibold hover:bg-neutral-100 transition-colors">
          Cotizar ahora
        </a>
        <a href="/servicios" class="border-2 border-white text-white px-8 py-4 rounded-lg font-semibold hover:bg-white/10 transition-colors">
          Ver servicios
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
