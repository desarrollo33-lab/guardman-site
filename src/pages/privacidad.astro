---
/**
 * Política de Privacidad — CMS-driven
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { readFileSync, existsSync } from 'fs';

const cmsPath = 'src/data/cms/pages-privacidad.json';
const cms = existsSync(cmsPath) ? JSON.parse(readFileSync(cmsPath, 'utf-8')) : {};

const hero = cms.hero || { heading: 'Política de Privacidad', subheading: '', last_updated: '2026-01-01' };
const sections: { title: string; content: string }[] = cms.sections || [];
---

<BaseLayout title={`${hero.heading} | GuardMan Chile`} description="Política de privacidad de GuardMan Chile - Cómo recopilamos, usamos y protegemos tus datos personales.">
  <section class="bg-primary-600 text-white py-16">
    <div class="container mx-auto px-4">
      <h1 class="text-4xl font-bold">{hero.heading}</h1>
      <p class="text-white/90 mt-2">{hero.subheading}</p>
      {hero.last_updated && <p class="text-white/70 text-sm mt-2">Última actualización: {hero.last_updated}</p>}
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="container mx-auto px-4 max-w-3xl">
      <div class="prose prose-lg max-w-none">
        {sections.map((section: any, index: number) => (
          <div>
            <h2>{index + 1}. {section.title}</h2>
            <p>{section.content}</p>
          </div>
        ))}
        {sections.length === 0 && (
          <p class="text-neutral-600">Contenido no disponible. Contacta a info@guardman.cl para más información.</p>
        )}
      </div>
    </div>
  </section>
</BaseLayout>
