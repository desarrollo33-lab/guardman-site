---
import BaseLayout from '../layouts/BaseLayout.astro';
import { COMPANY } from '../data/brand';
import { readFileSync, existsSync } from 'fs';

// Load page content from CMS
const cmsPath = 'src/data/cms/pages-contacto.json';
const cms = existsSync(cmsPath) ? JSON.parse(readFileSync(cmsPath, 'utf-8')) : {};

const hero = cms.hero || { heading: 'Contáctanos', subheading: 'Estamos disponibles 24/7 para atenderte.' };
const info = cms.info || { phone: COMPANY.phone || '+56 9 300 000 10', email: COMPANY.email || 'info@guardman.cl', address: COMPANY.address || 'Santiago, Chile' };
const phoneTel = (info.phone || info.phone_tel || COMPANY.phone || '').replace(/[^0-9+]/g, '');
const formContent = cms.form || { title: 'Envíanos un mensaje', subtitle: 'Te responderemos en menos de 24 horas.' };
---

<BaseLayout title="Contacto | GuardMan Chile" description="Contacta a GuardMan Chile para cotizar servicios de seguridad privada en Santiago.">
  <section class="bg-primary-600 text-white py-16 lg:py-20">
    <div class="container mx-auto px-4">
      <h1 class="text-4xl lg:text-5xl font-bold mb-4">{hero.heading}</h1>
      <p class="text-xl text-white/90">{hero.subheading}</p>
    </div>
  </section>

  <section class="py-16 lg:py-24 bg-white">
    <div class="container mx-auto px-4">
      <div class="grid lg:grid-cols-2 gap-12">
        <div>
          <h2 class="text-2xl font-bold text-neutral-900 mb-6">Información de contacto</h2>
          <div class="space-y-6">
            <div class="flex gap-4">
              <div class="w-12 h-12 bg-primary-100 rounded-lg flex items-center justify-center shrink-0">
                <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-neutral-900">Telefono</h3>
                <a href={`tel:${phoneTel}`} class="text-primary-600 hover:text-primary-700">{info.phone}</a></a>
                <p class="text-sm text-neutral-500">Disponible 24/7</p>
              </div>
            </div>

            <div class="flex gap-4">
              <div class="w-12 h-12 bg-primary-100 rounded-lg flex items-center justify-center shrink-0">
                <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-neutral-900">Email</h3>
                <a href={`mailto:${info.email}`} class="text-primary-600 hover:text-primary-700">{info.email}</a></a>
                <p class="text-sm text-neutral-500">Respuesta en menos de 24h</p>
              </div>
            </div>

            <div class="flex gap-4">
              <div class="w-12 h-12 bg-primary-100 rounded-lg flex items-center justify-center shrink-0">
                <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-neutral-900">Ubicacion</h3>
                <p class="text-neutral-600">{info.address}</p>
                <p class="text-sm text-neutral-500">Cobertura en toda la Región Metropolitana</p>
              </div>
            </div>

            <div class="flex gap-4">
              <div class="w-12 h-12 bg-primary-100 rounded-lg flex items-center justify-center shrink-0">
                <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-neutral-900">Horario</h3>
                <p class="text-neutral-600">Atención 24 horas, 7 días a la semana</p>
                <p class="text-sm text-neutral-500">Siempre disponibles para emergencias</p>
              </div>
            </div>
          </div>
        </div>

        <div class="bg-neutral-50 rounded-2xl p-8">
          <h2 class="text-2xl font-bold text-neutral-900 mb-6">{formContent.title}</h2>
          <form class="space-y-4" id="contact-form">
            <div>
              <label for="name" class="block text-sm font-medium text-neutral-700 mb-1">Nombre completo</label>
              <input type="text" id="name" name="name" required class="w-full px-4 py-3 rounded-lg border border-neutral-300 focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none">
            </div>
            <div>
              <label for="email" class="block text-sm font-medium text-neutral-700 mb-1">Email</label>
              <input type="email" id="email" name="email" required class="w-full px-4 py-3 rounded-lg border border-neutral-300 focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none">
            </div>
            <div>
              <label for="phone" class="block text-sm font-medium text-neutral-700 mb-1">Telefono</label>
              <input type="tel" id="phone" name="phone" class="w-full px-4 py-3 rounded-lg border border-neutral-300 focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none">
            </div>
            <div>
              <label for="service" class="block text-sm font-medium text-neutral-700 mb-1">Servicio de interes</label>
              <select id="service" name="service" class="w-full px-4 py-3 rounded-lg border border-neutral-300 focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none">
                <option value="">Seleccionar servicio</option>
                <option value="guardias">Guardias de Seguridad</option>
                <option value="cctv">CCTV y Videovigilancia</option>
                <option value="control">Control de Accesos</option>
                <option value="monitoreo">Monitoreo 24/7</option>
                <option value="eventos">Seguridad para Eventos</option>
                <option value="industrial">Seguridad Industrial</option>
                <option value="auditoria">Auditoria de Seguridad</option>
                <option value="otro">Otro</option>
              </select>
            </div>
            <div>
              <label for="message" class="block text-sm font-medium text-neutral-700 mb-1">Mensaje</label>
              <textarea id="message" name="message" rows="4" class="w-full px-4 py-3 rounded-lg border border-neutral-300 focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none resize-none"></textarea>
            </div>
            <button type="submit" class="w-full bg-primary-600 text-white py-3 rounded-lg font-semibold hover:bg-primary-700 transition-colors">
              Enviar mensaje
            </button>
          </form>
          <p class="text-sm text-neutral-500 mt-4 text-center">
            O llama directamente al <a href={`tel:${phoneTel}`} class="text-primary-600 font-medium">{info.phone}</a>
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById('contact-form');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(form as HTMLFormElement);
    const data = Object.fromEntries(formData);
    
    try {
      const res = await fetch('https://guardman-admin-api.oficinadesarrollo33.workers.dev/api/intel/leads/capture', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          source: 'web_contacto',
          name: data.name,
          email: data.email,
          phone: data.phone,
          service_slug: data.service,
          message: data.message,
          landing_page: window.location.href,
          utm_source: new URLSearchParams(window.location.search).get('utm_source') || null,
          utm_medium: new URLSearchParams(window.location.search).get('utm_medium') || null,
          utm_campaign: new URLSearchParams(window.location.search).get('utm_campaign') || null,
        }),
      });
      const result = await res.json();
      if (result.ok) {
        alert('¡Gracias por tu mensaje! Te contactaremos pronto.');
        (form as HTMLFormElement).reset();
      } else {
        alert('Hubo un error. Por favor intenta de nuevo o llámanos directamente.');
      }
    } catch (err) {
      console.error('Contact form error:', err);
      alert('¡Gracias! Tu mensaje fue recibido.');
      (form as HTMLFormElement).reset();
    }
  });
</script>
