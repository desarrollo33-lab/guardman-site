---
/**
 * Locations Index - Lista todas las ubicaciones desde CMS
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLocationSections, getLocationsList } from '../../data/cms';

const locations = getLocationsList();

// Group by zone
const zones = ['Oriente', 'Centro', 'Norte', 'Sur'];
const locationsByZone: Record<string, any[]> = {
  'Oriente': [],
  'Centro': [],
  'Norte': [],
  'Sur': []
};

for (const location of locations) {
  const zone = location.zone || 'Centro';
  if (locationsByZone[zone]) {
    locationsByZone[zone].push(location);
  } else {
    locationsByZone['Centro'].push(location);
  }
}
---

<BaseLayout 
  title="Ubicaciones | GuardMan Chile" 
  description="Cobertura de seguridad en toda la Región Metropolitana. Servicios disponibles en Santiago Centro, Las Condes, Vitacura, Huechuraba y más."
>
  <!-- Hero -->
  <section class="bg-primary-600 text-white py-16 lg:py-20">
    <div class="container mx-auto px-4 text-center">
      <h1 class="text-4xl lg:text-5xl font-bold mb-4">Cobertura en Toda la Región Metropolitana</h1>
      <p class="text-xl text-white/90 max-w-2xl mx-auto">
        Protegemos empresas y residencias en las principales comunas de Santiago con guardias certificados OS-10
      </p>
    </div>
  </section>

  <!-- Locations by Zone -->
  {zones.map(zone => locationsByZone[zone].length > 0 && (
    <section class="py-12 bg-white">
      <div class="container mx-auto px-4">
        <h2 class="text-2xl font-bold text-neutral-900 mb-6 flex items-center gap-2">
          <span class="bg-primary-100 text-primary-700 px-3 py-1 rounded-full text-sm font-medium">{zone}</span>
          {zone === 'Oriente' ? 'Zona Premium' : zone === 'Centro' ? 'Zona Centro' : zone === 'Norte' ? 'Zona Norte' : 'Zona Sur'}
        </h2>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {locationsByZone[zone].map(location => {
            const sections = getLocationSections(location.slug);
            const hero = sections?.hero || {};
            
            return (
              <a 
                href={`/ubicaciones/${location.slug}`} 
                class="bg-neutral-50 hover:bg-primary-50 border border-neutral-200 hover:border-primary-300 rounded-lg p-6 transition-all group"
              >
                <h3 class="font-semibold text-neutral-900 group-hover:text-primary-600 transition-colors mb-2">
                  {hero.heading?.replace('Seguridad Privada en ', '') || location.name}
                </h3>
                <p class="text-sm text-neutral-600 line-clamp-2">
                  {hero.subheading || location.name}
                </p>
                <div class="mt-4 flex items-center text-primary-600 text-sm font-medium">
                  Ver cobertura
                  <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                  </svg>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  ))}

  <!-- CTA -->
  <section class="py-12 bg-primary-600 text-white">
    <div class="container mx-auto px-4 text-center">
      <h2 class="text-2xl font-bold mb-4">¿No encuentras tu ubicación?</h2>
      <p class="text-white/90 mb-6 max-w-2xl mx-auto">
        Contactanos y verificamos cobertura en tu zona. Operamos en toda la Región Metropolitana.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/cotizacion" class="inline-block bg-white text-primary-600 px-8 py-3 rounded-lg font-semibold hover:bg-neutral-100 transition-colors">
          Solicitar Cotización
        </a>
        <a href="/contacto" class="inline-block border-2 border-white text-white px-8 py-3 rounded-lg font-semibold hover:bg-white/10 transition-colors">
          Llamar ahora
        </a>
      </div>
    </div>
  </section>
</BaseLayout>