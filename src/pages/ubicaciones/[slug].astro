---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLocations, getServices, optimizeImageUrl } from '../../data/directus';
import { mdToHtml, mdToPlainText } from '../../lib/markdown';
import SchemaLocalBusiness from '../../components/seo/SchemaLocalBusiness.astro';
import SchemaBreadcrumb from '../../components/seo/SchemaBreadcrumb.astro';
import SchemaFAQ from '../../components/seo/SchemaFAQ.astro';
import PageCTA from '../../components/design/PageCTA.astro';

// Design components
import FAQList from '../../components/design/FAQList.astro';
import SidebarCTA from '../../components/design/SidebarCTA.astro';
import ContentCard from '../../components/design/ContentCard.astro';

export function getStaticPaths() {
  const locations = getLocations();
  return locations.map(location => ({
    params: { slug: location.slug },
    props: { location },
  }));
}

const { location } = Astro.props;
const breadcrumbItems = [
  { name: 'Inicio', url: 'https://guardman.cl' },
  { name: 'Ubicaciones', url: 'https://guardman.cl/ubicaciones' },
  { name: location.name, url: `https://guardman.cl/ubicaciones/${location.slug}` }
];

const allLocations = getLocations();
const allServices = getServices();
const availableServices = allServices.slice(0, 6);
const nearbyLocations = allLocations
  .filter(l => l.id !== location.id && l.zone === location.zone)
  .slice(0, 3);

// Context by zone
const zoneContext: Record<string, { focus: string; commonNeeds: string }> = {
  'Oriente': { 
    focus: 'residencias de lujo, embajadas y oficinas corporativas', 
    commonNeeds: 'control de accesos residencial, escoltas VIP y monitoreo perimetral' 
  },
  'Centro': { 
    focus: 'comercios, oficinas públicas y hoteles', 
    commonNeeds: 'control de flujos de personas, seguridad para eventos y CCTV comercial' 
  },
  'Norte': { 
    focus: 'industrias, bodegas y centros logísticos', 
    commonNeeds: 'vigilancia perimetral, control vehicular y seguridad industrial' 
  },
  'Suroriente': { 
    focus: 'residenciales, condominos y barrios privados', 
    commonNeeds: 'vigilancia vecinal, control de accesos y rondas preventivas' 
  },
  'Poniente': { 
    focus: 'industrias, comércio y aeropuertos', 
    commonNeeds: 'seguridad para carga aérea, control perimetral y monitoreo industrial' 
  },
  'Sur': { 
    focus: 'residencial popular y comercio local', 
    commonNeeds: 'seguridad comunitaria, vigilancia vecinal y prevención' 
  },
  'Valparaiso': { 
    focus: 'agricultura, comercio regional y turismo', 
    commonNeeds: 'seguridad para packing, bodegas agrícolas y turismo' 
  },
};

const ctx = zoneContext[location.zone] || { 
  focus: 'residencial y comercial', 
  commonNeeds: 'seguridad general' 
};

// FAQs
const locationFAQs = (location.faqs && location.faqs.length > 0)
  ? location.faqs
  : [
      {
        question: `¿Cuánto cuesta el servicio de guardias de seguridad en ${location.name}?`,
        answer: `El precio varía según el tipo de servicio, número de guardias y horarios. En ${location.name} (zona ${location.zone}), nos enfocamos en ${ctx.focus}. Ofrecemos tarifas competitivas por nuestra cobertura en ${location.zone}. Solicita tu cotización gratuita y personalizada.`
      },
      {
        question: `¿Qué servicios de seguridad son más demandados en ${location.name}?`,
        answer: `En ${location.name} la necesidad más frecuente es ${ctx.commonNeeds}. Contamos con guardias certificados OS-10 disponibles 24/7 para atender las características específicas de ${location.zone}.`
      },
      {
        question: `¿Tienen guardias disponibles las 24 horas en ${location.name} y ${location.zone}?`,
        answer: `Sí, nuestro centro de operaciones opera 24/7. Tenemos guardias disponibles para atención permanente o temporal en ${location.name}, toda la zona de ${location.zone} y la Región Metropolitana.`
      },
      {
        question: `¿Cuáles son los barrios y sectores de ${location.name} que cubren?`,
        answer: `Cubrimos todos los sectores de ${location.name}, incluyendo: ${(location.neighborhoods || []).slice(0, 4).join(', ')}. También protegemos ubicaciones cerca de ${(location.landmarks || []).slice(0, 3).join(', ')}.`
      },
      {
        question: `¿Cómo contrato servicios de seguridad en ${location.name}?`,
        answer: `Puedes solicitar tu cotización gratis a través de nuestro formulario online, llamándonos al +56 2 2400 6000, o escribiéndonos a info@guardman.cl. Atendemos ${location.name}, ${location.zone} y toda la Región Metropolitana.`
      }
    ];
---

<BaseLayout 
  title={location.meta_title || `Seguridad Privada en ${location.name} | GuardMan Chile`} 
  description={location.meta_description || `Servicios de seguridad en ${location.name}. Guardias, CCTV, control de accesos y monitoreo 24/7.`}
>
  <!-- Schema Markup -->
  <SchemaLocalBusiness 
    name={location.name}
    description={location.description}
    slug={location.slug}
    address="Av. Américo Vespucio Norte 1980"
    locality={location.name}
    latitude={location.latitude}
    longitude={location.longitude}
    neighborhood={location.neighborhoods?.[0]}
  />
  <SchemaBreadcrumb items={breadcrumbItems} />
  <SchemaFAQ faqs={locationFAQs} />
  
  <!-- Breadcrumb Visual -->
  <div class="bg-neutral-100 py-3">
    <div class="container mx-auto px-4">
      <nav class="flex text-sm text-neutral-600" aria-label="Breadcrumb">
        <a href="/" class="hover:text-primary-600">Inicio</a>
        <span class="mx-2" aria-hidden="true">/</span>
        <a href="/ubicaciones" class="hover:text-primary-600">Ubicaciones</a>
        <span class="mx-2" aria-hidden="true">/</span>
        <span class="text-neutral-900 font-medium">{location.name}</span>
      </nav>
    </div>
  </div>

  <!-- Hero -->
  <section class="bg-primary-600 text-white py-16 lg:py-20 relative overflow-hidden">
    <div class="absolute top-0 right-0 w-64 h-64 bg-primary-500/20 rounded-full blur-3xl translate-x-1/2 -translate-y-1/2" aria-hidden="true"></div>
    <div class="absolute bottom-0 left-0 w-96 h-96 bg-white/5 rounded-full blur-3xl -translate-x-1/2 translate-y-1/2" aria-hidden="true"></div>
    
    <div class="container mx-auto px-4 relative z-10">
      <div class="flex items-center gap-2 text-white/80 text-sm mb-4">
        <span class="bg-white/20 px-3 py-1 rounded-full">{location.zone}</span>
      </div>
      <h1 class="text-3xl lg:text-5xl font-bold mb-4">Seguridad en {location.name}</h1>
      <p class="text-xl text-white/90 max-w-3xl">{mdToPlainText(location.description, 250)}</p>
    </div>
  </section>

  <!-- Stats Bar -->
  {(location.stats) && (
    <section class="py-8 bg-neutral-50 border-b border-neutral-200">
      <div class="container mx-auto px-4">
        <div class="grid grid-cols-3 gap-8 text-center">
          <div>
            <div class="text-3xl lg:text-4xl font-bold text-primary-600">{location.stats.empresas}</div>
            <div class="text-sm text-neutral-500 mt-1">Empresas protegidas</div>
          </div>
          <div>
            <div class="text-3xl lg:text-4xl font-bold text-primary-600">{location.stats.guardias}</div>
            <div class="text-sm text-neutral-500 mt-1">Guardias en la zona</div>
          </div>
          <div>
            <div class="text-3xl lg:text-4xl font-bold text-primary-600">{location.stats.experiencia}</div>
            <div class="text-sm text-neutral-500 mt-1">Experiencia local</div>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Main Content -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="container mx-auto px-4">
      <div class="grid lg:grid-cols-3 gap-12">
        <!-- Column 1-2: Content -->
        <div class="lg:col-span-2">
          
          <!-- Services Grid -->
          <div class="mb-12">
            <h2 class="text-2xl font-bold text-neutral-900 mb-6">Servicios disponibles en {location.name}</h2>
            <div class="grid sm:grid-cols-2 gap-4">
              {availableServices.map(service => (
                <a 
                  href={`/servicios/${service.slug}`} 
                  class="bg-neutral-50 rounded-xl p-5 hover:shadow-lg hover:-translate-y-1 transition-all group"
                >
                  <h3 class="font-semibold text-neutral-900 group-hover:text-primary-600 transition-colors">
                    {service.name}
                  </h3>
                  <p class="text-sm text-neutral-600 mt-1 line-clamp-2">
                    {service.short_description}
                  </p>
                </a>
              ))}
            </div>
          </div>

          <!-- Description -->
          <div class="mb-12">
            <h2 class="text-2xl font-bold text-neutral-900 mb-6">Sobre {location.name}</h2>
            <div class="prose prose-neutral max-w-none">
              <Fragment set:html={mdToHtml(location.description)} />
            </div>
          </div>

          <!-- Neighborhoods -->
          {(location.neighborhoods || []).length > 0 && (
            <div class="mb-12">
              <h2 class="text-2xl font-bold text-neutral-900 mb-6">Barrios y sectores de {location.name}</h2>
              <div class="flex flex-wrap gap-2">
                {location.neighborhoods.map(n => (
                  <span class="bg-primary-50 text-primary-700 px-4 py-2 rounded-full text-sm font-medium">
                    {n}
                  </span>
                ))}
              </div>
            </div>
          )}

          <!-- Landmarks -->
          {(location.landmarks || []).length > 0 && (
            <div class="mb-12">
              <h2 class="text-2xl font-bold text-neutral-900 mb-6">Lugares estratégicos que protegemos</h2>
              <div class="grid sm:grid-cols-2 gap-4">
                {location.landmarks.map(landmark => (
                  <div class="flex items-center gap-3 bg-neutral-50 rounded-lg p-4">
                    <svg class="w-5 h-5 text-primary-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                    </svg>
                    <span class="text-neutral-700">{landmark}</span>
                  </div>
                ))}
              </div>
            </div>
          )}

          <!-- FAQs -->
          <div class="mb-8">
            <FAQList 
              faqs={locationFAQs} 
              title={`Preguntas Frecuentes sobre seguridad en ${location.name}`}
            />
          </div>
        </div>

        <!-- Column 3: Sidebar -->
        <div class="lg:col-span-1">
          <SidebarCTA title="Cotizar en esta ubicación" location={location.name} />
          
          <!-- Nearby Locations -->
          {nearbyLocations.length > 0 && (
            <div class="mt-8 pt-8 border-t border-neutral-200">
              <h3 class="font-semibold text-neutral-900 mb-4 flex items-center gap-2">
                <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                </svg>
                También en {location.zone}
              </h3>
              <div class="space-y-3">
                {nearbyLocations.map(l => (
                  <a 
                    href={`/ubicaciones/${l.slug}`} 
                    class="flex items-center justify-between bg-neutral-50 hover:bg-primary-50 rounded-lg p-3 transition-colors group"
                  >
                    <span class="text-neutral-700 group-hover:text-primary-600 font-medium">
                      {l.name}
                    </span>
                    <svg class="w-4 h-4 text-neutral-400 group-hover:text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                    </svg>
                  </a>
                ))}
              </div>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <PageCTA 
    title={`Protege tu propiedad en ${location.name}`}
    description="Contactanos hoy para una cotización sin compromiso."
    primaryText="Solicitar Cotización"
    primaryHref="/cotizacion"
    secondaryText="Hablar con un experto"
    secondaryHref="/contacto"
    variant="primary"
    showPhone={true}
  />
</BaseLayout>