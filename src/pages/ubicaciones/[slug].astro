---
/**
 * Location Page - Usa contenido del CMS (secciones)
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getServiceSections, getLocationSections, getServicesList, getLocationsList } from '../../data/cms';
import SchemaLocalBusiness from '../../components/seo/SchemaLocalBusiness.astro';
import SchemaBreadcrumb from '../../components/seo/SchemaBreadcrumb.astro';
import { optimizeImageUrl } from '../../data/directus';

export async function getStaticPaths() {
  const locations = getLocationsList();
  return locations.map((location: any) => ({
    params: { slug: location.slug },
    props: { slug: location.slug, name: location.name, zone: location.zone }
  }));
}

const { slug, name, zone } = Astro.props as { slug: string; name: string; zone: string };
const locationName = name;

// Get CMS sections
const sections = getLocationSections(slug);
const locations = getLocationsList();
const services = getServicesList();

// Find current location
const location = locations.find((l: any) => l.slug === slug) || { 
  slug, 
  name: locationName,
  zone: zone || 'Centro'
};

// Get nearby locations in same zone
const nearbyLocations = locations
  .filter((l: any) => l.slug !== slug && l.zone === location.zone)
  .slice(0, 3);

// Get available services
const availableServices = services.slice(0, 6);

// Hero data
const hero = sections?.hero || { 
  heading: `Seguridad Privada en ${locationName}`,
  subheading: `Empresa líder con guardias OS-10 en ${locationName}. Cobertura 24/7.`
};

// Breadcrumb
const breadcrumbItems = [
  { name: 'Inicio', url: 'https://guardman.cl' },
  { name: 'Ubicaciones', url: 'https://guardman.cl/ubicaciones' },
  { name: locationName, url: `https://guardman.cl/ubicaciones/${slug}` }
];

// Zone context
const zoneContext: Record<string, { focus: string; commonNeeds: string }> = {
  'Oriente': { 
    focus: 'residencias de lujo, embajadas y oficinas corporativas', 
    commonNeeds: 'control de accesos residencial, escoltas VIP y monitoreo perimetral' 
  },
  'Centro': { 
    focus: 'comercios, oficinas públicas y hoteles', 
    commonNeeds: 'control de flujos de personas, seguridad para eventos y CCTV comercial' 
  },
  'Norte': { 
    focus: 'industrias, bodegas y centros logísticos', 
    commonNeeds: 'vigilancia perimetral, control vehicular y seguridad industrial' 
  },
};

const locationZone = location.zone || 'Centro';
const context = zoneContext[locationZone] || zoneContext['Centro'];
---

<BaseLayout 
  title={hero.heading}
  description={hero.subheading}
>
  <!-- Schema -->
  <SchemaLocalBusiness 
    name={`GuardMan Chile - ${locationName}`}
    address={locationName}
    areaServed="Región Metropolitana"
  />
  <SchemaBreadcrumb items={breadcrumbItems} />

  <!-- Breadcrumb Visual -->
  <div class="bg-neutral-100 py-3">
    <div class="container mx-auto px-4">
      <nav class="flex text-sm text-neutral-600" aria-label="Breadcrumb">
        <a href="/" class="hover:text-primary-600">Inicio</a>
        <span class="mx-2">/</span>
        <a href="/ubicaciones" class="hover:text-primary-600">Ubicaciones</a>
        <span class="mx-2">/</span>
        <span class="text-neutral-900 font-medium">{locationName}</span>
      </nav>
    </div>
  </div>

  <!-- Hero -->
  <section class="relative bg-primary-600 text-white py-16 lg:py-20 overflow-hidden">
    <div class="absolute top-0 right-0 w-64 h-64 bg-primary-500/20 rounded-full blur-3xl translate-x-1/2 -translate-y-1/2" aria-hidden="true"></div>
    <div class="absolute bottom-0 left-0 w-96 h-96 bg-white/5 rounded-full blur-3xl -translate-x-1/2 translate-y-1/2" aria-hidden="true"></div>
    
    <div class="container mx-auto px-4 relative z-10">
      <h1 class="text-3xl lg:text-5xl font-bold mb-4">{hero.heading}</h1>
      {hero.subheading && (
        <p class="text-xl text-white/90 max-w-3xl">{hero.subheading}</p>
      )}
    </div>
  </section>

  <!-- Main Content -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="container mx-auto px-4">
      <div class="grid lg:grid-cols-3 gap-12">
        <!-- Column 1-2: CMS Sections -->
        <div class="lg:col-span-2">
          
          <!-- Intro Section -->
          {sections?.intro?.paragraphs && (
            <div class="mb-12 prose prose-neutral max-w-none">
              {sections.intro.paragraphs.map((p: string) => (
                <p>{p}</p>
              ))}
            </div>
          )}

          <!-- Why this zone -->
          {sections?.issues && (
            <div class="mb-12">
              <h2 class="text-2xl font-bold text-neutral-900 mb-6">
                {sections.issues.heading || `Seguridad en ${locationName}`}
              </h2>
              <div class="bg-amber-50 border border-amber-200 rounded-xl p-6">
                <p class="text-neutral-700">
                  <strong>{locationName}</strong> se especializa en {context.focus}. 
                  {context.commonNeeds && (
                    <> Las necesidades más comunes incluyen: {context.commonNeeds}.</>
                  )}
                </p>
              </div>
              {Object.entries(sections.issues)
                .filter(([key]) => !isNaN(Number(key)))
                .map(([_, issue]) => (
                  <div class="flex items-start gap-3 mt-4">
                    <svg class="w-5 h-5 text-amber-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                    </svg>
                    <span class="text-neutral-700">{issue}</span>
                  </div>
                ))
              }
            </div>
          )}

          <!-- Coverage Section -->
          {sections?.coverage && (
            <div class="mb-12">
              <h2 class="text-2xl font-bold text-neutral-900 mb-6">
                {sections.coverage.heading || `Cobertura en ${locationName}`}
              </h2>
              <div class="grid sm:grid-cols-2 gap-4">
                {Object.entries(sections.coverage)
                  .filter(([key]) => !isNaN(Number(key)))
                  .map(([_, item]) => (
                    <div class="flex items-start gap-3 bg-success/10 rounded-lg p-4">
                      <svg class="w-5 h-5 text-success mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                      </svg>
                      <span class="text-neutral-700">{item}</span>
                    </div>
                  ))
                }
              </div>
            </div>
          )}

          <!-- Stats Section -->
          {sections?.stats && (
            <div class="mb-12 bg-primary-700 text-white rounded-xl p-8">
              <h2 class="text-2xl font-bold text-center mb-8">
                {sections.stats.heading || `Números en ${locationName}`}
              </h2>
              <div class="grid grid-cols-3 gap-8 text-center">
                {Object.entries(sections.stats)
                  .filter(([key]) => !isNaN(Number(key)))
                  .map(([_, stat]: [string, any]) => (
                    <div>
                      <div class="text-4xl lg:text-5xl font-bold mb-2">{stat.value}</div>
                      <div class="text-white/80">{stat.label}</div>
                    </div>
                  ))
                }
              </div>
            </div>
          )}

          <!-- Services in this location -->
          <div class="mb-12">
            <h2 class="text-2xl font-bold text-neutral-900 mb-6">
              Servicios disponibles en {locationName}
            </h2>
            <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
              {availableServices.map((service: any) => {
                const serviceSections = getServiceSections(service.slug);
                return (
                  <a 
                    href={`/servicios/${service.slug}/?location=${slug}`}
                    class="bg-neutral-50 hover:bg-primary-50 border border-neutral-200 hover:border-primary-300 rounded-lg p-4 transition-all group"
                  >
                    <h3 class="font-semibold text-neutral-900 group-hover:text-primary-600 mb-2">
                      {serviceSections?.hero?.heading || service.name}
                    </h3>
                    <p class="text-sm text-neutral-600 line-clamp-2">
                      {serviceSections?.hero?.subheading || service.short_description || ''}
                    </p>
                  </a>
                );
              })}
            </div>
            <div class="mt-4 text-center">
              <a href="/servicios" class="text-primary-600 hover:text-primary-700 font-medium text-sm inline-flex items-center gap-1">
                Ver todos los servicios
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              </a>
            </div>
          </div>

          <!-- FAQs Section -->
          {sections?.faqs && (
            <div class="mb-8">
              <h2 class="text-2xl font-bold text-neutral-900 mb-6">
                {sections.faqs.heading || 'Preguntas Frecuentes'}
              </h2>
              <div class="space-y-4">
                {Object.entries(sections.faqs)
                  .filter(([key]) => !isNaN(Number(key)))
                  .map(([_, faq]: [string, any]) => (
                    <details class="group bg-neutral-50 rounded-lg">
                      <summary class="flex items-center justify-between cursor-pointer p-4 font-medium text-neutral-900">
                        {faq.question}
                        <svg class="w-5 h-5 text-neutral-500 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                        </svg>
                      </summary>
                      <div class="px-4 pb-4 text-neutral-600">
                        {faq.answer}
                      </div>
                    </details>
                  ))
                }
              </div>
            </div>
          )}
        </div>

        <!-- Column 3: Sidebar -->
        <div class="lg:col-span-1">
          <div class="bg-neutral-50 rounded-xl p-6 sticky top-8">
            <h3 class="text-xl font-bold text-neutral-900 mb-4">
              {sections?.cta?.heading || `Cotiza en ${locationName}`}
            </h3>
            
            {sections?.cta?.description && (
              <p class="text-neutral-600 mb-6">
                {sections.cta.description}
              </p>
            )}
            
            <a 
              href="/cotizacion" 
              class="block w-full bg-primary-600 text-white text-center px-6 py-3 rounded-lg font-semibold hover:bg-primary-700 transition-colors"
            >
              {sections?.cta?.button || 'Solicitar Cotización'}
            </a>
            
            <a 
              href="/contacto" 
              class="block w-full border border-primary-600 text-primary-600 text-center px-6 py-3 rounded-lg font-semibold hover:bg-primary-50 transition-colors mt-3"
            >
              Llamar ahora
            </a>

            <!-- Nearby locations -->
            {nearbyLocations.length > 0 && (
              <div class="mt-6 pt-6 border-t border-neutral-200">
                <h4 class="text-sm font-semibold text-neutral-700 mb-3">Comunas cercanas</h4>
                {nearbyLocations.map((l: any) => (
                  <a 
                    href={`/ubicaciones/${l.slug}`}
                    class="block py-2 text-sm text-neutral-600 hover:text-primary-600 border-b border-neutral-100 last:border-0"
                  >
                    {l.name}
                  </a>
                ))}
              </div>
            )}

            <!-- Services in sidebar -->
            <div class="mt-6 pt-6 border-t border-neutral-200">
              <h4 class="text-sm font-semibold text-neutral-700 mb-3">Servicios en {locationName}</h4>
              {services.slice(0, 4).map((s: any) => {
                const serviceSections = getServiceSections(s.slug);
                return (
                  <a 
                    href={`/servicios/${s.slug}/?location=${slug}`}
                    class="block py-2 text-sm text-neutral-600 hover:text-primary-600 border-b border-neutral-100 last:border-0"
                  >
                    {serviceSections?.hero?.heading || s.name}
                  </a>
                );
              })}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Final -->
  {sections?.cta && (
    <section class="py-12 bg-primary-600 text-white">
      <div class="container mx-auto px-4 text-center">
        <h2 class="text-2xl lg:text-3xl font-bold mb-4">{sections.cta.heading}</h2>
        <p class="text-lg text-white/90 mb-6 max-w-2xl mx-auto">
          {sections.cta.description}
        </p>
        <a 
          href="/cotizacion" 
          class="inline-block bg-white text-primary-600 px-8 py-3 rounded-lg font-semibold hover:bg-neutral-100 transition-colors"
        >
          {sections.cta.button || 'Solicitar Cotización'}
        </a>
      </div>
    </section>
  )}
</BaseLayout>