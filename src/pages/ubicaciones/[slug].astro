---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLocations, getServices } from '../../data/directus';
import SchemaLocalBusiness from '../../components/seo/SchemaLocalBusiness.astro';
import SchemaFAQ from '../../components/seo/SchemaFAQ.astro';

export function getStaticPaths() {
  const locations = getLocations();
  return locations.map(location => ({
    params: { slug: location.slug },
    props: { location },
  }));
}

const { location } = Astro.props;
const allLocations = getLocations();
const allServices = getServices();
const availableServices = allServices.slice(0, 6);
const nearbyLocations = allLocations.filter(l => l.id !== location.id && l.zone === location.zone).slice(0, 3);

// FAQs locales específicas por ubicación y zona
const zoneContext: Record<string, { focus: string; commonNeeds: string }> = {
  'Oriente': { focus: 'residencias de lujo, embajadas y oficinas corporativas', commonNeeds: 'control de accesos residencial, escoltas VIP y monitoreo perimetral' },
  'Centro': { focus: 'comercios, oficinas públicas y hoteles', commonNeeds: 'control de flujos de personas, seguridad para eventos y CCTV comercial' },
  'Norte': { focus: 'industrias, bodegas y centros logísticos', commonNeeds: 'vigilancia perimetral, control vehicular y seguridad industrial' },
  'Suroriente': { focus: 'residenciales, condominos y barrios privados', commonNeeds: 'vigilancia vecinal, control de accesos y rondas preventivas' },
  'Poniente': { focus: 'industrias, comércio y aeropuertos', commonNeeds: 'seguridad para carga aérea, control perimetral y monitoreo industrial' },
  'Sur': { focus: 'residencial popular y comercio local', commonNeeds: 'seguridad comunitaria, vigilancia vecinal y prevención' },
  'Valparaiso': { focus: 'agricultura, comercio regional y turismo', commonNeeds: 'seguridad para packing, bodegas agrícolas y turismo' },
};

const ctx = zoneContext[location.zone] || { focus: 'residencial y comercial', commonNeeds: 'seguridad general' };

const locationFAQs = [
  {
    question: `¿Cuánto cuesta el servicio de guardias de seguridad en ${location.name}?`,
    answer: `El precio varía según el tipo de servicio, número de guardias y horarios. En ${location.name} (zona ${location.zone}), nos enfocamos en ${ctx.focus}. Ofrecemos tarifas competitivas por nuestra cobertura en ${location.zone}. Solicita tu cotización gratuita y personalizada.`
  },
  {
    question: `¿Qué servicios de seguridad son más demandados en ${location.name}?`,
    answer: `En ${location.name} la necesidad más frecuente es ${ctx.commonNeeds}. Contamos con guardias certificados OS-10 disponibles 24/7 para atender las características específicas de ${location.zone}.`
  },
  {
    question: `¿Tienen guardias disponibles las 24 horas en ${location.name} y ${location.zone}?`,
    answer: `Sí, nuestro centro de operaciones opera 24/7. Tenemos guardias disponibles para atención permanente o temporal en ${location.name}, toda la zona de ${location.zone} y la Región Metropolitana.`
  },
  {
    question: `¿Cuáles son los barrios y sectores de ${location.name} que cubren?`,
    answer: `Cubrimos todos los sectores de ${location.name}, incluyendo: ${(location.neighborhoods || []).slice(0, 4).join(', ')}. También protegemos ubicaciones cerca de ${(location.landmarks || []).slice(0, 3).join(', ')}.`
  },
  {
    question: `¿Cómo contrato servicios de seguridad en ${location.name}?`,
    answer: `Puedes solicitar tu cotización gratis a través de nuestro formulario online, llamándonos al +56 2 2400 6000, o escribiéndonos a info@guardman.cl. Atendemos ${location.name}, ${location.zone} y toda la Región Metropolitana.`
  }
];
---

<BaseLayout title={location.meta_title || `Seguridad Privada en ${location.name} | GuardMan Chile`} description={location.meta_description || `Servicios de seguridad en ${location.name}. Guardias, CCTV, control de accesos y monitoreo 24/7.`}>
  <!-- Schema Markup -->
  <SchemaLocalBusiness 
    name={location.name}
    description={location.description}
    slug={location.slug}
    address="Av. Americo Vespucio Norte 1980"
    locality={location.name}
    latitude={location.latitude}
    longitude={location.longitude}
    neighborhood={location.neighborhoods?.[0]}
  />
  <SchemaFAQ faqs={locationFAQs} />
  
  <!-- Breadcrumb -->
  <div class="bg-neutral-100 py-3">
    <div class="container mx-auto px-4">
      <nav class="flex text-sm text-neutral-600">
        <a href="/" class="hover:text-primary-600">Inicio</a>
        <span class="mx-2">/</span>
        <a href="/ubicaciones" class="hover:text-primary-600">Ubicaciones</a>
        <span class="mx-2">/</span>
        <span class="text-neutral-900">{location.name}</span>
      </nav>
    </div>
  </div>

  <!-- Hero -->
  <section class="bg-primary-600 text-white py-16 lg:py-20">
    <div class="container mx-auto px-4">
      <div class="flex items-center gap-2 text-white/80 text-sm mb-4">
        <span class="bg-white/20 px-3 py-1 rounded-full">{location.zone}</span>
      </div>
      <h1 class="text-3xl lg:text-5xl font-bold mb-4">Seguridad en {location.name}</h1>
      <p class="text-xl text-white/90 max-w-3xl">{location.description}</p>
    </div>
  </section>

  <!-- Stats Bar -->
  {(location.stats) && (
    <section class="py-8 bg-neutral-50 border-b border-neutral-200">
      <div class="container mx-auto px-4">
        <div class="grid grid-cols-3 gap-8 text-center">
          <div>
            <div class="text-3xl lg:text-4xl font-bold text-primary-600">{location.stats.empresas}</div>
            <div class="text-sm text-neutral-500 mt-1">Empresas protegidas</div>
          </div>
          <div>
            <div class="text-3xl lg:text-4xl font-bold text-primary-600">{location.stats.guardias}</div>
            <div class="text-sm text-neutral-500 mt-1">Guardias en la zona</div>
          </div>
          <div>
            <div class="text-3xl lg:text-4xl font-bold text-primary-600">{location.stats.experiencia}</div>
            <div class="text-sm text-neutral-500 mt-1">Experiencia local</div>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Main Content -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="container mx-auto px-4">
      <div class="grid lg:grid-cols-3 gap-12">
        <!-- Services in this location -->
        <div class="lg:col-span-2">
          <h2 class="text-2xl font-bold text-neutral-900 mb-6">Servicios disponibles en {location.name}</h2>
          <div class="grid sm:grid-cols-2 gap-4">
            {availableServices.map(service => (
              <a href={`/servicios/${service.slug}`} class="bg-neutral-50 rounded-xl p-5 hover:shadow-md transition-all group">
                <h3 class="font-semibold text-neutral-900 group-hover:text-primary-600 transition-colors">{service.name}</h3>
                <p class="text-sm text-neutral-600 mt-1 line-clamp-2">{service.short_description}</p>
              </a>
            ))}
          </div>

          <!-- Neighborhoods -->
          {(location.neighborhoods || []).length > 0 && (
            <div class="mt-12">
              <h2 class="text-2xl font-bold text-neutral-900 mb-6">Barrios y sectores de {location.name}</h2>
              <div class="flex flex-wrap gap-2">
                {location.neighborhoods.map(n => (
                  <span class="bg-primary-50 text-primary-700 px-4 py-2 rounded-full text-sm">{n}</span>
                ))}
              </div>
            </div>
          )}

          <!-- Landmarks -->
          {(location.landmarks || []).length > 0 && (
            <div class="mt-12">
              <h2 class="text-2xl font-bold text-neutral-900 mb-6">Lugares estratégicos que protegemos en {location.name}</h2>
              <div class="grid sm:grid-cols-2 gap-4">
                {location.landmarks.map(landmark => (
                  <div class="flex items-center gap-3 bg-neutral-50 rounded-lg p-4">
                    <svg class="w-5 h-5 text-primary-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                    </svg>
                    <span class="text-neutral-700">{landmark}</span>
                  </div>
                ))}
              </div>
            </div>
          )}

          <!-- FAQs -->
          <div class="mt-12">
            <h2 class="text-2xl font-bold text-neutral-900 mb-6">Preguntas Frecuentes sobre seguridad en {location.name}</h2>
            <div class="space-y-4">
              {locationFAQs.map((faq) => (
                <div class="bg-neutral-50 rounded-lg p-6">
                  <h3 class="font-semibold text-neutral-900 mb-2 flex items-start gap-2">
                    <svg class="w-5 h-5 text-primary-600 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    {faq.question}
                  </h3>
                  <p class="text-neutral-600 pl-7">{faq.answer}</p>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- Sidebar -->
        <div class="lg:col-span-1">
          <div class="bg-neutral-50 rounded-xl p-6 sticky top-24">
            <h3 class="text-xl font-bold text-neutral-900 mb-4">Cotizar en {location.name}</h3>
            <div class="space-y-4">
              <a href="/cotizacion" class="block w-full bg-primary-600 text-white text-center py-3 rounded-lg font-semibold hover:bg-primary-700 transition-colors">
                Solicitar cotizacion
              </a>
              <a href="tel:+56224006000" class="block w-full border-2 border-primary-600 text-primary-600 text-center py-3 rounded-lg font-semibold hover:bg-primary-50 transition-colors">
                Llamar ahora
              </a>
            </div>

            <!-- Nearby locations -->
            {nearbyLocations.length > 0 && (
              <div class="mt-8 pt-6 border-t border-neutral-200">
                <h4 class="font-semibold text-neutral-900 mb-3">Tambien en {location.zone}</h4>
                <div class="space-y-2">
                  {nearbyLocations.map(l => (
                    <a href={`/ubicaciones/${l.slug}`} class="block text-primary-600 hover:text-primary-700 text-sm">
                      {l.name}
                    </a>
                  ))}
                </div>
              </div>
            )}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 bg-primary-600 text-white">
    <div class="container mx-auto px-4 text-center">
      <h2 class="text-3xl font-bold mb-4">Protege tu propiedad en {location.name}</h2>
      <p class="text-lg text-white/90 mb-8">Contactanos hoy para una cotizacion sin compromiso.</p>
      <a href="/cotizacion" class="inline-flex items-center gap-2 bg-white text-primary-600 px-8 py-4 rounded-lg font-semibold hover:bg-neutral-100 transition-colors">
        Solicitar cotizacion
      </a>
    </div>
  </section>
</BaseLayout>
