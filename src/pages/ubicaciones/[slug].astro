---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { locations } from '../../data/locations';
import { services } from '../../data/services';

export function getStaticPaths() {
  return locations.map(location => ({
    params: { slug: location.slug },
    props: { location },
  }));
}

const { location } = Astro.props;
const availableServices = services.slice(0, 6);
const nearbyLocations = locations.filter(l => l.id !== location.id && l.zone === location.zone).slice(0, 3);
---

<BaseLayout title={location.meta_title || `Seguridad Privada en ${location.name} | GuardMan Chile`} description={location.meta_description || `Servicios de seguridad en ${location.name}. Guardias, CCTV, control de accesos y monitoreo 24/7.`}>
  <!-- Breadcrumb -->
  <div class="bg-neutral-100 py-3">
    <div class="container mx-auto px-4">
      <nav class="flex text-sm text-neutral-600">
        <a href="/" class="hover:text-primary-600">Inicio</a>
        <span class="mx-2">/</span>
        <a href="/ubicaciones" class="hover:text-primary-600">Ubicaciones</a>
        <span class="mx-2">/</span>
        <span class="text-neutral-900">{location.name}</span>
      </nav>
    </div>
  </div>

  <!-- Hero -->
  <section class="bg-primary-600 text-white py-16 lg:py-20">
    <div class="container mx-auto px-4">
      <div class="flex items-center gap-2 text-white/80 text-sm mb-4">
        <span class="bg-white/20 px-3 py-1 rounded-full">{location.zone}</span>
      </div>
      <h1 class="text-3xl lg:text-5xl font-bold mb-4">Seguridad en {location.name}</h1>
      <p class="text-xl text-white/90 max-w-3xl">{location.description}</p>
    </div>
  </section>

  <!-- Main Content -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="container mx-auto px-4">
      <div class="grid lg:grid-cols-3 gap-12">
        <!-- Services in this location -->
        <div class="lg:col-span-2">
          <h2 class="text-2xl font-bold text-neutral-900 mb-6">Servicios disponibles en {location.name}</h2>
          <div class="grid sm:grid-cols-2 gap-4">
            {availableServices.map(service => (
              <a href={`/servicios/${service.slug}`} class="bg-neutral-50 rounded-xl p-5 hover:shadow-md transition-all group">
                <h3 class="font-semibold text-neutral-900 group-hover:text-primary-600 transition-colors">{service.name}</h3>
                <p class="text-sm text-neutral-600 mt-1 line-clamp-2">{service.short_description}</p>
              </a>
            ))}
          </div>

          <!-- Neighborhoods -->
          {(location.neighborhoods || []).length > 0 && (
            <div class="mt-12">
              <h2 class="text-2xl font-bold text-neutral-900 mb-6">Barrios y sectores</h2>
              <div class="flex flex-wrap gap-2">
                {location.neighborhoods.map(n => (
                  <span class="bg-primary-50 text-primary-700 px-4 py-2 rounded-full text-sm">{n}</span>
                ))}
              </div>
            </div>
          )}
        </div>

        <!-- Sidebar -->
        <div class="lg:col-span-1">
          <div class="bg-neutral-50 rounded-xl p-6 sticky top-24">
            <h3 class="text-xl font-bold text-neutral-900 mb-4">Cotizar en {location.name}</h3>
            <div class="space-y-4">
              <a href="/cotizacion" class="block w-full bg-primary-600 text-white text-center py-3 rounded-lg font-semibold hover:bg-primary-700 transition-colors">
                Solicitar cotizacion
              </a>
              <a href="tel:+56224006000" class="block w-full border-2 border-primary-600 text-primary-600 text-center py-3 rounded-lg font-semibold hover:bg-primary-50 transition-colors">
                Llamar ahora
              </a>
            </div>

            <!-- Nearby locations -->
            {nearbyLocations.length > 0 && (
              <div class="mt-8 pt-6 border-t border-neutral-200">
                <h4 class="font-semibold text-neutral-900 mb-3">Tambien en {location.zone}</h4>
                <div class="space-y-2">
                  {nearbyLocations.map(l => (
                    <a href={`/ubicaciones/${l.slug}`} class="block text-primary-600 hover:text-primary-700 text-sm">
                      {l.name}
                    </a>
                  ))}
                </div>
              </div>
            )}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 bg-primary-600 text-white">
    <div class="container mx-auto px-4 text-center">
      <h2 class="text-3xl font-bold mb-4">Protege tu propiedad en {location.name}</h2>
      <p class="text-lg text-white/90 mb-8">Contactanos hoy para una cotizacion sin compromiso.</p>
      <a href="/cotizacion" class="inline-flex items-center gap-2 bg-white text-primary-600 px-8 py-4 rounded-lg font-semibold hover:bg-neutral-100 transition-colors">
        Solicitar cotizacion
      </a>
    </div>
  </section>
</BaseLayout>
