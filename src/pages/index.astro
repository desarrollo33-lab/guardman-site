---
import BaseLayout from '../layouts/BaseLayout.astro';
import { services } from '../data/services';
import { locations } from '../data/locations';
import { siteConfig } from '../data/site';
import { featuredClients } from '../data/clients';
---

<BaseLayout title="Seguridad Privada en Santiago, Chile" description="GuardMan Chile - Empresa lider en servicios de seguridad privada. Guardias, CCTV, control de accesos y monitoreo 24/7 en toda la Region Metropolitana.">
  <!-- Hero Section -->
  <section class="relative bg-primary-600 text-white overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-primary-700/90 to-primary-600/80"></div>
    <div class="container mx-auto px-4 py-20 lg:py-28 relative z-10">
      <div class="max-w-3xl">
        <h1 class="text-4xl lg:text-5xl xl:text-6xl font-bold leading-tight mb-6">
          Protegemos lo que mas te importa
        </h1>
        <p class="text-xl lg:text-2xl text-white/90 mb-8">
          Empresa lider en seguridad privada en Santiago. Guardias certificados, CCTV, control de accesos y monitoreo 24/7.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="/cotizacion" class="bg-white text-primary-600 px-8 py-4 rounded-lg font-semibold text-center hover:bg-neutral-100 transition-colors">
            Solicita tu cotizacion gratis
          </a>
          <a href="tel:+56224006000" class="border-2 border-white text-white px-8 py-4 rounded-lg font-semibold text-center hover:bg-white/10 transition-colors flex items-center justify-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            Llamanos ahora
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Clients Section -->
  <section class="py-12 bg-white border-b border-neutral-100">
    <div class="container mx-auto px-4">
      <p class="text-center text-sm text-neutral-500 mb-8 uppercase tracking-wider">Algunos de nuestros clientes</p>
      <div class="flex flex-wrap justify-center items-center gap-x-12 gap-y-6">
        {featuredClients.map((client) => (
          <div class="text-lg font-bold text-neutral-300 hover:text-primary-600 transition-colors whitespace-nowrap">
            {client}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Services Section -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="text-3xl lg:text-4xl font-bold text-neutral-900 mb-4">Nuestros Servicios</h2>
        <p class="text-lg text-neutral-600 max-w-2xl mx-auto">
          Soluciones integrales de seguridad adaptadas a tus necesidades especificas
        </p>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        {services.map(service => (
          <a href={`/servicios/${service.slug}`} class="group bg-neutral-50 rounded-xl p-6 hover:shadow-lg transition-all hover:-translate-y-1">
            <div class="w-12 h-12 bg-primary-100 rounded-lg flex items-center justify-center mb-4 group-hover:bg-primary-600 transition-colors">
              <svg class="w-6 h-6 text-primary-600 group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-neutral-900 mb-2">{service.name}</h3>
            <p class="text-neutral-600 text-sm line-clamp-2">{service.short_description}</p>
            <div class="mt-4 text-primary-600 font-medium text-sm flex items-center gap-1 group-hover:gap-2 transition-all">
              Conocer mas
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- GuardPod Featured Section -->
  <section class="py-16 lg:py-20 bg-gradient-to-br from-primary-700 to-primary-800 text-white">
    <div class="container mx-auto px-4">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <div class="inline-flex items-center gap-2 bg-accent/20 text-accent px-4 py-2 rounded-full text-sm font-medium mb-6">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/>
            </svg>
            Tecnologia Propia
          </div>
          <h2 class="text-3xl lg:text-4xl font-bold mb-4">Guard Pod</h2>
          <p class="text-xl text-white/80 mb-6">
            Unidad autonoma de vigilancia 24/7. Energia solar, camaras PTZ 360°, conectividad 4G/LTE y monitoreo remoto.
          </p>
          <ul class="space-y-3 mb-8">
            <li class="flex items-center gap-3">
              <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              <span>Instalacion en menos de 2 horas</span>
            </li>
            <li class="flex items-center gap-3">
              <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              <span>Funciona sin infraestructura electrica</span>
            </li>
            <li class="flex items-center gap-3">
              <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              <span>Ideal para obras, eventos y zonas remotas</span>
            </li>
            <li class="flex items-center gap-3">
              <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              <span>15 meses de desarrollo propio</span>
            </li>
          </ul>
          <a href="/servicios/guard-pod" class="inline-flex items-center gap-2 bg-accent text-white px-6 py-3 rounded-lg font-semibold hover:bg-accent-hover transition-colors">
            Conocer Guard Pod
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
        <div class="relative">
          <div class="bg-primary-600/50 rounded-2xl aspect-video flex items-center justify-center border-2 border-white/10">
            <div class="text-center">
              <svg class="w-20 h-20 text-white/50 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
              </svg>
              <p class="text-white/70">Imagen Guard Pod</p>
            </div>
          </div>
          <div class="absolute -bottom-4 -right-4 bg-accent text-white px-4 py-2 rounded-lg font-semibold text-sm shadow-lg">
            15 meses de I+D
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Sectors Section -->
  <section class="py-16 lg:py-24 bg-neutral-50">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="text-3xl lg:text-4xl font-bold text-neutral-900 mb-4">Sectores que Atendemos</h2>
        <p class="text-lg text-neutral-600 max-w-2xl mx-auto">
          Protegemos empresas de todos los sectores en la Region Metropolitana
        </p>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
        <a href="/sectores/hoteleria" class="bg-white rounded-xl p-4 text-center hover:shadow-lg transition-all hover:-translate-y-1 group">
          <div class="text-4xl mb-2">🏨</div>
          <div class="font-medium text-neutral-900 group-hover:text-primary-600">Hotelería</div>
        </a>
        <a href="/sectores/corporativo" class="bg-white rounded-xl p-4 text-center hover:shadow-lg transition-all hover:-translate-y-1 group">
          <div class="text-4xl mb-2">🏢</div>
          <div class="font-medium text-neutral-900 group-hover:text-primary-600">Corporativo</div>
        </a>
        <a href="/sectores/residencial" class="bg-white rounded-xl p-4 text-center hover:shadow-lg transition-all hover:-translate-y-1 group">
          <div class="text-4xl mb-2">🏠</div>
          <div class="font-medium text-neutral-900 group-hover:text-primary-600">Residencial</div>
        </a>
        <a href="/sectores/industrial" class="bg-white rounded-xl p-4 text-center hover:shadow-lg transition-all hover:-translate-y-1 group">
          <div class="text-4xl mb-2">🏭</div>
          <div class="font-medium text-neutral-900 group-hover:text-primary-600">Industrial</div>
        </a>
        <a href="/sectores/automotriz" class="bg-white rounded-xl p-4 text-center hover:shadow-lg transition-all hover:-translate-y-1 group">
          <div class="text-4xl mb-2">🚗</div>
          <div class="font-medium text-neutral-900 group-hover:text-primary-600">Automotriz</div>
        </a>
        <a href="/sectores/diplomatico" class="bg-white rounded-xl p-4 text-center hover:shadow-lg transition-all hover:-translate-y-1 group">
          <div class="text-4xl mb-2">🏛️</div>
          <div class="font-medium text-neutral-900 group-hover:text-primary-600">Diplomático</div>
        </a>
      </div>
      <div class="text-center mt-8">
        <a href="/sectores" class="text-primary-600 font-medium hover:text-primary-700 inline-flex items-center gap-1">
          Ver todos los sectores
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Locations Section -->
  <section class="py-16 lg:py-24 bg-neutral-50">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="text-3xl lg:text-4xl font-bold text-neutral-900 mb-4">Cobertura en toda la Region</h2>
        <p class="text-lg text-neutral-600 max-w-2xl mx-auto">
          Protegemos empresas y residencias en las principales comunas de Santiago y zona周边
        </p>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        {locations.map(location => (
          <a href={`/ubicaciones/${location.slug}`} class="bg-white rounded-lg p-4 text-center hover:shadow-md transition-all hover:border-primary-500 border-2 border-transparent">
            <h3 class="font-semibold text-neutral-900">{location.name}</h3>
            <span class="text-xs text-neutral-500">{location.zone}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 lg:py-20 bg-primary-600 text-white">
    <div class="container mx-auto px-4 text-center">
      <h2 class="text-3xl lg:text-4xl font-bold mb-4">Listo para proteger tu propiedad?</h2>
      <p class="text-lg text-white/90 mb-8 max-w-2xl mx-auto">
        Contactanos hoy para una cotizacion sin compromiso. Respuesta inmediata garantizada.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/cotizacion" class="bg-white text-primary-600 px-8 py-4 rounded-lg font-semibold hover:bg-neutral-100 transition-colors">
          Solicitar cotizacion gratis
        </a>
        <a href="/contacto" class="border-2 border-white text-white px-8 py-4 rounded-lg font-semibold hover:bg-white/10 transition-colors">
          Hablar con un experto
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
