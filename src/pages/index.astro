---
import BaseLayout from '../layouts/BaseLayout.astro';
import SchemaWebSite from '../components/seo/SchemaWebSite.astro';
import SchemaOrganization from '../components/seo/SchemaOrganization.astro';
import { getServices, getLocations, getSectors, getFeaturedClients, getSiteConfig, optimizeImageUrl } from '../data/directus';

const services = getServices();
const locations = getLocations();
const sectors = getSectors();
const clients = getFeaturedClients();
const config = getSiteConfig();

const siteConfig = {
  name: config?.site_name || 'GuardMan Chile',
  phone: config?.phone || '+56930000010',
  phoneTel: (config?.phone || '+56930000010').replace(/[^0-9+]/g, ''),
  tagline: config?.tagline || 'Protegemos lo que mas te importa',
  email: config?.email || 'info@guardman.cl',
  stats: {
    guards: config?.stats_guards || '500+',
    clients: config?.stats_clients || '200+',
    locations: config?.stats_locations || '14',
    years: config?.stats_years || '8+',
  }
};

const guardPodService = services.find(s => s.slug === 'guard-pod');
const featuredClients = clients.map(c => c.name);
---

<BaseLayout title="Seguridad Privada en Santiago | GuardMan Chile" description={config?.seo_description || 'GuardMan Chile - Empresa lider en servicios de seguridad privada. Guardias certificados OS-10, CCTV, control de accesos y monitoreo 24/7 en toda la Region Metropolitana.'} image={optimizeImageUrl(`/images/${config?.hero_image}`)}>
  <!-- Schema Markup for Homepage -->
  <SchemaWebSite />
  <SchemaOrganization />
  
  <!-- 1. Hero Section -->
  <section class="relative bg-primary-600 text-white overflow-hidden">
    <div class="absolute inset-0">
      {config?.hero_image && (
        <img 
          src={optimizeImageUrl(`/images/${config.hero_image}`)}
          alt="GuardMan Chile - Seguridad Privada"
          class="w-full h-full object-cover"
          width="1920"
          height="1080"
          loading="eager"
          fetchpriority="high"
        />
      )}
      <div class="absolute inset-0 bg-gradient-to-r from-primary-800/95 to-primary-600/70"></div>
    </div>
    <div class="container mx-auto px-4 py-20 lg:py-28 relative z-10">
      <div class="max-w-3xl">
        <h1 class="text-4xl lg:text-5xl xl:text-6xl font-bold leading-tight mb-6">
          {siteConfig.tagline}
        </h1>
        <p class="text-xl lg:text-2xl text-white/90 mb-8">
          {config?.description || 'Empresa lider en servicios de seguridad privada en Santiago. Guardias certificados, tecnologia de vanguardia y atencion personalizada.'}
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="/cotizacion" class="bg-white text-primary-600 px-8 py-4 rounded-lg font-semibold text-center hover:bg-neutral-100 transition-colors">
            Solicita tu cotizacion gratis
          </a>
          <a href={`tel:${siteConfig.phoneTel}`} class="border-2 border-white text-white px-8 py-4 rounded-lg font-semibold text-center hover:bg-white/10 transition-colors flex items-center justify-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            {config?.phone_display || siteConfig.phone}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Quienes Somos Section -->
  <section class="py-16 lg:py-24 bg-white border-b border-neutral-200">
    <div class="container mx-auto px-4">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <div class="inline-flex items-center gap-2 bg-primary-100 text-primary-700 px-4 py-2 rounded-full text-sm font-medium mb-6">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5"/>
            </svg>
            Sobre Nosotros
          </div>
          <h2 class="text-3xl lg:text-4xl font-bold mb-4 text-neutral-900">
            {siteConfig.name} - Seguridad privada profesional en Santiago
          </h2>
          <p class="text-lg text-neutral-600 mb-6 max-w-xl">
            Mas de {siteConfig.stats.years} anos de experiencia protegiendo lo que mas te importa. Guardias certificados OS-10 y tecnologia de vanguardia para un servicio integral y confiable.
          </p>
          <ul class="space-y-3 mb-8">
            <li class="flex items-center gap-3">
              <svg class="w-5 h-5 text-primary-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              <span class="text-neutral-700">Guardias certificados OS-10 vigentes</span>
            </li>
            <li class="flex items-center gap-3">
              <svg class="w-5 h-5 text-primary-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              <span class="text-neutral-700">Cumplimiento Ley 21.659</span>
            </li>
            <li class="flex items-center gap-3">
              <svg class="w-5 h-5 text-primary-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              <span class="text-neutral-700">Atencion 24/7 los 365 dias</span>
            </li>
            <li class="flex items-center gap-3">
              <svg class="w-5 h-5 text-primary-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              <span class="text-neutral-700">Centro de monitoreo propio</span>
            </li>
          </ul>
          <a href="/nosotros" class="inline-flex items-center gap-2 bg-primary-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-primary-700 transition-colors">
            Conoce mas sobre nosotros
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
        <div class="relative">
          <div class="bg-gradient-to-br from-primary-100 to-primary-200 rounded-2xl aspect-video flex items-center justify-center border-2 border-primary-200">
            <div class="text-center">
              <div class="grid grid-cols-2 gap-4 mb-4">
                <div class="bg-white/80 rounded-xl p-4">
                  <div class="text-3xl font-bold text-primary-600">{siteConfig.stats.guards}</div>
                  <div class="text-sm text-neutral-600">Guardias</div>
                </div>
                <div class="bg-white/80 rounded-xl p-4">
                  <div class="text-3xl font-bold text-primary-600">{siteConfig.stats.clients}</div>
                  <div class="text-sm text-neutral-600">Clientes</div>
                </div>
                <div class="bg-white/80 rounded-xl p-4">
                  <div class="text-3xl font-bold text-primary-600">{siteConfig.stats.locations}</div>
                  <div class="text-sm text-neutral-600">Comunas</div>
                </div>
                <div class="bg-white/80 rounded-xl p-4">
                  <div class="text-3xl font-bold text-primary-600">{siteConfig.stats.years}</div>
                  <div class="text-sm text-neutral-600">Anos</div>
                </div>
              </div>
              <p class="text-primary-700 font-medium">Resultados que hablan por si solos</p>
            </div>
          </div>
          <div class="absolute -bottom-4 -right-4 bg-accent text-white px-4 py-2 rounded-lg font-semibold text-sm shadow-lg">
            Trayectoria comprobada
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Servicios Section -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="text-3xl lg:text-4xl font-bold text-neutral-900 mb-4">Soluciones de seguridad para cada necesidad</h2>
        <p class="text-lg text-neutral-600 max-w-2xl mx-auto">
          Desde guardias de seguridad hasta tecnologia de vigilancia avanzada, adaptamos nuestros servicios a las caracteristicas de tu empresa o residencia.
        </p>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        {services.filter(s => s.slug !== 'guard-pod').map(service => (
          <a href={`/servicios/${service.slug}`} class="group bg-neutral-50 rounded-xl overflow-hidden hover:shadow-lg transition-all hover:-translate-y-1">
            <div class="aspect-video bg-gradient-to-br from-primary-100 to-primary-200 relative overflow-hidden">
              {service.image ? (
                <img 
                  src={optimizeImageUrl(`/images/${service.image}`)}
                  alt={service.name}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  width="800"
                  height="450"
                  loading="lazy"
                />
              ) : (
                <div class="w-full h-full flex items-center justify-center">
                  <svg class="w-12 h-12 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                  </svg>
                </div>
              )}
            </div>
            <div class="p-6">
              <h3 class="text-lg font-semibold text-neutral-900 mb-2">{service.name}</h3>
              <p class="text-neutral-600 text-sm line-clamp-2">{service.short_description}</p>
            </div>
          </a>
        ))}
      </div>
      <div class="text-center mt-8">
        <a href="/servicios" class="inline-flex items-center gap-2 text-primary-600 font-medium hover:text-primary-700 transition-colors">
          Ver todos los servicios
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- 4. Guard Pod Section -->
  {guardPodService && (
    <section class="py-16 lg:py-24 bg-gradient-to-br from-primary-700 to-primary-800 text-white">
      <div class="container mx-auto px-4">
        <div class="grid lg:grid-cols-2 gap-12 items-center">
          <div>
            <div class="inline-flex items-center gap-2 bg-accent/20 text-accent px-4 py-2 rounded-full text-sm font-medium mb-6">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/>
              </svg>
              Tecnologia Propia
            </div>
            <h2 class="text-3xl lg:text-4xl font-bold mb-4">Guard Pod</h2>
            <p class="text-lg text-white/80 mb-6 max-w-xl">
              Vigilancia autonoma para obras, eventos y zonas sin infraestructura. Energia solar, camaras PTZ y monitoreo remoto en una unidad desplegable en menos de 2 horas.
            </p>
            <ul class="space-y-3 mb-8">
              <li class="flex items-center gap-3">
                <svg class="w-5 h-5 text-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
                <span>Despliegue en menos de 2 horas</span>
              </li>
              <li class="flex items-center gap-3">
                <svg class="w-5 h-5 text-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
                <span>Energia solar, funciona sin red electrica</span>
              </li>
              <li class="flex items-center gap-3">
                <svg class="w-5 h-5 text-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
                <span>Camaras PTZ 360° con vision nocturna</span>
              </li>
              <li class="flex items-center gap-3">
                <svg class="w-5 h-5 text-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
                <span>15 meses de desarrollo propio</span>
              </li>
            </ul>
            <a href="/servicios/guard-pod" class="inline-flex items-center gap-2 bg-accent text-white px-6 py-3 rounded-lg font-semibold hover:bg-accent-hover transition-colors">
              Conocer Guard Pod
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </a>
          </div>
          <div class="relative">
            <div class="bg-primary-600/50 rounded-2xl aspect-video flex items-center justify-center border-2 border-white/10">
              <div class="text-center">
                <svg class="w-20 h-20 text-white/50 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                </svg>
                <p class="text-white/70">Imagen Guard Pod</p>
              </div>
            </div>
            <div class="absolute -bottom-4 -right-4 bg-accent text-white px-4 py-2 rounded-lg font-semibold text-sm shadow-lg">
              15 meses de I+D
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- 5. Sectores Section -->
  <section class="py-16 lg:py-24 bg-neutral-50">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="text-3xl lg:text-4xl font-bold text-neutral-900 mb-4">Soluciones por sector</h2>
        <p class="text-lg text-neutral-600 max-w-2xl mx-auto">
          Adaptamos nuestros servicios a las necesidades especificas de cada industria en Santiago
        </p>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {sectors.map(sector => (
          <a href={`/sectores/${sector.slug}`} class="group bg-white rounded-xl overflow-hidden hover:shadow-lg transition-all hover:-translate-y-1">
            <div class="aspect-video bg-gradient-to-br from-primary-100 to-primary-200 relative overflow-hidden">
              {sector.image && (
                <img 
                  src={optimizeImageUrl(`/images/${sector.image}`)}
                  alt={sector.name}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  width="800"
                  height="450"
                  loading="lazy"
                />
              )}
              <div class="absolute inset-0 bg-gradient-to-t from-primary-800/70 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
            </div>
            <div class="p-6">
              <h3 class="text-lg font-semibold text-neutral-900 mb-2 group-hover:text-primary-600 transition-colors">{sector.name}</h3>
              <p class="text-neutral-600 text-sm line-clamp-2">{sector.description}</p>
            </div>
          </a>
        ))}
      </div>
      <div class="text-center mt-8">
        <a href="/sectores" class="inline-flex items-center gap-2 text-primary-600 font-medium hover:text-primary-700 transition-colors">
          Ver todos los sectores
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- 6. Clientes Section -->
  {featuredClients.length > 0 && (
    <section class="py-16 lg:py-24 bg-white border-t border-neutral-200">
      <div class="container mx-auto px-4">
        <h2 class="text-3xl lg:text-4xl font-bold text-neutral-900 mb-8 text-center">Empresas que confian en GuardMan</h2>
        <div class="flex flex-wrap justify-center gap-4">
          {featuredClients.map((client) => (
            <div class="bg-neutral-50 px-6 py-4 rounded-lg border border-neutral-200">
              <span class="text-lg font-semibold text-neutral-600">{client}</span>
            </div>
          ))}
        </div>
        <p class="text-center mt-6 text-neutral-500">
          <a href="/nosotros" class="text-primary-600 hover:text-primary-700 font-medium">Conoce mas sobre nosotros</a>
        </p>
      </div>
    </section>
  )}

  <!-- 7. Ubicaciones Section -->
  <section class="py-16 lg:py-24 bg-neutral-50">
    <div class="container mx-auto px-4">
      <div class="text-center mb-8">
        <h2 class="text-3xl lg:text-4xl font-bold text-neutral-900 mb-4">Cobertura en toda la Region Metropolitana</h2>
        <p class="text-lg text-neutral-600 max-w-2xl mx-auto">
          Protegemos empresas y residencias en las principales comunas de Santiago y la zona de Los Andes y San Felipe.
        </p>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-7 gap-3">
        {locations.map(location => (
          <a href={`/ubicaciones/${location.slug}`} class="bg-white rounded-lg p-3 text-center hover:shadow-md transition-all hover:border-primary-500 border-2 border-transparent group">
            <h3 class="font-semibold text-neutral-900 group-hover:text-primary-600 transition-colors text-sm">{location.name}</h3>
            <span class="text-xs text-neutral-500">{location.zone}</span>
          </a>
        ))}
      </div>
      <div class="text-center mt-8">
        <a href="/ubicaciones" class="inline-flex items-center gap-2 text-primary-600 font-medium hover:text-primary-700 transition-colors">
          Ver todas las ubicaciones
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- 7. CTA Final Section -->
  <section class="py-16 lg:py-24 bg-primary-600 text-white relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-primary-700 to-primary-900"></div>
    <div class="container mx-auto px-4 relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl lg:text-4xl font-bold mb-4">Protege lo que mas te importa</h2>
        <p class="text-lg text-white/90 mb-8 max-w-2xl mx-auto">
          Cuentanos sobre tus necesidades y diseñamos una solucion de seguridad a tu medida. Sin compromiso.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center mb-8">
          <a href="/cotizacion" class="bg-white text-primary-600 px-8 py-4 rounded-lg font-semibold text-center hover:bg-neutral-100 transition-colors">
            Solicitar cotizacion gratis
          </a>
          <a href="/contacto" class="border-2 border-white text-white px-8 py-4 rounded-lg font-semibold text-center hover:bg-white/10 transition-colors">
            Hablar con un experto
          </a>
        </div>
        <div class="flex flex-wrap justify-center gap-6 text-sm text-white/70">
          <span class="flex items-center gap-2">
            <svg class="w-5 h-5 text-success" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
            Respuesta en menos de 24 horas
          </span>
          <span class="flex items-center gap-2">
            <svg class="w-5 h-5 text-success" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
            Evaluacion gratuita
          </span>
          <span class="flex items-center gap-2">
            <svg class="w-5 h-5 text-success" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
            Sin compromiso
          </span>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
