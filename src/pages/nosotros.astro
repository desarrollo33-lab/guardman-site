---
/**
 * Nosotros Page — CMS-driven
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { readFileSync, existsSync } from 'fs';
import { COMPANY, STATS, USPS } from '../data/brand';

// Load page content from CMS
const cmsPath = 'src/data/cms/pages-nosotros.json';
const cms = existsSync(cmsPath) ? JSON.parse(readFileSync(cmsPath, 'utf-8')) : {};

const hero = cms.hero || { heading: 'Sobre GuardMan Chile', subheading: 'Más de 8 años protegiendo empresas y residencias en la Región Metropolitana.' };
const story = cms.story || { title: 'Nuestra Historia', paragraphs: [COMPANY.description || ''] };
const team = cms.team || { title: 'Personal que marca la diferencia', description: 'Nuestros guardias son la base de la confianza de nuestros clientes.' };
const stats = cms.stats || { guards: STATS.guards || '500+', clients: STATS.clients || '200+', locations: STATS.locations || '14', years: STATS.years || '8+' };
const certifications: { name: string; description: string }[] = cms.certifications || [];
const values: { title: string; description: string }[] = cms.values || [];

// USPs from brand DNA
const uspList = Object.entries(USPS).map(([key, raw]) => {
  if (typeof raw === 'object' && raw !== null) return raw as { title: string; description: string };
  const parts = String(raw).split('|');
  return { title: parts[0] || '', description: parts[1] || '' };
}).filter(u => u.title);
---

<BaseLayout title={`${hero.heading} | GuardMan Chile`} description={hero.subheading}>
  <!-- Hero -->
  <section class="bg-primary-600 text-white py-16 lg:py-20">
    <div class="container mx-auto px-4">
      <h1 class="text-4xl lg:text-5xl font-bold mb-4">{hero.heading}</h1>
      <p class="text-lg text-white/90 max-w-2xl">{hero.subheading}</p>
    </div>
  </section>

  <!-- Historia + Diferenciadores -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="container mx-auto px-4">
      <div class="grid lg:grid-cols-2 gap-12 items-start">
        <div>
          <h2 class="text-3xl lg:text-4xl font-bold text-neutral-900 mb-6">{story.title}</h2>
          <div class="space-y-4 text-neutral-600">
            {(Array.isArray(story.paragraphs) ? story.paragraphs : [story.paragraphs]).map((p: string) => (
              <p class="text-lg">{p}</p>
            ))}
          </div>
        </div>
        <div class="bg-neutral-50 rounded-2xl p-8 border border-neutral-200">
          <h3 class="text-2xl lg:text-3xl font-bold text-neutral-900 mb-6">Lo que nos diferencia</h3>
          <div class="space-y-4">
            {uspList.map((usp) => (
              <div class="flex gap-4">
                <div class="w-10 h-10 bg-primary-100 rounded-lg flex items-center justify-center shrink-0">
                  <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                  </svg>
                </div>
                <div>
                  <h4 class="font-semibold text-neutral-900">{usp.title}</h4>
                  <p class="text-neutral-600 text-sm">{usp.description}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Estadísticas -->
  <section class="py-16 lg:py-24 bg-neutral-800 text-white">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-8 text-center">
        <div>
          <div class="text-4xl lg:text-5xl font-bold text-accent mb-2">{stats.guards}</div>
          <div class="text-neutral-300">Guardias en terreno</div>
        </div>
        <div>
          <div class="text-4xl lg:text-5xl font-bold text-accent mb-2">{stats.clients}</div>
          <div class="text-neutral-300">Clientes activos</div>
        </div>
        <div>
          <div class="text-4xl lg:text-5xl font-bold text-accent mb-2">{stats.locations}</div>
          <div class="text-neutral-300">Comunas con cobertura</div>
        </div>
        <div>
          <div class="text-4xl lg:text-5xl font-bold text-accent mb-2">{stats.years}</div>
          <div class="text-neutral-300">Años de experiencia</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Valores -->
  {values.length > 0 && (
    <section class="py-16 lg:py-24 bg-neutral-50">
      <div class="container mx-auto px-4">
        <h2 class="text-3xl lg:text-4xl font-bold text-neutral-900 mb-8 text-center">Nuestros Valores</h2>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {values.map((value) => (
            <div class="bg-white rounded-xl p-6 border border-neutral-200 hover:shadow-lg transition-shadow">
              <div class="w-10 h-10 bg-primary-100 rounded-lg flex items-center justify-center mb-4">
                <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
              </div>
              <h3 class="font-bold text-neutral-900 mb-2">{value.title}</h3>
              <p class="text-neutral-600 text-sm">{value.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Certificaciones -->
  {certifications.length > 0 && (
    <section class="py-16 lg:py-24 bg-white">
      <div class="container mx-auto px-4">
        <h2 class="text-3xl lg:text-4xl font-bold text-neutral-900 mb-8 text-center">Certificaciones y Cumplimiento</h2>
        <div class="grid sm:grid-cols-2 gap-4 max-w-3xl mx-auto">
          {certifications.map((cert) => (
            <div class="flex items-start gap-3 bg-neutral-50 rounded-lg p-4">
              <svg class="w-5 h-5 text-success mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
              </svg>
              <div>
                <span class="font-semibold text-neutral-900">{cert.name}</span>
                <p class="text-neutral-600 text-sm">{cert.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="py-16 lg:py-24 bg-primary-600 text-white relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-primary-700 to-primary-900"></div>
    <div class="container mx-auto px-4 relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl lg:text-4xl font-bold mb-4">¿Necesitas seguridad profesional?</h2>
        <p class="text-lg text-white/90 mb-8 max-w-2xl mx-auto">
          Cotiza sin compromiso y recibe una propuesta personalizada en menos de 24 horas.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/cotizacion" class="inline-flex items-center gap-2 bg-white text-primary-600 px-8 py-4 rounded-lg font-semibold hover:bg-neutral-100 transition-colors">
            Solicitar Cotización
          </a>
          <a href="/contacto" class="inline-flex items-center gap-2 border-2 border-white text-white px-8 py-4 rounded-lg font-semibold hover:bg-white/10 transition-colors">
            Hablar con un experto
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
