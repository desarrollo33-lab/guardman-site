---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getServices, getLocations, getServiceBySlug, getLocationBySlug, getSiteConfig, optimizeImageUrl } from '../../../data/directus';
import SchemaService from '../../../components/seo/SchemaService.astro';
import SchemaLocalBusiness from '../../../components/seo/SchemaLocalBusiness.astro';
import SchemaFAQ from '../../../components/seo/SchemaFAQ.astro';
import SchemaBreadcrumb from '../../../components/seo/SchemaBreadcrumb.astro';

export function getStaticPaths() {
  const services = getServices();
  const locations = getLocations();
  
  // Generate ALL combo pages: all services x all locations
  const paths: { params: { slug: string; location: string }; props: { service: any; location: any } }[] = [];
  
  for (const service of services) {
    for (const location of locations) {
      paths.push({
        params: { slug: service.slug, location: location.slug },
        props: { service, location },
      });
    }
  }
  
  return paths;
}

const { service, location } = Astro.props;
const config = getSiteConfig();

// Get all services and locations for related links
const allServices = getServices();
const allLocations = getLocations();

// Nearby locations in same zone
const nearbyLocations = allLocations
  .filter(l => l.slug !== location.slug && l.zone === location.zone)
  .slice(0, 3);

// Related services for same location
const relatedServices = allServices
  .filter(s => s.slug !== service.slug)
  .slice(0, 3);

// Build site config
const siteConfig = {
  name: config?.site_name || 'GuardMan Chile',
  phone: config?.phone || '+56 2 2400 6000',
  phoneTel: (config?.phone || '+56 2 2400 6000').replace(/[^0-9+]/g, ''),
};

// SEO-friendly meta title (max 60 chars) following TEMPLATE-STANDARDS.md
const metaTitle = `${service.name} en ${location.name} - GuardMan`;
const metaDescription = `${service.name} profesional en ${location.name} (${location.zone}). ${service.short_description} Atención 24/7. Solicita tu cotización.`;

// Context by zone for localized FAQs
const zoneContext: Record<string, { challenges: string; focus: string }> = {
  'Oriente': { challenges: 'embajadas, residenciales de lujo y oficinas corporativas', focus: 'control de accesos VIP y monitoreo perimetral' },
  'Centro': { challenges: 'comercios, hoteles y oficinas públicas', focus: 'control de flujos y CCTV comercial' },
  'Norte': { challenges: 'industrias, bodegas y centros logísticos', focus: 'vigilancia perimetral y control vehicular' },
  'Suroriente': { challenges: 'residenciales, condominos y barrios privados', focus: 'vigilancia vecinal y rondas preventivas' },
  'Poniente': { challenges: 'industrias, comércio y aeropuertos', focus: 'seguridad para carga aérea y monitoreo industrial' },
  'Sur': { challenges: 'residencial popular y comercio local', focus: 'seguridad comunitaria y prevención' },
  'Valparaiso': { challenges: 'agricultura, comercio regional y turismo', focus: 'seguridad para packing y bodegas agrícolas' },
};

const ctx = zoneContext[location.zone] || { challenges: 'residencial y comercial', focus: 'seguridad general' };

// Combo FAQs con contexto de zona
const comboFAQs = [
  {
    question: `¿Cuánto cuesta el servicio de ${service.name} en ${location.name}?`,
    answer: `El precio de ${service.name} en ${location.name} varía según el tipo de propiedad y horarios requeridos. En ${location.zone}, nos especializamos en proteger ${ctx.challenges}. Solicita tu cotización gratuita y te entregamos un presupuesto personalizado en menos de 24 horas.`
  },
  {
    question: `¿Tienen guardias disponibles las 24 horas en ${location.name}?`,
    answer: `Sí, tenemos cobertura 24/7 en ${location.name} y toda la zona de ${location.zone}. Nuestro centro de operaciones monitorea ${ctx.focus} para clientes residenciales y corporativos.`
  },
  {
    question: `¿Qué incluye el servicio de ${service.name} en ${location.zone}?`,
    answer: `Nuestro servicio incluye personal certificado OS-10, supervisión continua, informes periódicos y coordinación con Carabineros. En ${location.name}, nos enfocamos en ${ctx.focus}.`
  },
  {
    question: `¿Cómo contrato ${service.name} en ${location.name}?`,
    answer: `Solicita tu cotización gratis llamando al ${siteConfig.phone}, escribiendo a info@guardman.cl o a través de nuestro formulario. Atendemos ${location.name} y toda ${location.zone}.`
  }
];

// Area served for schema
const areaServed = [location.name];

// Breadcrumb items for Schema
const breadcrumbItems = [
  { name: 'Inicio', url: 'https://guardman.cl' },
  { name: 'Servicios', url: 'https://guardman.cl/servicios' },
  { name: service.name, url: `https://guardman.cl/servicios/${service.slug}` },
  { name: location.name, url: `https://guardman.cl/servicios/${service.slug}/${location.slug}` },
];
---

<BaseLayout title={metaTitle} description={metaDescription}>
  <!-- Schema Markup -->
  <SchemaService 
    name={`${service.name} en ${location.name}`}
    description={service.description}
    slug={`${service.slug}/${location.slug}`}
    priceRange={service.price_range}
    areaServed={areaServed}
  />
  <SchemaLocalBusiness 
    name={location.name}
    description={`${service.name} en ${location.name}`}
    slug={`${service.slug}/${location.slug}`}
    address="Av. Americo Vespucio Norte 1980"
    locality={location.name}
    latitude={location.latitude}
    longitude={location.longitude}
    neighborhood={location.neighborhoods?.[0]}
  />
  <SchemaFAQ faqs={comboFAQs} />
  <SchemaBreadcrumb items={breadcrumbItems} />
  
  <!-- Breadcrumb -->
  <div class="bg-neutral-100 py-3">
    <div class="container mx-auto px-4">
      <nav class="flex text-sm text-neutral-600">
        <a href="/" class="hover:text-primary-600">Inicio</a>
        <span class="mx-2">/</span>
        <a href="/servicios" class="hover:text-primary-600">Servicios</a>
        <span class="mx-2">/</span>
        <a href={`/servicios/${service.slug}`} class="hover:text-primary-600">{service.name}</a>
        <span class="mx-2">/</span>
        <span class="text-neutral-900">{location.name}</span>
      </nav>
    </div>
  </div>

  <!-- Hero -->
  <section class="relative bg-primary-600 text-white py-16 lg:py-20 overflow-hidden">
    {service.image && (
      <div class="absolute inset-0">
        <img 
          src={optimizeImageUrl(`/images/${service.image}`)}
          alt={service.name}
          class="w-full h-full object-cover opacity-30"
          width="1920"
          height="1080"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    )}
    <div class="absolute inset-0 bg-gradient-to-r from-primary-800/90 to-primary-600/70"></div>
    <div class="container mx-auto px-4 relative z-10">
      <div class="flex items-center gap-2 text-white/80 text-sm mb-4">
        <span class="bg-white/20 px-3 py-1 rounded-full">{location.zone}</span>
      </div>
      <h1 class="text-3xl lg:text-5xl font-bold mb-4">{service.name} en {location.name}</h1>
      <p class="text-xl text-white/90 max-w-3xl">{service.short_description}</p>
    </div>
  </section>

  <!-- Main Content -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="container mx-auto px-4">
      <div class="grid lg:grid-cols-3 gap-12">
        <!-- Content -->
        <div class="lg:col-span-2">
          <!-- Service Introduction -->
          <div class="mb-8">
            <h2 class="text-2xl font-bold text-neutral-900 mb-4">Servicio de {service.name} en {location.name}</h2>
            <p class="text-neutral-600 leading-relaxed">{service.description}</p>
          </div>

          <!-- Features -->
          {service.features && service.features.length > 0 && (
            <div class="mb-8">
              <h3 class="text-xl font-bold text-neutral-900 mb-4">Que incluye el servicio</h3>
              <div class="grid sm:grid-cols-2 gap-3">
                {service.features.map(feature => (
                  <div class="flex items-start gap-3 bg-neutral-50 rounded-lg p-3">
                    <svg class="w-5 h-5 text-success mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                    </svg>
                    <span class="text-neutral-700 text-sm">{feature}</span>
                  </div>
                ))}
              </div>
            </div>
          )}

          <!-- Location Specific Content -->
          <div class="mb-8 bg-primary-50 rounded-xl p-6">
            <h3 class="text-xl font-bold text-neutral-900 mb-4">Cobertura en {location.name}</h3>
            <p class="text-neutral-600 mb-4">{location.description}</p>
            {location.neighborhoods && location.neighborhoods.length > 0 && (
              <div class="flex flex-wrap gap-2">
                {location.neighborhoods.map(n => (
                  <span class="bg-primary-100 text-primary-700 px-3 py-1 rounded-full text-sm">{n}</span>
                ))}
              </div>
            )}
          </div>

          <!-- Process -->
          {service.process && service.process.length > 0 && (
            <div class="mb-8">
              <h3 class="text-xl font-bold text-neutral-900 mb-4">Nuestro proceso</h3>
              <div class="grid sm:grid-cols-4 gap-4">
                {service.process.map((step, index) => (
                  <div class="text-center">
                    <div class="w-10 h-10 bg-primary-600 text-white rounded-full flex items-center justify-center text-lg font-bold mx-auto mb-2">
                      {index + 1}
                    </div>
                    <h4 class="font-semibold text-neutral-900 text-sm">{step.step}</h4>
                    <p class="text-neutral-600 text-xs mt-1">{step.description}</p>
                  </div>
                ))}
              </div>
            </div>
          )}

          <!-- Related Services -->
          <div class="mb-8">
            <h3 class="text-xl font-bold text-neutral-900 mb-4">Otros servicios disponibles en {location.name}</h3>
            <div class="grid sm:grid-cols-3 gap-4">
              {relatedServices.map(s => (
                <a href={`/servicios/${s.slug}/${location.slug}`} class="bg-neutral-50 rounded-lg p-4 hover:shadow-md transition-all group">
                  <h4 class="font-semibold text-neutral-900 group-hover:text-primary-600 transition-colors text-sm">{s.name}</h4>
                  <p class="text-neutral-600 text-xs mt-1 line-clamp-2">{s.short_description}</p>
                </a>
              ))}
            </div>
          </div>

          <!-- FAQs -->
          <div class="mb-8">
            <h3 class="text-xl font-bold text-neutral-900 mb-4">Preguntas Frecuentes</h3>
            <div class="space-y-4">
              {comboFAQs.map((faq) => (
                <div class="bg-neutral-50 rounded-lg p-5">
                  <h4 class="font-semibold text-neutral-900 mb-2 flex items-start gap-2">
                    <svg class="w-5 h-5 text-primary-600 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    {faq.question}
                  </h4>
                  <p class="text-neutral-600 text-sm pl-7">{faq.answer}</p>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- Sidebar -->
        <div class="lg:col-span-1">
          <div class="bg-neutral-50 rounded-xl p-6 sticky top-24">
            <h3 class="text-xl font-bold text-neutral-900 mb-4">Cotizar {service.name}</h3>
            <div class="space-y-4">
              <a href="/cotizacion" class="block w-full bg-primary-600 text-white text-center py-3 rounded-lg font-semibold hover:bg-primary-700 transition-colors">
                Solicitar cotizacion
              </a>
              <a href={`tel:${siteConfig.phoneTel}`} class="block w-full border-2 border-primary-600 text-primary-600 text-center py-3 rounded-lg font-semibold hover:bg-primary-50 transition-colors">
                Llamar ahora
              </a>
              <p class="text-center text-sm text-neutral-500">
                Cotizacion gratuita y sin compromiso
              </p>
            </div>

            <!-- Nearby Locations -->
            {nearbyLocations.length > 0 && (
              <div class="mt-6 pt-6 border-t border-neutral-200">
                <h4 class="font-semibold text-neutral-900 mb-3">Tambien en {location.zone}</h4>
                <div class="space-y-2">
                  {nearbyLocations.map(l => (
                    <a href={`/servicios/${service.slug}/${l.slug}`} class="block text-primary-600 hover:text-primary-700 text-sm">
                      {l.name} →
                    </a>
                  ))}
                </div>
              </div>
            )}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 bg-primary-600 text-white">
    <div class="container mx-auto px-4 text-center">
      <h2 class="text-3xl font-bold mb-4">Protege tu {location.name.toLowerCase()} con GuardMan</h2>
      <p class="text-lg text-white/90 mb-8 max-w-2xl mx-auto">
        Contactanos para una evaluacion personalizada de seguridad en {location.name}
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/cotizacion" class="bg-white text-primary-600 px-8 py-4 rounded-lg font-semibold hover:bg-neutral-100 transition-colors">
          Solicitar cotizacion
        </a>
        <a href="/contacto" class="border-2 border-white text-white px-8 py-4 rounded-lg font-semibold hover:bg-white/10 transition-colors">
          Hablar con un experto
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
