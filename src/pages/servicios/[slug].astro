---
/**
 * Service Detail - Unified structure
 * Hero → Intro → Features → Issues → Staff → Locations → Related → CTA
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getServiceSections, getServicesList, getLocationsList } from '../../data/cms';
import { SERVICE_IMAGES, SERVICE_INTROS, SERVICE_RELATED, SERVICE_UPSELL, STAFF_IMAGE, STAFF_TRAITS, getSectorTag } from '../../data/cms-config';
import { optimizeImageUrl } from '../../data/cms-helpers';
import { readFileSync, existsSync } from 'fs';
import SchemaService from '../../components/seo/SchemaService.astro';
import SchemaBreadcrumb from '../../components/seo/SchemaBreadcrumb.astro';

const CMS_DIR = 'src/data/cms';

export async function getStaticPaths() {
  const services = getServicesList();
  return services.map(service => ({
    params: { slug: service.slug },
    props: { serviceSlug: service.slug, serviceName: service.name }
  }));
}

const { slug } = Astro.params;
const serviceName = Astro.props.serviceName;

const serviceSectorsPath = 'src/data/cms/service-sectors.json';
let serviceSectors: Record<string, string[]> = {};
if (existsSync(serviceSectorsPath)) {
  serviceSectors = JSON.parse(readFileSync(serviceSectorsPath, 'utf-8'));
}

const sectorsPath = 'src/data/cms/sectors.json';
let sectors: any[] = [];
if (existsSync(sectorsPath)) {
  const sectorsData = JSON.parse(readFileSync(sectorsPath, 'utf-8'));
  sectors = Array.isArray(sectorsData) ? sectorsData : (sectorsData.results || []);
}

const services = getServicesList();
const locations = getLocationsList();

const service = services.find((s: any) => s.slug === slug) || {
  slug, name: serviceName || slug.replace(/-/g, ' ').replace(/\b\w/g, l => l.toUpperCase()),
  short_description: '', price_range: '$$$'
};

const sections = getServiceSections(slug);

const serviceDataPath = `${CMS_DIR}/${slug}.json`;
let cmsServiceData: any = null;
if (existsSync(serviceDataPath)) {
  const data = JSON.parse(readFileSync(serviceDataPath, 'utf-8'));
  cmsServiceData = { content: data.sections, related_content: {} };
}

const relatedContentFromCMS = cmsServiceData?.related_content || {};
const rawRelated = service?.related_services;
const relatedSlugs = rawRelated?.length > 0
  ? (Array.isArray(rawRelated) ? rawRelated : rawRelated.split(',').map((s: string) => s.trim()))
  : (SERVICE_RELATED[slug] || []);
const relatedServices = relatedContentFromCMS?.related_services?.length > 0
  ? relatedContentFromCMS.related_services
  : relatedSlugs.map((s: string) => services.find((sv: any) => sv.slug === s)).filter(Boolean);
const rawUpsell = service?.upsell_services;
const upsellSlugs = rawUpsell?.length > 0
  ? (Array.isArray(rawUpsell) ? rawUpsell : rawUpsell.split(',').map((s: string) => s.trim()))
  : (SERVICE_UPSELL[slug] || []);
const upsellServices = relatedContentFromCMS?.upsell_services?.length > 0
  ? relatedContentFromCMS.upsell_services
  : upsellSlugs.map((s: string) => {
      const sv = services.find((x: any) => x.slug === s);
      return sv ? { slug: sv.slug, title: sv.name, reason: `Complementa tu servicio de ${service.name.toLowerCase()}`, price_range: sv.price_range || '' } : null;
    }).filter(Boolean);

const breadcrumbItems = [
  { name: 'Inicio', url: 'https://guardman.cl' },
  { name: 'Servicios', url: 'https://guardman.cl/servicios' },
  { name: service.name, url: `https://guardman.cl/servicios/${slug}` }
];

const hero = sections?.hero || { heading: service.name, subheading: service.short_description };
const heroImage = hero.image || service?.hero_image || (SERVICE_IMAGES[slug] ? `/images/${SERVICE_IMAGES[slug]}` : null);
const ogImage = sections?.meta?.ogImage || (heroImage ? `/cdn-cgi/image/width=1200,height=630,format=jpg,fit=cover/${heroImage}` : null);

// Intro: CMS intro.content (string with \n\n) → array; fallback to intro.paragraphs; then SERVICE_INTROS
const cmsIntroContent = sections?.intro?.content;
const introText = cmsIntroContent
  ? cmsIntroContent.split('\n\n').filter(Boolean)
  : sections?.intro?.paragraphs?.length > 0
    ? sections.intro.paragraphs
    : [SERVICE_INTROS[slug] || `${service.name} es uno de nuestros servicios principales. En GuardMan Chile contamos con más de 8 años de experiencia protegiendo empresas y residencias con personal certificado OS-10 y tecnología de vanguardia.`];

// Staff section: load from page content first, fallback to staff.json, then cms-config
const globalStaffPath = `${CMS_DIR}/staff.json`;
let globalStaff = { image: STAFF_IMAGE, title: 'Personal que marca la diferencia', description: 'Nuestros guardias son la base de la confianza que nuestros clientes depositan en nosotros.', traits: STAFF_TRAITS };
if (existsSync(globalStaffPath)) {
  const loaded = JSON.parse(readFileSync(globalStaffPath, 'utf-8'));
  globalStaff = { image: loaded.image || STAFF_IMAGE, title: loaded.title || globalStaff.title, description: loaded.description || globalStaff.description, traits: loaded.traits || STAFF_TRAITS };
}
// Per-page override from CMS content
const staffData = sections?.staff ? {
  image: (sections.staff as any).image || globalStaff.image,
  title: (sections.staff as any).title || globalStaff.title,
  description: (sections.staff as any).description || globalStaff.description,
  traits: (sections.staff as any).traits || globalStaff.traits,
} : globalStaff;
---

<BaseLayout title={hero.heading ? `${hero.heading} | GuardMan` : service.name} description={hero.subheading || service.short_description} image={ogImage}>
  <SchemaService name={service.name} description={hero.heading || service.name} slug={slug} priceRange={service.price_range} areaServed={locations.map((l: any) => l.name)} />
  <SchemaBreadcrumb items={breadcrumbItems} />

  <!-- Breadcrumb -->
  <div class="bg-neutral-100 py-3">
    <div class="container mx-auto px-4">
      <nav class="flex text-sm text-neutral-600" aria-label="Breadcrumb">
        <a href="/" class="hover:text-primary-600">Inicio</a>
        <span class="mx-2" aria-hidden="true">/</span>
        <a href="/servicios" class="hover:text-primary-600">Servicios</a>
        <span class="mx-2" aria-hidden="true">/</span>
        <span class="text-neutral-900 font-medium">{hero.heading || service.name}</span>
      </nav>
    </div>
  </div>

  <!-- Hero (sin tags) -->
  <section class="relative bg-primary-600 text-white py-16 lg:py-20 overflow-hidden">
    {heroImage && (
      <div class="absolute inset-0 z-0">
        <img src={optimizeImageUrl(heroImage)} alt={hero.heading} class="w-full h-full object-cover opacity-30" width="1920" height="1080" loading="eager" />
        <div class="absolute inset-0 bg-gradient-to-r from-primary-800/95 to-primary-600/80"></div>
      </div>
    )}
    <div class="absolute top-0 right-0 w-64 h-64 bg-primary-500/20 rounded-full blur-3xl translate-x-1/2 -translate-y-1/2" aria-hidden="true"></div>
    <div class="absolute bottom-0 left-0 w-96 h-96 bg-white/5 rounded-full blur-3xl -translate-x-1/2 translate-y-1/2" aria-hidden="true"></div>
    <div class="container mx-auto px-4 relative z-10">
      <h1 class="text-3xl lg:text-5xl font-bold mb-4">{hero.heading}</h1>
      {hero.subheading && <p class="text-xl text-white/90 max-w-3xl">{hero.subheading}</p>}
    </div>
  </section>

  <!-- Main Content with Sidebar -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="container mx-auto px-4">
      <div class="grid lg:grid-cols-3 gap-12">
        <div class="lg:col-span-2">

          <!-- Intro -->
          <div class="mb-12 prose prose-neutral max-w-none">
            {introText.map((p: string) => <p>{p}</p>)}
            {relatedServices.length > 0 && (() => {
              const r0 = relatedServices[0];
              const r0Sections = getServiceSections(typeof r0 === 'string' ? r0 : r0.slug);
              const r0Name = r0Sections?.hero?.heading || (typeof r0 === 'object' ? r0.title || r0.name : '');
              const r0Slug = typeof r0 === 'string' ? r0 : r0.slug;
              return r0Name ? (
                <p class="mt-6">Si necesitas complementar tu seguridad, descubre nuestro servicio de <a href={`/servicios/${r0Slug}`} class="text-primary-600 hover:underline font-medium">{r0Name}</a> que integra perfectamente con nuestra solución.</p>
              ) : null;
            })()}
          </div>

          <!-- Features: Qué incluye -->
          {sections?.features && (
            <div class="mb-12">
              <h2 class="text-2xl font-bold text-neutral-900 mb-6">{sections.features.heading || sections.features.title || 'Qué incluye el servicio'}</h2>
              <div class="grid sm:grid-cols-2 gap-4">
                {(() => {
                  const items = sections.features.items || Object.entries(sections.features).filter(([key]) => !isNaN(Number(key))).map(([_, value]) => value);
                  return items.map((feature: any) => (
                    <div class="flex items-start gap-3 bg-neutral-50 rounded-lg p-4 hover:shadow-md transition-shadow">
                      <svg class="w-5 h-5 text-success mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                      <span class="text-neutral-700">{feature}</span>
                    </div>
                  ));
                })()}
              </div>
            </div>
          )}

          <!-- Issues: Problemas que solucionamos -->
          {sections?.issues && (
            <div class="mb-12">
              <h2 class="text-2xl font-bold text-neutral-900 mb-6">{sections.issues.heading || 'Problemas que solucionamos'}</h2>
              <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
                {Object.entries(sections.issues).filter(([key]) => !isNaN(Number(key)) || key === 'items').map(([key, value]) => key === 'items' ? value : value).flat().filter(item => item && typeof item === 'string').map((issue: string) => (
                  <div class="flex items-start gap-3 bg-amber-50 border border-amber-200 rounded-lg p-4">
                    <svg class="w-5 h-5 text-amber-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                    <span class="text-neutral-700 text-sm font-medium">{issue}</span>
                  </div>
                ))}
              </div>
            </div>
          )}

          <!-- Staff Section (replaces Stats) -->
          <div class="mb-12 bg-neutral-900 text-white rounded-2xl overflow-hidden">
            <div class="grid md:grid-cols-2">
              <div class="relative">
                <img src={staffData.image} alt="Personal GuardMan Chile" class="w-full h-full object-cover min-h-[280px]" width="800" height="500" loading="lazy" />
                <div class="absolute inset-0 bg-gradient-to-t from-neutral-900/60 to-transparent md:bg-gradient-to-r md:from-transparent md:to-neutral-900"></div>
              </div>
              <div class="p-8 flex flex-col justify-center">
                <h2 class="text-2xl font-bold mb-4">{staffData.title}</h2>
                <p class="text-white/80 mb-6">{staffData.description}</p>
                <ul class="space-y-3">
                  {staffData.traits.map((trait: string) => (
                    <li class="flex items-start gap-3">
                      <svg class="w-5 h-5 text-primary-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                      <span class="text-white/90 text-sm">{trait}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>

          <!-- FAQs -->
          {sections?.faqs && (
            <div class="mb-8">
              <h2 class="text-2xl font-bold text-neutral-900 mb-6">{sections.faqs.heading || 'Preguntas Frecuentes'}</h2>
              <div class="space-y-4">
                {Object.entries(sections.faqs).filter(([key]) => !isNaN(Number(key)) || key === 'items').map(([key, value]) => key === 'items' ? value : null).flat().filter(item => item && typeof item === 'object').map((faq: any) => (
                  <details class="group bg-neutral-50 rounded-lg">
                    <summary class="flex items-center justify-between cursor-pointer p-4 font-medium text-neutral-900">{faq.question}<svg class="w-5 h-5 text-neutral-500 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg></summary>
                    <div class="px-4 pb-4 text-neutral-600">{faq.answer}</div>
                  </details>
                ))}
              </div>
            </div>
          )}

          <!-- Locations Grid -->
          <div class="mb-8">
            <h2 class="text-2xl font-bold text-neutral-900 mb-2">Disponible en {locations.length} ubicaciones</h2>
            <p class="text-neutral-600 text-sm mb-6">Selecciona tu comuna para ver detalles y solicitar cotización.</p>
            <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
              {locations.map((location: any) => (
                <a href={`/servicios/${slug}/${location.slug}`} class="bg-neutral-50 hover:bg-primary-50 border border-neutral-200 hover:border-primary-300 rounded-lg p-3 text-center text-sm text-neutral-700 hover:text-primary-700 transition-all font-medium">{location.name}</a>
              ))}
            </div>
            <div class="mt-4 text-center">
              <a href="/ubicaciones" class="text-primary-600 hover:text-primary-700 font-medium text-sm inline-flex items-center gap-1">Explorar mapa de cobertura <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></a>
            </div>
          </div>
        </div>

        <!-- Sidebar (header fijo + body con scroll) -->
        <div class="lg:col-span-1">
          <div class="bg-neutral-50 rounded-xl sticky top-6 max-h-[calc(100vh-3rem)] flex flex-col overflow-hidden">
            <!-- Header fijo -->
            <div class="p-6 pb-0 shrink-0">
              <h3 class="text-xl font-bold text-neutral-900 mb-4">{sections?.cta?.headline || sections?.cta?.heading || `Cotiza ${service.name}`}</h3>
              {sections?.cta?.description && <p class="text-neutral-600 mb-4">{sections.cta.description}</p>}
              <div class="space-y-3">
                <a href="/cotizacion" class="block w-full bg-primary-600 text-white text-center px-6 py-3 rounded-lg font-semibold hover:bg-primary-700 transition-colors">{sections?.cta?.button || sections?.cta?.button_text || 'Solicitar Cotización'}</a>
                <a href="/contacto" class="block w-full border border-primary-600 text-primary-600 text-center px-6 py-3 rounded-lg font-semibold hover:bg-primary-50 transition-colors">Hablar con un experto</a>
              </div>
            </div>
            <!-- Body con scroll -->
            <div class="p-6 pt-4 overflow-y-auto">
              {relatedServices.length > 0 && (
                <div class="pb-6 border-t border-neutral-200 pt-4">
                  <h4 class="text-sm font-semibold text-neutral-700 mb-3">Otros servicios</h4>
                  {relatedServices.map((s: any) => {
                    const otherSections = getServiceSections(s.slug);
                    return <a href={`/servicios/${s.slug}`} class="block py-2 text-sm text-neutral-600 hover:text-primary-600 border-b border-neutral-100 last:border-0">{s.title || otherSections?.hero?.heading || s.name}</a>;
                  })}
                </div>
              )}

              {upsellServices.length > 0 && (
                <div class="pb-6 border-t border-neutral-200 pt-4">
                  <h4 class="text-sm font-semibold text-neutral-700 mb-3">Mejora tu protección</h4>
                  <div class="space-y-2">
                    {upsellServices.map((upsell: any) => (
                      <a href={`/servicios/${upsell.slug}`} class="block p-3 bg-primary-50 rounded-lg hover:bg-primary-100 transition-colors">
                        <span class="font-semibold text-primary-700 text-sm">{upsell.title}</span>
                        <p class="text-primary-600 text-xs">{upsell.price_range}</p>
                      </a>
                    ))}
                  </div>
                </div>
              )}

              {(serviceSectors[slug] || []).length > 0 && (
                <div class="pb-6 border-t border-neutral-200 pt-4">
                  <h4 class="text-sm font-semibold text-neutral-700 mb-3">Sectores que atiende</h4>
                  <div class="flex flex-wrap gap-2">
                    {(serviceSectors[slug] || []).map(sectorSlug => {
                      const sector = sectors.find(s => s.slug === sectorSlug);
                      return sector ? (
                        <a href={`/sectores/${sectorSlug}`} class={`text-xs px-2 py-1 rounded-full border ${getSectorTag(sectorSlug)}`}>{sector.name}</a>
                      ) : null;
                    })}
                  </div>
                </div>
              )}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Related -->
  <section class="py-12 bg-neutral-50">
    <div class="container mx-auto px-4">
      <h2 class="text-2xl font-bold text-neutral-900 mb-6">También te puede interesar</h2>
      <div class="grid md:grid-cols-3 gap-6">
        {relatedServices.slice(0, 3).map((s: any) => {
          const otherSections = getServiceSections(s.slug);
          return (
            <a href={`/servicios/${s.slug}`} class="bg-white rounded-xl p-6 hover:shadow-xl hover:-translate-y-1 transition-all group">
              <h3 class="font-semibold text-neutral-900 group-hover:text-primary-600 transition-colors mb-2">{s.title || otherSections?.hero?.heading || s.name}</h3>
              <p class="text-sm text-neutral-600 line-clamp-2">{s.excerpt || otherSections?.hero?.subheading || s.short_description || s.name}</p>
              <div class="mt-4 text-primary-600 font-medium text-sm flex items-center gap-1">Ver más <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- CTA Final -->
  <section class="py-12 bg-primary-600 text-white">
    <div class="container mx-auto px-4 text-center">
      <h2 class="text-2xl lg:text-3xl font-bold mb-4">{sections?.cta?.headline || sections?.cta?.heading || `¿Necesitas ${service.name}?`}</h2>
      <p class="text-lg text-white/90 mb-6 max-w-2xl mx-auto">{sections?.cta?.description || 'Cotiza gratis y sin compromiso. Respuesta en menos de 24 horas.'}</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/cotizacion" class="inline-block bg-white text-primary-600 px-8 py-3 rounded-lg font-semibold hover:bg-neutral-100 transition-colors">{sections?.cta?.button || sections?.cta?.button_text || 'Solicitar Cotización'}</a>
        <a href="/contacto" class="inline-block border-2 border-white text-white px-8 py-3 rounded-lg font-semibold hover:bg-white/10 transition-colors">Hablar con un experto</a>
      </div>
    </div>
  </section>
</BaseLayout>
