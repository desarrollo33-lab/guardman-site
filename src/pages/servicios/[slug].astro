---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { services } from '../../data/services';
import { locations } from '../../data/locations';

export function getStaticPaths() {
  return services.map(service => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
const relatedServices = services.filter(s => s.id !== service.id).slice(0, 3);
const topLocations = locations.slice(0, 10);
---

<BaseLayout title={service.meta_title} description={service.meta_description}>
  <!-- Breadcrumb -->
  <div class="bg-neutral-100 py-3">
    <div class="container mx-auto px-4">
      <nav class="flex text-sm text-neutral-600">
        <a href="/" class="hover:text-primary-600">Inicio</a>
        <span class="mx-2">/</span>
        <a href="/servicios" class="hover:text-primary-600">Servicios</a>
        <span class="mx-2">/</span>
        <span class="text-neutral-900">{service.name}</span>
      </nav>
    </div>
  </div>

  <!-- Hero -->
  <section class="bg-primary-600 text-white py-16 lg:py-20">
    <div class="container mx-auto px-4">
      <h1 class="text-3xl lg:text-5xl font-bold mb-4">{service.hero_heading}</h1>
      <p class="text-xl text-white/90 max-w-3xl">{service.description}</p>
    </div>
  </section>

  <!-- Main Content -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="container mx-auto px-4">
      <div class="grid lg:grid-cols-3 gap-12">
        <!-- Content -->
        <div class="lg:col-span-2">
          <!-- Features -->
          <div class="mb-12">
            <h2 class="text-2xl font-bold text-neutral-900 mb-6">Que incluye el servicio</h2>
            <div class="grid sm:grid-cols-2 gap-4">
              {(service.features || []).map(feature => (
                <div class="flex items-start gap-3 bg-neutral-50 rounded-lg p-4">
                  <svg class="w-5 h-5 text-success mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                  </svg>
                  <span class="text-neutral-700">{feature}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- Process -->
          {(service.process || []).length > 0 && (
            <div class="mb-12">
              <h2 class="text-2xl font-bold text-neutral-900 mb-6">Nuestro proceso</h2>
              <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
                {service.process.map((step, index) => (
                  <div class="text-center">
                    <div class="w-12 h-12 bg-primary-600 text-white rounded-full flex items-center justify-center text-xl font-bold mx-auto mb-3">
                      {index + 1}
                    </div>
                    <h3 class="font-semibold text-neutral-900 mb-1">{step.step}</h3>
                    <p class="text-sm text-neutral-600">{step.description}</p>
                  </div>
                ))}
              </div>
            </div>
          )}

          <!-- Common Issues -->
          {(service.common_issues || []).length > 0 && (
            <div class="mb-12">
              <h2 class="text-2xl font-bold text-neutral-900 mb-6">Problemas que solucionamos</h2>
              <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
                {service.common_issues.map(issue => (
                  <div class="flex items-start gap-3 bg-warning-light border border-warning/30 rounded-lg p-4">
                    <svg class="w-5 h-5 text-warning shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                    </svg>
                    <span class="text-neutral-700 text-sm">{issue}</span>
                  </div>
                ))}
              </div>
            </div>
          )}

          <!-- Locations -->
          <div>
            <h2 class="text-2xl font-bold text-neutral-900 mb-6">Disponible en estas ubicaciones</h2>
            <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
              {topLocations.map(location => (
                <a href={`/ubicaciones/${location.slug}`} class="bg-neutral-50 hover:bg-primary-50 border border-neutral-200 hover:border-primary-300 rounded-lg p-3 text-center text-sm text-neutral-700 hover:text-primary-700 transition-all">
                  {location.name}
                </a>
              ))}
            </div>
          </div>
        </div>

        <!-- Sidebar -->
        <div class="lg:col-span-1">
          <div class="bg-neutral-50 rounded-xl p-6 sticky top-24">
            <h3 class="text-xl font-bold text-neutral-900 mb-4">Cotizar {service.name}</h3>
            <div class="space-y-4">
              <div>
                <span class="text-sm text-neutral-500">Precio estimado</span>
                <div class="text-2xl font-bold text-primary-600">{service.price_range}</div>
              </div>
              <a href="/cotizacion" class="block w-full bg-primary-600 text-white text-center py-3 rounded-lg font-semibold hover:bg-primary-700 transition-colors">
                Solicitar cotizacion
              </a>
              <a href="tel:+56224006000" class="block w-full border-2 border-primary-600 text-primary-600 text-center py-3 rounded-lg font-semibold hover:bg-primary-50 transition-colors">
                Llamar ahora
              </a>
              <p class="text-center text-sm text-neutral-500">
                Respuesta en menos de 24 horas
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Related Services -->
  <section class="py-12 bg-neutral-50">
    <div class="container mx-auto px-4">
      <h2 class="text-2xl font-bold text-neutral-900 mb-6">Tambien te puede interesar</h2>
      <div class="grid md:grid-cols-3 gap-6">
        {relatedServices.map(s => (
          <a href={`/servicios/${s.slug}`} class="bg-white rounded-xl p-6 hover:shadow-lg transition-all group">
            <h3 class="font-semibold text-neutral-900 group-hover:text-primary-600 transition-colors mb-2">{s.name}</h3>
            <p class="text-sm text-neutral-600 line-clamp-2">{s.short_description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 bg-primary-600 text-white">
    <div class="container mx-auto px-4 text-center">
      <h2 class="text-3xl font-bold mb-4">Contrata {service.name} hoy</h2>
      <p class="text-lg text-white/90 mb-8">Nuestro equipo esta listo para proteger tu propiedad.</p>
      <a href="/cotizacion" class="inline-flex items-center gap-2 bg-white text-primary-600 px-8 py-4 rounded-lg font-semibold hover:bg-neutral-100 transition-colors">
        Solicitar cotizacion gratis
      </a>
    </div>
  </section>
</BaseLayout>
