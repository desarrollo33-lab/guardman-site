---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Pagina no encontrada | GuardMan Chile" noIndex={true}>
  <section class="min-h-[60vh] flex items-center justify-center bg-white">
    <div class="text-center px-4">
      <div class="text-8xl font-bold text-primary-600 mb-4">404</div>
      <h1 class="text-3xl font-bold text-neutral-900 mb-4">Pagina no encontrada</h1>
      <p class="text-lg text-neutral-600 mb-8">
        Lo sentimos, la pagina que buscas no existe o ha sido movida.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/" class="bg-primary-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-primary-700 transition-colors">
          Volver al inicio
        </a>
        <a href="/contacto" class="border-2 border-primary-600 text-primary-600 px-6 py-3 rounded-lg font-semibold hover:bg-primary-50 transition-colors">
          Contactar
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
