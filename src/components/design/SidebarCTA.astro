---
/**
 * SidebarCTA.astro - Sidebar de cotización estandarizado
 * 
 * Usar en páginas de detalle (N2 y N3)
 * Muestra opciones de contacto rápido
 */
interface Props {
  title?: string;
  service?: string;
  location?: string;
  showLocation?: boolean;
}

const { 
  title = 'Cotizar', 
  service,
  location,
  showLocation = true
} = Astro.props;
---

<aside class="bg-neutral-50 rounded-xl p-6 sticky top-24">
  <h3 class="text-xl font-bold text-neutral-900 mb-4">
    {title}
    {service && location && showLocation && <span class="block text-sm font-normal text-neutral-600 mt-1">{service} en {location}</span>}
  </h3>
  
  <div class="space-y-4">
    {/* Botón principal */}
    <a 
      href="/cotizacion" 
      class="block w-full bg-primary-600 text-white text-center py-3 rounded-lg font-semibold hover:bg-primary-700 transition-colors"
    >
      Solicitar Cotización
    </a>
    
    {/* Botón secundario */}
    <a 
      href="tel:+56930000010" 
      class="block w-full border-2 border-primary-600 text-primary-600 text-center py-3 rounded-lg font-semibold hover:bg-primary-50 transition-colors"
    >
      <span class="flex items-center justify-center gap-2">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
        </svg>
        Llamar ahora
      </span>
    </a>
    
    {/* Info adicional */}
    <div class="pt-4 border-t border-neutral-200">
      <div class="flex items-start gap-3 text-sm text-neutral-600">
        <svg class="w-5 h-5 text-primary-600 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
        </svg>
        <span>Cotización gratuita y sin compromiso</span>
      </div>
      <div class="flex items-start gap-3 text-sm text-neutral-600 mt-2">
        <svg class="w-5 h-5 text-primary-600 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <span>Respuesta en menos de 24 horas</span>
      </div>
    </div>
  </div>
</aside>