---
import { COMPANY, SOCIAL, STATS, HOURS } from '../../data/brand';
import { getSiteConfig } from '../../data/directus';

const config = getSiteConfig();

const siteConfig = {
  name: COMPANY.brand_name || config?.site_name || 'GuardMan Chile',
  alternateName: COMPANY.legal_name || 'GuardMan Seguridad Privada',
  url: COMPANY.site_url || config?.site_url || 'https://guardman.cl',
  phone: COMPANY.phone || config?.phone || '+56 9 300 000 10',
  email: COMPANY.email || config?.email || 'info@guardman.cl',
  address: COMPANY.address || config?.address || 'Av. Américo Vespucio Norte 1980, Providencia, Santiago, Chile',
  latitude: Number(COMPANY.latitude) || (config?.latitude ?? -33.4569),
  longitude: Number(COMPANY.longitude) || (config?.longitude ?? -70.6483),
  hours: (HOURS.schedule as any[]) || config?.hours || [
    { day: 'Lunes', hours: '24 horas' },
    { day: 'Martes', hours: '24 horas' },
    { day: 'Miércoles', hours: '24 horas' },
    { day: 'Jueves', hours: '24 horas' },
    { day: 'Viernes', hours: '24 horas' },
    { day: 'Sábado', hours: '24 horas' },
    { day: 'Domingo', hours: '24 horas' },
  ],
  social: {
    instagram: SOCIAL.instagram || config?.social_instagram || 'https://www.instagram.com/grupo_guardman',
    youtube: SOCIAL.youtube || config?.social_youtube || 'https://youtu.be/mqpLsKrwjAI',
  },
  stats: {
    guards: STATS.guards || config?.stats_guards || '500+',
    clients: STATS.clients || config?.stats_clients || '200+',
    locations: STATS.locations || config?.stats_locations || '14',
    years: STATS.years || config?.stats_years || '8+',
  },
  ratingValue: STATS.rating || config?.aggregate_rating_value || '4.8',
  ratingCount: STATS.rating_count || config?.aggregate_rating_count || '127',
};

// Map day names to English for Schema.org
const dayMap: Record<string, string> = {
  'Lunes': 'Monday',
  'Martes': 'Tuesday',
  'Miercoles': 'Wednesday',
  'Jueves': 'Thursday',
  'Viernes': 'Friday',
  'Sabado': 'Saturday',
  'Domingo': 'Sunday',
};

const areaServed = [
  { "@type": "City", "name": "Las Condes" },
  { "@type": "City", "name": "Vitacura" },
  { "@type": "City", "name": "Santiago Centro" },
  { "@type": "City", "name": "Huechuraba" },
  { "@type": "City", "name": "Quilicura" },
  { "@type": "City", "name": "Lo Barnechea" },
  { "@type": "City", "name": "La Reina" },
  { "@type": "City", "name": "Renca" },
  { "@type": "City", "name": "Pudahuel" },
  { "@type": "City", "name": "La Pintana" },
  { "@type": "City", "name": "Lampa" },
  { "@type": "City", "name": "Conchalí" },
  { "@type": "City", "name": "Los Andes" },
  { "@type": "City", "name": "San Felipe" },
];

const schemaData = {
  "@context": "https://schema.org",
  "@graph": [
    // Organization Schema (ProfessionalService)
    {
      "@type": "ProfessionalService",
      "@id": "https://guardman.cl/#organization",
      "name": siteConfig.name,
      "alternateName": siteConfig.alternateName,
      "url": siteConfig.url,
      "telephone": siteConfig.phone,
      "email": siteConfig.email,
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Av. Américo Vespucio Norte 1980",
        "addressLocality": "Providencia",
        "addressRegion": "Santiago",
        "postalCode": COMPANY.postal_code || '7560000',
        "addressCountry": "CL"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": siteConfig.latitude,
        "longitude": siteConfig.longitude
      },
      "openingHoursSpecification": siteConfig.hours.map(h => ({
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": dayMap[h.day] || h.day,
        "opens": "00:00",
        "closes": "23:59"
      })),
      "priceRange": "$$$",
      "areaServed": areaServed,
      "sameAs": [
        siteConfig.social.instagram,
        siteConfig.social.youtube
      ],
      "logo": {
        "@type": "ImageObject",
        "url": `${siteConfig.url}/images/logo.png`
      },
      "image": {
        "@type": "ImageObject",
        "url": `${siteConfig.url}/og-image.jpg`
      }
    },
    // WebSite Schema with SearchAction
    {
      "@type": "WebSite",
      "@id": "https://guardman.cl/#website",
      "url": siteConfig.url,
      "name": `${siteConfig.name} - Seguridad Privada en Santiago`,
      "publisher": { "@id": "https://guardman.cl/#organization" },
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": `${siteConfig.url}/servicios?q={search_term_string}`
        },
        "query-input": "required name=search_term_string"
      }
    }
  ]
};
---

<script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
