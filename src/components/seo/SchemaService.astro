---
/**
 * SchemaService.astro
 * Genera Schema.org markup para páginas de servicios
 */
interface Props {
  name: string;
  description: string;
  slug: string;
  priceRange?: string;
  areaServed?: string[];
  ratingValue?: string;
  reviewCount?: string;
}

const { 
  name, 
  description, 
  slug, 
  priceRange = "$$$", 
  areaServed = ["Santiago"],
  ratingValue = "4.8",
  reviewCount = "127"
} = Astro.props;

const schemaService = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": name,
  "description": description,
  "url": `https://guardman.cl/servicios/${slug}`,
  "provider": {
    "@id": "https://guardman.cl/#organization"
  },
  "areaServed": areaServed.length > 0 
    ? areaServed.map(city => ({
        "@type": "City",
        "name": city
      }))
    : {
        "@type": "Country",
        "name": "Chile"
      },
  "priceRange": priceRange,
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": name,
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": name
        }
      }
    ]
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": ratingValue,
    "reviewCount": reviewCount,
    "bestRating": "5"
  }
};
---

<script type="application/ld+json" set:html={JSON.stringify(schemaService)} />
