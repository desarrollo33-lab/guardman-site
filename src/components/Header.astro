---
import { services } from '../data/services';
import { locations } from '../data/locations';
import { siteConfig } from '../data/site';
---

<header class="bg-white shadow-sm sticky top-0 z-50">
  <nav class="container mx-auto px-4">
    <div class="flex items-center justify-between h-16 lg:h-20">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2">
        <div class="w-10 h-10 bg-primary-600 rounded-lg flex items-center justify-center">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
          </svg>
        </div>
        <span class="text-xl font-bold text-primary-600">GuardMan</span>
      </a>

      <!-- Desktop Nav -->
      <div class="hidden lg:flex items-center gap-8">
        <!-- Services Dropdown -->
        <div class="relative group">
          <button class="flex items-center gap-1 text-neutral-700 hover:text-primary-600 font-medium">
            Servicios
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          <div class="absolute top-full left-0 mt-2 w-64 bg-white rounded-lg shadow-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
            <div class="p-2">
              {services.map(service => (
                <a href={`/servicios/${service.slug}`} class="block px-4 py-2 text-neutral-700 hover:text-primary-600 hover:bg-neutral-50 rounded-md">
                  {service.name}
                </a>
              ))}
            </div>
          </div>
        </div>

        <!-- Locations Dropdown -->
        <div class="relative group">
          <button class="flex items-center gap-1 text-neutral-700 hover:text-primary-600 font-medium">
            Ubicaciones
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          <div class="absolute top-full left-0 mt-2 w-64 bg-white rounded-lg shadow-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
            <div class="p-2 max-h-80 overflow-y-auto">
              {locations.map(location => (
                <a href={`/ubicaciones/${location.slug}`} class="block px-4 py-2 text-neutral-700 hover:text-primary-600 hover:bg-neutral-50 rounded-md">
                  {location.name}
                </a>
              ))}
            </div>
          </div>
        </div>

        <a href="/nosotros" class="text-neutral-700 hover:text-primary-600 font-medium">Nosotros</a>
        <a href="/clientes" class="text-neutral-700 hover:text-primary-600 font-medium">Clientes</a>
        <a href="/contacto" class="text-neutral-700 hover:text-primary-600 font-medium">Contacto</a>
      </div>

      <!-- CTA -->
      <div class="hidden lg:flex items-center gap-4">
        <a href={`tel:${siteConfig.phoneTel}`} class="flex items-center gap-2 text-primary-600 font-semibold">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          {siteConfig.phone}
        </a>
        <a href="/cotizacion" class="bg-primary-600 text-white px-5 py-2.5 rounded-lg font-semibold hover:bg-primary-700 transition-colors">
          Cotizar
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <button id="mobile-menu-btn" class="lg:hidden p-2">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>
    </div>

    <!-- Mobile Menu -->
    <div id="mobile-menu" class="lg:hidden hidden pb-4">
      <div class="flex flex-col gap-2">
        <a href="/servicios" class="px-4 py-2 text-neutral-700 hover:bg-neutral-50 rounded-lg">Servicios</a>
        <a href="/ubicaciones" class="px-4 py-2 text-neutral-700 hover:bg-neutral-50 rounded-lg">Ubicaciones</a>
        <a href="/nosotros" class="px-4 py-2 text-neutral-700 hover:bg-neutral-50 rounded-lg">Nosotros</a>
        <a href="/clientes" class="px-4 py-2 text-neutral-700 hover:bg-neutral-50 rounded-lg">Clientes</a>
        <a href="/contacto" class="px-4 py-2 text-neutral-700 hover:bg-neutral-50 rounded-lg">Contacto</a>
        <a href="/cotizacion" class="mt-2 bg-primary-600 text-white text-center px-4 py-2.5 rounded-lg font-semibold">Cotizar</a>
      </div>
    </div>
  </nav>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  
  menuBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });
</script>
