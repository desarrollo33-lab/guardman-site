---
/**
 * ServiceContent - Contenido de servicio desde CMS
 */

import { getServiceSections } from '../../data/cms';
import SectionRenderer from './SectionRenderer.astro';

interface Props {
  serviceSlug: string;
  serviceName: string;
}

const { serviceSlug, serviceName } = Astro.props;
const sections = getServiceSections(serviceSlug);
---

{ sections ? (
  <SectionRenderer sections={sections} serviceName={serviceName} />
) : (
  <div class="py-12 text-center text-neutral-500">
    Contenido no disponible
  </div>
)}