---
import { getServices, getLocations, getSiteConfig } from '../data/directus';

// Get data from CMS (synchronous - data is pre-loaded at build time)
const services = getServices();
const locations = getLocations();
const config = getSiteConfig();

// Build site config for template
const siteConfig = {
  name: config?.site_name || 'GuardMan Chile',
  phone: config?.phone || '+56930000010',
  phoneTel: (config?.phone || '+56930000010').replace(/[^0-9+]/g, ''),
  email: config?.email || 'info@guardman.cl',
  address: config?.address || '',
};
---

<footer class="bg-neutral-900 text-white">
  <!-- Main Footer -->
  <div class="container mx-auto px-4 py-12 lg:py-16">
    <!-- Top Row: Logo + Contact + Quick Links -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-12 mb-12">
      
      <!-- Brand Column -->
      <div class="lg:col-span-1">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-10 h-10 bg-primary-600 rounded-lg flex items-center justify-center">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
            </svg>
          </div>
          <span class="font-bold text-xl">{siteConfig.name}</span>
        </div>
        <p class="text-neutral-400 text-sm mb-6">
          Seguridad privada profesional en Santiago. Protegemos lo que más te importa con guardias certificados OS-10.
        </p>
        <!-- Social Links -->
        <div class="flex gap-4">
          <a href="https://www.instagram.com/grupo_guardman" target="_blank" rel="noopener" aria-label="Instagram de GuardMan Chile" class="w-10 h-10 bg-neutral-800 hover:bg-primary-600 rounded-lg flex items-center justify-center transition-colors">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>
          <a href="https://youtu.be/mqpLsKrwjAI" target="_blank" rel="noopener" aria-label="YouTube de GuardMan Chile" class="w-10 h-10 bg-neutral-800 hover:bg-primary-600 rounded-lg flex items-center justify-center transition-colors">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19.615 3.184c-3.604-.246-11.631-.245-15.23 0-3.897.266-4.356 2.62-4.385 8.816.029 6.185.484 8.549 4.385 8.816 3.6.245 11.626.246 15.23 0 3.897-.266 4.356-2.62 4.385-8.816-.029-6.185-.484-8.549-4.385-8.816zm-10.615 12.816v-8l8 3.993-8 4.007z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Servicios -->
      <div>
        <h3 class="text-lg font-semibold mb-4">Servicios</h3>
        <ul class="space-y-2">
          {services.slice(0, 6).map(service => (
            <li>
              <a href={`/servicios/${service.slug}`} class="text-neutral-400 hover:text-white text-sm transition-colors">
                {service.name}
              </a>
            </li>
          ))}
          <li>
            <a href="/servicios" class="text-primary-200 hover:text-white text-sm font-medium transition-colors">
              Ver todos →
            </a>
          </li>
        </ul>
      </div>

      <!-- Ubicaciones -->
      <div>
        <h3 class="text-lg font-semibold mb-4">Ubicaciones</h3>
        <ul class="space-y-2">
          {locations.slice(0, 8).map(location => (
            <li>
              <a href={`/ubicaciones/${location.slug}`} class="text-neutral-400 hover:text-white text-sm transition-colors">
                {location.name}
              </a>
            </li>
          ))}
          <li>
            <a href="/ubicaciones" class="text-primary-200 hover:text-white text-sm font-medium transition-colors">
              Ver todas →
            </a>
          </li>
        </ul>
      </div>

      <!-- Contacto -->
      <div>
        <h3 class="text-lg font-semibold mb-4">Contacto</h3>
        <ul class="space-y-3 text-sm">
          <li>
            <a href={`tel:${siteConfig.phoneTel}`} class="flex items-center gap-3 text-neutral-400 hover:text-white transition-colors">
              <svg class="w-5 h-5 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
              {siteConfig.phone}
            </a>
          </li>
          <li>
            <a href={`mailto:${siteConfig.email}`} class="flex items-center gap-3 text-neutral-400 hover:text-white transition-colors">
              <svg class="w-5 h-5 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
              {siteConfig.email}
            </a>
          </li>
          <li class="flex items-start gap-3 text-neutral-400">
            <svg class="w-5 h-5 text-primary-400 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <span>{siteConfig.address}</span>
          </li>
        </ul>
        <!-- CTA -->
        <a href="/cotizacion" class="mt-6 block w-full bg-primary-600 hover:bg-primary-700 text-white text-center py-3 rounded-lg font-semibold transition-colors">
          Solicitar Cotización
        </a>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="border-t border-neutral-800 pt-8">
      <div class="flex flex-col md:flex-row justify-between items-center gap-4">
        <div class="flex flex-wrap justify-center gap-6 text-sm text-neutral-400">
          <a href="/" class="hover:text-white transition-colors">Inicio</a>
          <a href="/nosotros" class="hover:text-white transition-colors">Nosotros</a>
          <a href="/contacto" class="hover:text-white transition-colors">Contacto</a>
          <a href="/privacidad" class="hover:text-white transition-colors">Política de Privacidad</a>
          <a href="/terminos" class="hover:text-white transition-colors">Términos y Condiciones</a>
        </div>
        <p class="text-neutral-500 text-sm">
          © {new Date().getFullYear()} {siteConfig.name}. Todos los derechos reservados.
        </p>
      </div>
    </div>
  </div>
</footer>
