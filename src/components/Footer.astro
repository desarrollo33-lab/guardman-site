---
import { getServices, getLocations, getSiteConfig } from '../data/directus';

// Get data from CMS (synchronous - data is pre-loaded at build time)
const services = getServices();
const locations = getLocations();
const config = getSiteConfig();

// Build site config for template
const siteConfig = {
  name: config?.site_name || 'GuardMan Chile',
  phone: config?.phone || '+56930000010',
  phoneTel: (config?.phone || '+56930000010').replace(/[^0-9+]/g, ''),
  email: config?.email || 'info@guardman.cl',
  address: config?.address || '',
};
---

<footer class="bg-primary-800 text-white">
  <div class="container mx-auto px-4 py-12 lg:py-16">
    <!-- Top Row: Servicios, Sectores, Contacto -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-12 mb-8">
      <!-- Services -->
      <div>
        <h3 class="text-lg font-semibold mb-4">Servicios</h3>
        <ul class="space-y-2">
          {services.map(service => (
            <li>
              <a href={`/servicios/${service.slug}`} class="text-neutral-300 hover:text-white text-sm transition-colors">
                {service.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Sectores -->
      <div>
        <h3 class="text-lg font-semibold mb-4">Sectores</h3>
        <ul class="space-y-2">
          <li><a href="/sectores/hoteleria" class="text-neutral-300 hover:text-white text-sm transition-colors">Hotelería</a></li>
          <li><a href="/sectores/corporativo" class="text-neutral-300 hover:text-white text-sm transition-colors">Corporativo</a></li>
          <li><a href="/sectores/residencial" class="text-neutral-300 hover:text-white text-sm transition-colors">Residencial</a></li>
          <li><a href="/sectores/industrial" class="text-neutral-300 hover:text-white text-sm transition-colors">Industrial</a></li>
          <li><a href="/sectores/automotriz" class="text-neutral-300 hover:text-white text-sm transition-colors">Automotriz</a></li>
          <li><a href="/sectores/diplomatico" class="text-neutral-300 hover:text-white text-sm transition-colors">Diplomático</a></li>
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="text-lg font-semibold mb-4">Contacto</h3>
        <ul class="space-y-3 text-sm">
          <li class="flex items-center gap-2 text-neutral-300">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            <a href={`tel:${siteConfig.phoneTel}`} class="hover:text-white">{siteConfig.phone}</a>
          </li>
          <li class="flex items-center gap-2 text-neutral-300">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            <a href={`mailto:${siteConfig.email}`} class="hover:text-white">{siteConfig.email}</a>
          </li>
          <li class="text-neutral-300">
            <svg class="w-4 h-4 inline mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            {siteConfig.address}
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Row: Ubicaciones (3 columns) -->
    <div class="border-t border-white/10 pt-8">
      <h3 class="text-lg font-semibold mb-4">Ubicaciones</h3>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
        {locations.map(location => (
          <a href={`/ubicaciones/${location.slug}`} class="text-neutral-300 hover:text-white text-sm transition-colors">
            {location.name}
          </a>
        ))}
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="border-t border-white/10 mt-8 pt-8 flex flex-col md:flex-row justify-between items-center gap-4">
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 bg-white/10 rounded-lg flex items-center justify-center">
          <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
          </svg>
        </div>
        <span class="font-bold">{siteConfig.name}</span>
      </div>
      <div class="flex flex-col md:flex-row gap-4 md:gap-6 text-sm text-neutral-400">
        <a href="/nosotros" class="hover:text-white transition-colors">Nosotros</a>
        <a href="/privacidad" class="hover:text-white transition-colors">Privacidad</a>
        <a href="/terminos" class="hover:text-white transition-colors">Términos</a>
      </div>
      <p class="text-neutral-400 text-sm">
        &copy; {new Date().getFullYear()}
      </p>
    </div>
  </div>
</footer>
